.IP \[bu] 2
\f[V]VerityKeySource=\f[R]
.IP \[bu] 2
\f[V]VerityCertificate=\f[R]
.IP \[bu] 2
\f[V]ProxyUrl=\f[R]
.IP \[bu] 2
