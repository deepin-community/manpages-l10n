#. type: SH
#: mageia-cauldron
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: mageia-cauldron
msgid ""
"proc_net_register, proc_net_unregister - register network entries in the /"
"proc filesystem"
msgstr ""

#. type: SH
#: mageia-cauldron
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: mageia-cauldron
msgid "B<#include E<lt>linux/proc_fs.hE<gt>>"
msgstr ""

#. type: TP
#: mageia-cauldron
#, no-wrap
msgid "B<int\\ proc_net_register(\\%struct\\ proc_dir_entry\\ *\\ >I<child>B<);>"
msgstr ""

#. type: TP
#: mageia-cauldron
#, no-wrap
msgid "B<int\\ proc_net_unregister(\\%int\\ >I<inode>B<);>"
msgstr ""

#. type: SH
#: mageia-cauldron
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: mageia-cauldron
msgid ""
"These are wrapper functions around B<proc_register> and B<proc_unregister>.  "
"They always use a parent of proc_net."
msgstr ""

#. type: SH
#: mageia-cauldron
#, no-wrap
msgid "RETURN VALUE"
msgstr ""

#. type: Plain text
#: mageia-cauldron
msgid "As for B<proc_register> and B<proc_unregister>."
msgstr ""

