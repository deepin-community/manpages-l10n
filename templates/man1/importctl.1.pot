"B<systemd-vmspawn>(1), B<machinectl>(1), B<portablectl>(1), B<systemd-"
"sysext>(8), B<systemd-confext>(8), B<tar>(1), B<xz>(1), B<gzip>(1), "
"B<bzip2>(1)"
msgstr ""

