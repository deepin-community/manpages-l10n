msgstr ""

#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"merge resources of the same name into one file (needed e.g. for fonts output "
"in multiple blocks)"
msgstr ""

