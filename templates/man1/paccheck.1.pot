msgstr ""

#. type: IP
#: archlinux
#, no-wrap
msgid "B<--opt-depends>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "--opt-depends"
msgstr ""

#. type: Plain text
#: archlinux
msgid "Check that all package optional dependencies are satisfied."
msgstr ""

