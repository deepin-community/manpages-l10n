#: archlinux
#, no-wrap
msgid "B<--backup>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "--backup"
msgstr ""

#. type: Plain text
#: archlinux
msgid "Include backup files in file modification checks."
msgstr ""

#. type: IP
#: archlinux
#, no-wrap
msgid "B<--noextract>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "--noextract"
msgstr ""

#. type: Plain text
#: archlinux
msgid "Include NoExtract files in file modification checks."
msgstr ""

#. type: IP
#: archlinux
#, no-wrap
msgid "B<--noupgrade>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "--noupgrade"
msgstr ""

#. type: Plain text
#: archlinux
msgid "Include NoUpgrade files in file modification checks."
msgstr ""

