msgstr ""

#. type: IP
#: archlinux
#, no-wrap
msgid "B<--recursive>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "--recursive"
msgstr ""

#. type: Plain text
#: archlinux
msgid "Recursively perform checks on packages' dependencies as well."
msgstr ""

