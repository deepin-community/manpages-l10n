#: archlinux
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: IP
#: archlinux
#, no-wrap
msgid "B<--help>"
msgstr ""

#. type: IX
#: archlinux
#, no-wrap
msgid "Item"
msgstr ""

