#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<fork>(2), B<getrusage>(2), B<sigaction>(2), B<signal>(2), B<wait>(2), "
"B<signal>(7)"
msgstr ""

