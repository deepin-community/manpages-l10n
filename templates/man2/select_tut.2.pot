#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"static int\n"
"connect_socket(int connect_port, char *address)\n"
"{\n"
"    int                 cfd;\n"
"    struct sockaddr_in  addr;\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
