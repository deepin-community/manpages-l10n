msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    yes = 1;\n"
"    if (setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR,\n"
"                   &yes, sizeof(yes)) == -1)\n"
"    {\n"
"        perror(\"setsockopt\");\n"
"        close(lfd);\n"
"        return -1;\n"
