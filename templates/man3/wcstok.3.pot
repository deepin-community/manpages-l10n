#, no-wrap
msgid ""
"B<wchar_t *wcstok(wchar_t *restrict >I<wcs>B<, const wchar_t *restrict >I<delim>B<,>\n"
"B<                wchar_t **restrict >I<ptr>B<);>\n"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
