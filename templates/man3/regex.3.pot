"int main(void)\n"
"{\n"
"    static const char *s = str;\n"
"    regex_t     regex;\n"
"    regmatch_t  pmatch[1];\n"
"    regoff_t    off, len;\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (regcomp(&regex, re, REG_NEWLINE))\n"
"        exit(EXIT_FAILURE);\n"
