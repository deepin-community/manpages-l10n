"            case \\[aq]c\\[aq]:\n"
"                cancel_requests();\n"
"                break;\n"
"            case \\[aq]l\\[aq]:\n"
"                list_requests();\n"
"                break;\n"
"            default:\n"
"                fprintf(stderr, \"Bad command: %c\\en\", cmd[0]);\n"
"                break;\n"
"            }\n"
"        }\n"
"    }\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

