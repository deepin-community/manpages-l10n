#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The following program demonstrates how to write a replacement for the "
"standard B<imaxabs>(3)  function, which being a function can't really "
"provide what it promises: seamlessly upgrading to the widest available type."
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid ""
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"#define my_imaxabs  _Generic(INTMAX_C(0),  \\[rs]\n"
"    long:           labs,                  \\[rs]\n"
"    long long:      llabs                  \\[rs]\n"
"/*  long long long: lllabs */              \\[rs]\n"
")\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    off_t  a;\n"
"\\&\n"
"    a = -42;\n"
"    printf(\"imaxabs(%jd) == %jd\\[rs]n\", (intmax_t) a, my_imaxabs(a));\n"
"    printf(\"&imaxabs == %p\\[rs]n\", &my_imaxabs);\n"
"    printf(\"&labs    == %p\\[rs]n\", &labs);\n"
"    printf(\"&llabs   == %p\\[rs]n\", &llabs);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

