#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    tb1 = __ppc_get_timebase();\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    // Do some stuff...\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    tb2 = __ppc_get_timebase();\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
