"pthread_cond_wait(pthread_cond_t *>I<cond>B<, pthread_mutex_t "
"*>I<mutex>B<);> B<int pthread_cond_timedwait(pthread_cond_t *>I<cond>B<, "
"pthread_mutex_t *>I<mutex>B<, const struct timespec *>I<abstime>B<);> B<int "
