#. type: Plain text
#: debian-bookworm opensuse-leap-16-0
msgid "/lib/modprobe\\&.d/*\\&.conf"
msgstr ""

#. type: Plain text
#: debian-bookworm opensuse-leap-16-0
msgid "/usr/local/lib/modprobe\\&.d/*\\&.conf"
