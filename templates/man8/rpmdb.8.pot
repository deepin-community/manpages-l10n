msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "rpmdb - RPM Database Tool"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid "\\f[B]rpmdb\\f[R] {\\f[B]--initdb|--rebuilddb\\f[R]}\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid "\\f[B]rpmdb\\f[R] {\\f[B]--verifydb\\f[R]}\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid "\\f[B]rpmdb\\f[R] {\\f[B]--exportdb|--importdb\\f[R]}\\fR"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid "The general form of an rpmdb command is"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"\\f[B]rpm\\f[R] {\\f[B]--initdb|--rebuilddb\\f[R]} [\\f[B]-v\\f[R]] [\\f[B]--"
"dbpath \\f[I]DIRECTORY\\f[R]] [\\f[B]--root \\f[I]DIRECTORY\\f[R]]\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Use \\f[B]--initdb\\f[R] to create a new database if one doesn\\[aq]t "
"already exist (existing database is not overwritten), use \\f[B]--"
"rebuilddb\\f[R] to rebuild the database indices from the installed package "
"headers.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid ""
"\\f[B]--verifydb\\f[R] performs a low-level integrity check on the database."
"\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid ""
"\\f[B]--exportdb\\f[R] exports the database in header-list format, suitable "
"for transfporting to another host or database type.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid ""
"\\f[B]--importdb\\f[R] imports a database from a header-list format as "
"created by \\f[B]--exportdb\\f[R].\\fR"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "SEE ALSO"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
msgid ""
"\\f[B]popt\\f[R](3), \\f[B]rpm\\f[R](8), \\f[B]rpmkeys\\f[R](8), "
"\\f[B]rpmsign\\f[R](8), \\f[B]rpm2cpio\\f[R](8), \\f[B]rpmbuild\\f[R](8), "
"\\f[B]rpmspec\\f[R](8)\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"\\f[B]rpm --help\\f[R] - as rpm supports customizing the options via popt "
"aliases it\\[aq]s impossible to guarantee that what\\[aq]s described in the "
"manual matches what\\[aq]s available.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "\\f[B]http://www.rpm.org/ E<lt>URL:http://www.rpm.org/E<gt>\\fR"
msgstr ""

