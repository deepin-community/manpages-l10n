#. type: TH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "RPMBUILD"
msgstr ""

#. type: TH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "09 June 2002"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "rpmbuild - Build RPM Package(s)"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: SS
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "BUILDING PACKAGES:"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] {\\f[B]-ba|-bb|-bp|-bf|-bc|-bi|-bl|-bs|-br|-bd\\f[R]} "
"[\\f[B]rpmbuild-options\\f[R]] \\f[I]SPECFILE ...\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] {\\f[B]-ra|-rb|-rp|-rf|-rc|-ri|-rl|-rs|-rr|-rd\\f[R]} "
"[\\f[B]rpmbuild-options\\f[R]] \\f[I]SOURCEPACKAGE ...\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] {\\f[B]-ta|-tb|-tp|-tf|-tc|-ti|-tl|-ts|-tr|-td\\f[R]} "
"[\\f[B]rpmbuild-options\\f[R]] \\f[I]TARBALL ...\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] {\\f[B]--rebuild|--recompile\\f[R]} \\f[I]SOURCEPKG "
"\\&...\\fR"
msgstr ""

#. type: SS
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "MISCELLANEOUS:"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "\\f[B]rpmbuild\\f[R] \\f[B]--showrc\\fR"
msgstr ""

#. type: SS
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "rpmbuild-options"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"[\\f[B]--buildroot \\f[I]DIRECTORY\\f[R]] [\\f[B]--clean\\f[R]] [\\f[B]--"
"nobuild\\f[R]] [\\f[B]--rmsource\\f[R]] [\\f[B]--rmspec\\f[R]] [\\f[B]--"
"short-circuit\\f[R]] [\\f[B]--build-in-place\\f[R]] [\\f[B]--noprep\\f[R]] "
"[\\f[B]--noclean\\f[R]] [\\f[B]--nocheck\\f[R]] [\\f[B]--rpmfcdebug\\f[R]] "
"[\\f[B]--target \\f[I]PLATFORM\\f[R]] [\\f[B]--with \\f[I]OPTION\\f[R]] "
"[\\f[B]--without \\f[I]OPTION\\f[R]]\\fR"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] is used to build both binary and source software "
"packages.  A \\f[B]package\\f[R] consists of an archive of files and meta-"
"data used to install and erase the archive files.  The meta-data includes "
"helper scripts, file attributes, and descriptive information about the "
"package.  \\f[B]Packages\\f[R] come in two varieties: binary packages, used "
"to encapsulate software to be installed, and source packages, containing the "
"source code and recipe necessary to produce binary packages.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"One of the following basic modes must be selected: \\f[B]Build "
"Package\\f[R], \\f[B]Build Package from Tarball\\f[R], \\f[B]Recompile "
"Package\\f[R], \\f[B]Show Configuration\\f[R].\\fR"
msgstr ""

#. type: SS
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "GENERAL OPTIONS"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "These options can be used in all the different modes."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-?, --help\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Print a longer usage message then normal."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--version\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Print a single line containing the version number of \\f[B]rpm\\f[R] being "
"used.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--quiet\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Print as little as possible - normally only error messages will be displayed."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-v\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Print verbose information - normally routine progress messages will be "
"displayed."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-vv\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Print lots of ugly debugging information."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rpmfcdebug\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Enables to debug dependencies generation."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rcfile \\f[I]FILELIST\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable
msgid ""
"Replace default list of configuration files to be read with "
"\\f[I]FILELIST\\f[R].  See \\f[B]rpmrc Configuration\\f[R] in \\f[B]rpm\\f[R]"
"(8) for details.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-unstable
#, no-wrap
msgid "\\f[B]--load \\f[I]FILE\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable
msgid "Load an individual macro file."
msgstr ""

#. type: TP
#: archlinux debian-unstable
#, no-wrap
msgid "\\f[B]--macros \\f[I]FILELIST\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable
msgid ""
"Replace the list of macro files to be loaded with \\f[I]FILELIST\\f[R].  See "
"\\f[B]Macro Configuration\\f[R] in \\f[B]rpm\\f[R](8) for details.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--pipe \\f[I]CMD\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Pipes the output of \\f[B]rpm\\f[R] to the command \\f[I]CMD\\f[R].\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--dbpath \\f[I]DIRECTORY\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Use the database in \\f[I]DIRECTORY\\f[R] rather than the default path "
"\\f[I]/var/lib/rpm\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--root \\f[I]DIRECTORY\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Use the file system tree rooted at \\f[I]DIRECTORY\\f[R] for all "
"operations.  Note that this means the database within \\f[I]DIRECTORY\\f[R] "
"will be used for dependency checks and any scriptlet(s) (e.g.\\ \\f[B]"
"%post\\f[R] if installing, or \\f[B]%prep\\f[R] if building, a package) will "
"be run after a chroot(2) to \\f[I]DIRECTORY\\f[R].\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-D, --define=\\[aq]\\f[I]MACRO EXPR\\f[B]\\[aq]\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Defines \\f[I]MACRO\\f[R] with value \\f[I]EXPR\\f[R].\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--scm=\\f[I]SCM\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Select the \\f[I]SCM\\f[R] to use with %autosetup, if one is not set in the "
"spec file.  Note that not all values for \\f[I]SCM\\f[R], e.g., "
"\\f[B]patch\\f[R] (the default) and \\f[B]gendiff\\f[R], \\f[B]git\\f[R], or "
"\\f[B]quilt\\f[R] work interchangeably with all other patches and options "
"stated in the %autosetup line, especially option \\f[B]-p\\f[I]N\\f[R].\\fR"
msgstr ""

#. type: SS
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "BUILD OPTIONS"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "The general form of an rpm build command is"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmbuild\\f[R] {\\f[B]-b\\f[I]STAGE\\f[B]|-r\\f[I]STAGE\\f[B]|-"
"t\\f[I]STAGE\\f[R]} [\\f[B]rpmbuild-options\\f[R]] \\f[I]FILE ...\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"The argument used is \\f[B]-b\\f[R] if a spec file is being used to build "
"the package, \\f[B]-r\\f[R] if a source package is to be rebuilt and \\f[B]-"
"t\\f[R] if \\f[B]rpmbuild\\f[R] should look inside of a (possibly "
"compressed) tar file for the spec file to use.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Packages are built in a number of stages.  The first six correspond to the "
"following sections in a spec file: \\f[B]%prep\\f[R], \\f[B]"
"%generate_buildrequires\\f[R], \\f[B]%build\\f[R], \\f[B]%install\\f[R], "
"\\f[B]%check\\f[R] and \\f[B]%clean\\f[R].  Finally, binary and source "
"packages are created in an assembly stage.\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"The \\f[I]STAGE\\f[R] character specifies the stage to finish with (after "
"doing all the stages preceding it), and is one of:\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-ba\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Perform a full build - executes up to and including the assembly stage.  In "
"most cases, this is the option to choose."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bb\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Build just the binary packages - executes up to and including the assembly "
"stage, but without creating the source package.  On success, the build "
"directory is removed (as in \\f[B]--clean\\f[R]).\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bp\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Unpack the sources and apply any patches - executes the %prep stage only."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bf\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Configure the sources - executes up to and including the %conf stage.  This "
"generally involves the equivalent of a \\[dq]./configure\\[dq]."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bc\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Compile the sources - executes up to and including the %build stage.  This "
"generally involves the equivalent of a \\[dq]make\\[dq]."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bi\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Install the binaries into the build root - executes up to and including the "
"%check stage.  This generally involves the equivalent of a \\[dq]make "
"install\\[dq] and \\[dq]make check\\[dq]."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bl\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Do a \\[dq]list check\\[dq] - the %files section from the spec file is macro "
"expanded, and checks are made to verify that each file exists."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bs\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Build just the source package - skips straight to the assembly stage, "
"without executing any of the preceding stages or creating binary packages."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-br\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Build just the source package, but also parse and include dynamic build "
"dependencies - executes up to and including the %generate_buildrequires "
"stage and then skips straight to the assembly stage, without creating binary "
"packages.  This command can be used to fully resolve dynamic build "
"dependencies.  See the DYNAMIC BUILD DEPENDENCIES section for details."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-bd\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Check dynamic build dependencies and build the .buildreqs.nosrc.rpm package "
"if any are missing.  Don\\[cq]t build anything else."
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "The following options may also be used:"
msgstr ""

#. type: TP
#: archlinux debian-unstable
#, no-wrap
msgid "\\f[B]--buildroot \\f[I]DIRECTORY\\f[R] (DEPRECATED)\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable
msgid ""
"When building a package, override rpm\\[cq]s buildroot to "
"\\f[I]DIRECTORY\\f[R].  This option is deprecated and will be removed in the "
"future, do not introduce new usages.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--clean\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Remove the build tree after the packages are made."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nobuild\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not execute any build stages.  Useful for testing out spec files."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--noprep\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not execute %prep build stage even if present in spec."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--noclean\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not execute %clean build stage even if present in spec."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nocheck\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not execute %check build stage even if present in spec."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nodebuginfo\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not generate debuginfo packages."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nodeps\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "Do not verify build dependencies."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rmsource\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Remove the sources after the build (may also be used standalone, e.g.\\ \\"
"[dq]\\f[B]rpmbuild\\f[R] \\f[B]--rmsource foo.spec\\f[R]\\[dq]).\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rmspec\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Remove the spec file after the build (may also be used standalone, eg.  \\"
"[dq]\\f[B]rpmbuild\\f[R] \\f[B]--rmspec foo.spec\\f[R]\\[dq]).\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--short-circuit\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"Skip straight to specified stage (i.e., skip all stages leading up to the "
"specified stage).  Only valid with \\f[B]-bc\\f[R], \\f[B]-bi\\f[R], and "
"\\f[B]-bb\\f[R].  Useful for local testing only.  Packages built this way "
"will be marked with an unsatisfiable dependency to prevent their accidental "
"use.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--build-in-place\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-unstable
msgid ""
"Build from locally checked out sources in the current working directory.  "
"The build tree is set up as if %setup was used, but %builddir/%buildsubdir "
"points back to the current working directory.  %prep is skipped entirely."
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--target \\f[I]PLATFORM\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"When building the package, interpret \\f[I]PLATFORM\\f[R] as \\f[B]arch-"
"vendor-os\\f[R] and set the macros \\f[B]%_target\\f[R], \\f[B]"
"%_target_cpu\\f[R], and \\f[B]%_target_os\\f[R] accordingly.\\fR"
msgstr ""

#. type: TP
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--with \\f[I]OPTION\\fR"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
