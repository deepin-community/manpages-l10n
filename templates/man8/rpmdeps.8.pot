msgid "NAME"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "rpmdeps - Generate RPM Package Dependencies"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmdeps\\f[R] \\f[B]{-P|--provides}\\f[R] \\f[B]{-R|--requires}\\f[R] "
"\\f[B]{--rpmfcdebug}\\f[R] \\f[I]FILE ...\\fR"
msgstr ""

#. type: SH
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"\\f[B]rpmdeps\\f[R] generates package dependencies for the set of "
"\\f[I]FILE\\f[R] arguments.  Each \\f[I]FILE\\f[R] argument is searched for "
"Elf32/Elf64, script interpreter, or per-script dependencies, and the "
"dependencies are printed to stdout.\\fR"
msgstr ""

