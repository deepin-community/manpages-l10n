#: mageia-cauldron
msgid ""
"B<systemd>(1), B<fstab>(5), B<systemd.mount>(5), B<systemd.swap>(5), "
"B<systemd-cryptsetup-generator>(8), B<systemd-gpt-auto-generator>(8), "
"B<kernel-command-line>(7), \\m[blue]B<Known Environment Variables>\\m[]"
"\\&\\s-2\\u[1]\\d\\s+2"
msgstr ""

