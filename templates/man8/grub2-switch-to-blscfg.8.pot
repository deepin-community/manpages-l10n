#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "grub-switch-to-blscfg - switch to using BLS config files"
msgstr ""

#. type: SH
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "B<grub-switch-to-blscfg>"
msgstr ""

#. type: SH
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide
msgid "Switch to BLS config files.\\en"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<-h>, B<--help>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "print this message and exit"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<-V>, B<--version>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "print the version information and exit"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<--backup-suffix>=I<\\,SUFFIX\\/>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "\\&.bak"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<--bls-directory>=I<\\,DIR\\/>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide
msgid "I<\\,/boot/loader/entries\\/>"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<--config-file>=I<\\,FILE\\/>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide
msgid "I<\\,/etc/grub2-efi.cfg\\/>"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<--grub-defaults>=I<\\,FILE\\/>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-leap-16-0
msgid "I<\\,/etc/default/grub\\/>"
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "B<--grub-directory>=I<\\,DIR\\/>"
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide
msgid "/boot/efi/EFI/fedora/"
msgstr ""

#. type: SH
#: fedora-41 fedora-rawhide opensuse-leap-16-0
#, no-wrap
msgid "SEE ALSO"
msgstr ""

