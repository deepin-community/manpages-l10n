#, no-wrap
msgid "GRUB"
msgstr ""

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "January 2022"
msgstr ""

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "grub (GNU GRUB 0.97)"
msgstr ""

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "System Administration Utilities"
msgstr ""

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "grub - the grub shell"
msgstr ""

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "B<grub> [I<\\,OPTION\\/>]..."
msgstr ""

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "Enter the GRand Unified Bootloader command shell."
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--batch>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "turn on batch mode for non-interactive use"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--boot-drive>=I<\\,DRIVE\\/>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 boot_drive [default=0x0]"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--config-file>=I<\\,FILE\\/>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 config_file [default=/boot/grub/menu.lst]"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--device-map>=I<\\,FILE\\/>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "use the device map file FILE"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--help>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "display this message and exit"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--hold>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "wait until a debugger will attach"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--install-partition>=I<\\,PAR\\/>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 install_partition [default=0x20000]"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-config-file>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "do not use the config file"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-curses>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "do not use curses"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-floppy>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "do not probe any floppy drive"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-pager>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "do not use internal pager"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--preset-menu>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "use the preset menu"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--probe-second-floppy>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "probe the second floppy drive"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--read-only>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "do not write anything to devices"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--verbose>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "print verbose messages"
msgstr ""

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--version>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "print version information and exit"
msgstr ""

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "REPORTING BUGS"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "Report bugs to E<lt>bug-grub@gnu.orgE<gt>."
msgstr ""

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "B<update-grub>(8), B<grub-install>(8)."
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid ""
"The full documentation for B<grub> is maintained as a Texinfo manual.  If "
"the B<info> and B<grub> programs are properly installed at your site, the "
"command"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "B<info grub>"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid ""
"should give you access to the complete manual.  You may need to install the "
"B<grub-legacy-doc> package."
msgstr ""
