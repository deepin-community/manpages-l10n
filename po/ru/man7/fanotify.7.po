"        fprintf(stderr, \"Usage: %s MOUNT\\en\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
msgstr ""
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Использование: %s ТОЧКА_МОНТИРОВАНИЯ\\en\",\n"
"                                        argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
