"{\n"
"    printf(\"la_symbind64(): symname = %s; sym-E<gt>st_value = %p\\[rs]n\",\n"
"            symname, sym-E<gt>st_value);\n"
"    printf(\"        ndx = %u; flags = %#x\", ndx, *flags);\n"
"    printf(\"; refcook = %p; defcook = %p\\[rs]n\", refcook, defcook);\n"
"\\&\n"
"    return sym-E<gt>st_value;\n"
"}\n"
"\\&\n"
"Elf32_Addr\n"
