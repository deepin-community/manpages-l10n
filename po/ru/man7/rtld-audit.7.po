"        unsigned int *flags, const char *symname, long *framesizep)\n"
"{\n"
"    printf(\"la_i86_gnu_pltenter(): %s (%p)\\[rs]n\", symname, sym-E<gt>st_value);\n"
"\\&\n"
"    return sym-E<gt>st_value;\n"
"}\n"
msgstr ""

