"struct ip_msfilter {\n"
"    struct in_addr imsf_multiaddr; /* IP multicast group\n"
"                                      address */\n"
"    struct in_addr imsf_interface; /* IP address of local\n"
"                                      interface */\n"
"    uint32_t       imsf_fmode;     /* Filter-mode */\n"
"\\&\n"
"    uint32_t       imsf_numsrc;    /* Number of sources in\n"
