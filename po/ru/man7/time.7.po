msgid ""
"B<date>(1), B<time>(1), B<timeout>(1), B<adjtimex>(2), B<alarm>(2), "
"B<clock_gettime>(2), B<clock_nanosleep>(2), B<getitimer>(2), "
"B<getrlimit>(2), B<getrusage>(2), B<gettimeofday>(2), B<nanosleep>(2), "
