#| msgid ""
#| "sh2# B<mount --make-rslave />     # Don't propagate mount events\n"
#| "                               # to other namespaces\n"
#| "sh2# B<umount /sys/fs/cgroup/freezer>\n"
#| "sh2# B<mount -t cgroup -o freezer freezer /sys/fs/cgroup/freezer>\n"
