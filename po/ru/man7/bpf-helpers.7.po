"^\".ft C$\n"
"char ____license[] __attribute__((section(\\[dq]license\\[dq]), used)) = \\[dq]GPL\\[dq];\n"
"^\".ft P$\n"
msgstr "char ____license[] __attribute__((section(\"license\"), used)) = \"GPL\";\n"
