msgid ""
"B<void va_start(va_list >I<ap>B<, >I<last>B<);>\n"
"I<type>B< va_arg(va_list >I<ap>B<, >I<type>B<);>\n"
"B<void va_end(va_list >I<ap>B<);>\n"
"B<void va_copy(va_list >I<dest>B<, va_list >I<src>B<);>\n"
msgstr ""

