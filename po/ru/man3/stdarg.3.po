#| "            c = (char) va_arg(ap, int);\n"
#| "            printf(\"char %c\\en\", c);\n"
#| "            break;\n"
#| "        }\n"
#| "    va_end(ap);\n"
#| "}\n"
msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdarg.hE<gt>\n"
"\\&\n"
"void\n"
"foo(char *fmt, ...)   /* \\[aq]...\\[aq] is C syntax for a variadic function */\n"
"\\&\n"
"{\n"
"    va_list ap;\n"
"    int d;\n"
"    char c;\n"
