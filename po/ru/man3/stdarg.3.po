#: opensuse-tumbleweed
#, fuzzy, no-wrap
#| msgid ""
#| "    va_start(ap, fmt);\n"
#| "    while (*fmt)\n"
#| "        switch (*fmt++) {\n"
#| "        case \\(aqs\\(aq:              /* string */\n"
#| "            s = va_arg(ap, char *);\n"
#| "            printf(\"string %s\\en\", s);\n"
