"char *\n"
"make_message(const char *fmt, ...)\n"
"{\n"
"    int n = 0;\n"
"    size_t size = 0;\n"
"    char *p = NULL;\n"
"    va_list ap;\n"
"\\&\n"
"    /* Determine required size. */\n"
"\\&\n"
"    va_start(ap, fmt);\n"
"    n = vsnprintf(p, size, fmt, ap);\n"
