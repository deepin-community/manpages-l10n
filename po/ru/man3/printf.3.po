msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>stdarg.hE<gt>\n"
"\\&\n"
"char *\n"
"make_message(const char *fmt, ...)\n"
"{\n"
"    int n = 0;\n"
"    size_t size = 0;\n"
"    char *p = NULL;\n"
"    va_list ap;\n"
"\\&\n"
"    /* Determine required size. */\n"
"\\&\n"
"    va_start(ap, fmt);\n"
"    n = vsnprintf(p, size, fmt, ap);\n"
"    va_end(ap);\n"
"\\&\n"
"    if (n E<lt> 0)\n"
"        return NULL;\n"
"\\&\n"
"    size = (size_t) n + 1;      /* One extra byte for \\[aq]\\e0\\[aq] */\n"
"    p = malloc(size);\n"
"    if (p == NULL)\n"
"        return NULL;\n"
"\\&\n"
"    va_start(ap, fmt);\n"
"    n = vsnprintf(p, size, fmt, ap);\n"
"    va_end(ap);\n"
"\\&\n"
"    if (n E<lt> 0) {\n"
"        free(p);\n"
"        return NULL;\n"
"    }\n"
"\\&\n"
"    return p;\n"
"}\n"
