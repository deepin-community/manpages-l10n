"        return NULL;\n"
"\\&\n"
"    va_start(ap, fmt);\n"
"    n = vsnprintf(p, size, fmt, ap);\n"
"    va_end(ap);\n"
"\\&\n"
"    if (n E<lt> 0) {\n"
"        free(p);\n"
"        return NULL;\n"
"    }\n"
"\\&\n"
