"        fprintf(stderr, \"Использование: %s E<lt>realE<gt> E<lt>imagE<gt>\\en\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    z = atof(argv[1]) + atof(argv[2]) * I;\n"
msgstr "    z = atof(argv[1]) + atof(argv[2]) * I;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
