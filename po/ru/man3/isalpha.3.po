"B<iscntrl_l>(), B<isdigit_l>(), B<isgraph_l>(), B<islower_l>(), "
"B<isprint_l>(), B<ispunct_l>(), B<isspace_l>(), B<isupper_l>(), and "
"B<isxdigit_l>()."
msgstr ""
"В POSIX.1-2008 определены B<isalnum_l>(), B<isalpha_l>(), B<isblank_l>(), "
"B<iscntrl_l>(), B<isdigit_l>(), B<isgraph_l>(), B<islower_l>(), "
"B<isprint_l>(), B<ispunct_l>(), B<isspace_l>(), B<isupper_l>() и "
"B<isxdigit_l>()."

