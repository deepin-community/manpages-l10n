msgstr ""
"Функции B<isalnum_l>(), B<isalpha_l>(), B<isblank_l>(), B<iscntrl_l>(), "
"B<isdigit_l>(), B<isgraph_l>(), B<islower_l>(), B<isprint_l>(), "
