#, fuzzy, no-wrap
#| msgid ""
#| "_BSD_SOURCE || _SVID_SOURCE\n"
#| "    /* _GNU_SOURCE also suffices */\n"
msgid ""
"    Since glibc 2.14:\n"
"        _GNU_SOURCE\n"
"    Before glibc 2.14:\n"
"        _BSD_SOURCE || _SVID_SOURCE\n"
"            /* _GNU_SOURCE also suffices */\n"
msgstr ""
"_BSD_SOURCE || _SVID_SOURCE\n"
