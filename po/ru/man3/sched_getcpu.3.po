#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, fuzzy, no-wrap
#| msgid ""
#| "int c, s;\n"
#| "s = getcpu(&c, NULL, NULL);\n"
#| "cpu = (s == -1) ? s : c;\n"
msgid ""
"int c, s;\n"
"s = getcpu(&c, NULL);\n"
"cpu = (s == -1) ? s : c;\n"
msgstr ""
"int c, s;\n"
"s = getcpu(&c, NULL, NULL);\n"
"cpu = (s == -1) ? s : c;\n"

