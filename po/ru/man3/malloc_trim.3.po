msgid "B<int malloc_trim(size_t >I<pad>B<);>\n"
msgstr "B<int malloc_trim(size_t >I<pad>B<);>"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
