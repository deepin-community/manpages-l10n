"        case \\[aq]c\\[aq]:\n"
"            circular = 1;\n"
"            break;\n"
"        default:\n"
"            errfnd = 1;\n"
"            break;\n"
"        }\n"
"    }\n"
"\\&\n"
"    if (errfnd || optind E<gt>= argc) {\n"
