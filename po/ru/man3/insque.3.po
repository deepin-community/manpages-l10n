"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    /* Create first element and place it in the linked list. */\n"
"\\&\n"
"    elem = new_element();\n"
"    first = elem;\n"
"\\&\n"
"    elem-E<gt>name = argv[optind];\n"
"\\&\n"
"    if (circular) {\n"
"        elem-E<gt>forward = elem;\n"
"        elem-E<gt>backward = elem;\n"
"        insque(elem, elem);\n"
"    } else {\n"
"        insque(elem, NULL);\n"
"    }\n"
"\\&\n"
