"    /* Read two bytes out of every five, until EOF. */\n"
"\\&\n"
"    for (long p = 0; ; p += 5) {\n"
"        if (fseek(stream, p, SEEK_SET) == -1) {\n"
"            perror(\"fseek\");\n"
"            exit(EXIT_FAILURE);\n"
"        }\n"
