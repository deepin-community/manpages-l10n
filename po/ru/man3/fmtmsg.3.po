"        break;\n"
"    case MM_NOCON:\n"
"        printf(\"No console output\\[rs]n\");\n"
"        break;\n"
"    default:\n"
"        printf(\"Unknown error from fmtmsg()\\[rs]n\");\n"
"    }\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
