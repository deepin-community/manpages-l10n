#, fuzzy, no-wrap
#| msgid ""
#| "/* In Solaris watchmalloc.so.1 */\n"
#| "B<void cfree(void *>I<ptr>B<, size_t >I<nelem>B<, size_t >I<elsize>B<);>\n"
msgid ""
"/* In Solaris watchmalloc.so.1 */\n"
"B<void cfree(void >I<ptr>B<[.>I<elsize>B< * .>I<nelem>B<], size_t >I<nelem>B<, size_t >I<elsize>B<);>\n"
