#.  results
#.  pow(-0.5,-DBL_MAX)=nan
#.  EDOM FE_INVALID nan; fail-errno fail-except fail-result;
#.  FAIL (expected: range-error-overflow (ERANGE, FE_OVERFLOW); +INF)
#.  pow(-1.5,-DBL_MAX)=nan
#.  EDOM FE_INVALID nan; fail-errno fail-except fail-result;
#.  FAIL (expected: range-error-underflow (ERANGE, FE_UNDERFLOW); +0)
#.  pow(-0.5,DBL_MAX)=nan
#.  EDOM FE_INVALID nan; fail-errno fail-except fail-result;
#.  FAIL (expected: range-error-underflow (ERANGE, FE_UNDERFLOW); +0)
#.  pow(-1.5,DBL_MAX)=nan
