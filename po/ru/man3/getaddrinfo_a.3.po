"        cmd = strtok(cmdline, \" \");\n"
"\\&\n"
"        if (cmd == NULL) {\n"
"            list_requests();\n"
"        } else {\n"
"            switch (cmd[0]) {\n"
"            case \\[aq]a\\[aq]:\n"
"                add_requests();\n"
"                break;\n"
"            case \\[aq]w\\[aq]:\n"
"                wait_requests();\n"
"                break;\n"
"            case \\[aq]c\\[aq]:\n"
