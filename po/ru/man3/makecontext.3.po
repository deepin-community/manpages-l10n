"    makecontext(&uctx_func2, func2, 0);\n"
"\\&\n"
"    printf(\"%s: swapcontext(&uctx_main, &uctx_func2)\\en\", __func__);\n"
"    if (swapcontext(&uctx_main, &uctx_func2) == -1)\n"
