"        if (s != 0)\n"
"            errc(EXIT_FAILURE, s, \"pthread_attr_init\");\n"
"\\&\n"
"        s = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);\n"
"        if (s != 0)\n"
"            errc(EXIT_FAILURE, s, \"pthread_attr_setdetachstate\");\n"
"\\&\n"
