"    }\n"
"\\&\n"
"    s = pthread_create(&thr, attrp, &thread_start, NULL);\n"
"    if (s != 0)\n"
"        errc(EXIT_FAILURE, s, \"pthread_create\");\n"
"\\&\n"
"    if (attrp != NULL) {\n"
