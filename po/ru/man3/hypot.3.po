#, no-wrap
msgid ""
"B<double hypot(double >I<x>B<, double >I<y>B<);>\n"
"B<float hypotf(float >I<x>B<, float >I<y>B<);>\n"
"B<long double hypotl(long double >I<x>B<, long double >I<y>B<);>\n"
