#| "    clock_t  si_stime;     /* System time consumed */\n"
#| "    sigval_t si_value;     /* Signal value */\n"
#| "    int      si_int;       /* POSIX.1b signal */\n"
#| "    void    *si_ptr;       /* POSIX.1b signal */\n"
