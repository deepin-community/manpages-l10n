#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<iopl>(2), B<outb>(2), B<capabilities>(7)"
msgstr "B<iopl>(2), B<outb>(2), B<capabilities>(7)"

