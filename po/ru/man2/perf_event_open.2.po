msgid "I<uprobe_path>"
msgstr "I<path>"

#. type: TQ
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, fuzzy, no-wrap
#| msgid "I<phys_addr>"
msgid "I<kprobe_addr>"
msgstr "I<phys_addr>"

#. type: TQ
