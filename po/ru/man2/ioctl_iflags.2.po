"ioctl(fd, FS_IOC_SETFLAGS, &attr);  /* обновляет флаги иноды,\n"
"                                       на которую указывает \\(aqfd\\(aq */\n"

#. type: Plain text
#: mageia-cauldron
msgid "Linux."
msgstr "Linux."
