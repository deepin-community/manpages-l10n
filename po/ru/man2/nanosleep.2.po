"B<clock_nanosleep>(2), B<restart_syscall>(2), B<sched_setscheduler>(2), "
"B<timer_create>(2), B<sleep>(3), B<timespec>(3), B<usleep>(3), B<time>(7)"
msgstr ""
"B<clock_nanosleep>(2), B<restart_syscall>(2), B<sched_setscheduler>(2), "
"B<timer_create>(2), B<sleep>(3), B<timespec>(3), B<usleep>(3), B<time>(7)"

