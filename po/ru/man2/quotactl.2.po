"    uint64_t dqi_bgrace;  /* период времени, после которого блоковый\n"
"                             необязательный лимит становится обязательным */\n"
"    uint64_t dqi_igrace;  /* период времени, после которого инодовый\n"
"                             необязательный лимит становится обязательным */\n"
