#| "                             the user */\n"
#| "    uint64_t d_icount;    /* # inodes owned by the user */\n"
#| "    int32_t  d_itimer;    /* Zero if within inode limits */\n"
#| "                          /* If not, we refuse service */\n"
#| "    int32_t  d_btimer;    /* Similar to above; for\n"
#| "                             disk blocks */\n"
#| "    uint16_t d_iwarns;    /* # warnings issued with\n"
