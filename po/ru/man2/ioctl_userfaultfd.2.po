#| "    __u64 dst;    /* Source of copy */\n"
#| "    __u64 src;    /* Destination of copy */\n"
#| "    __u64 len;    /* Number of bytes to copy */\n"
#| "    __u64 mode;   /* Flags controlling behavior of copy */\n"
#| "    __s64 copy;   /* Number of bytes copied, or negated error */\n"
#| "};\n"
msgid ""
