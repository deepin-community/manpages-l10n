#, fuzzy
#| msgid ""
#| "SVr4, 4.3BSD, POSIX.1-2001.  Only the operations B<F_DUPFD>, B<F_GETFD>, "
#| "B<F_SETFD>, B<F_GETFL>, B<F_SETFL>, B<F_GETLK>, B<F_SETLK>, and "
#| "B<F_SETLKW> are specified in POSIX.1-2001."
