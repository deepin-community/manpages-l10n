msgstr ""
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/wait.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int    wstatus;\n"
"    pid_t  cpid, w;\n"
msgstr ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int    wstatus;\n"
"    pid_t  cpid, w;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
