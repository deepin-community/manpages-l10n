#, fuzzy
#| msgid ""
#| "The B<IPC_INFO>, B<SHM_STAT> and B<SHM_INFO> operations are used by the "
#| "B<ipcs>(1)  program to provide information on allocated resources.  In "
#| "the future, these may modified or moved to a I</proc> filesystem "
