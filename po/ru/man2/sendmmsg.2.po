"main(void)\n"
"{\n"
"    int                 retval;\n"
"    int                 sockfd;\n"
"    struct iovec        msg1[2], msg2;\n"
"    struct mmsghdr      msg[2];\n"
"    struct sockaddr_in  addr;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
