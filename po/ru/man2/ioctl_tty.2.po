#. type: Plain text
#: mageia-cauldron
#, no-wrap
msgid ""
"/* SPDX-License-Identifier: GPL-2.0-or-later */\n"
"\\&\n"
"#include E<lt>asm/termbits.hE<gt>\n"
"#include E<lt>fcntl.hE<gt>\n"
