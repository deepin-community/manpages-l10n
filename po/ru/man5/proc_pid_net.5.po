msgstr ""
"Num RefCount Protocol Flags    Type St Inode Path\n"
" 0: 00000002 00000000 00000000 0001 03    42\n"
" 1: 00000001 00000000 00010000 0001 01  1948 /dev/printer\n"

#. type: Plain text
