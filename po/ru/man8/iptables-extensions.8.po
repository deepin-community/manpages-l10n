msgstr "B<2>"

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
msgid "Do not compare the TTL at all."
msgstr "Никогда не сравнивать TTL."

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
