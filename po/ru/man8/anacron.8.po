msgstr "ANACRON"

#. type: TH
#: debian-bookworm debian-unstable
#, no-wrap
msgid "2018-11-30"
msgstr "30 ноября 2018 г."

#. type: TH
#: debian-bookworm
#, fuzzy, no-wrap
#| msgid "The Debian Project"
