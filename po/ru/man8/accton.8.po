#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "ACCTON"
msgstr "ACCTON"

#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "2008 November 24"
msgstr "24.11.2008"

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "NAME"
msgstr "НАИМЕНОВАНИЕ"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "accton - turns process accounting on or off"
msgstr "accton - включает или выключает учёт процессов"

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr "ОБЗОР"

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "B<accton>"
msgstr "B<accton>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "[\\|I<OPTION>\\|] onB<\\||\\|>offB<\\||\\|>filename"
msgstr "[\\|I<OPTION>\\|] onB<\\||\\|>offB<\\||\\|>filename"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "[ B<-V> | B<--version> ] [ B<-h> | B<--help> ]"
msgstr "[ B<-V> | B<--version> ] [ B<-h> | B<--help> ]"

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "ОПИСАНИЕ"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "B<accton> I<filename> turns on process accounting."
msgstr "B<accton> I<filename> включение учета процессов."

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "OPTIONS"
msgstr "ОПЦИИ"

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "B<-V, --version>"
msgstr "B<-V, --version>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "Print the version number of B<ac> to standard output and quit."
msgstr "Вывести номер версии B<ac> на стандартный вывод и завершить работу."

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "B<-h, --help>"
msgstr "B<-h, --help>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid ""
"Prints the usage string and default locations of system files to standard "
"output and exits."
msgstr ""
"Вывести строку по использованию и расположение системных файлов по умолчанию "
"на стандартный вывод и завершить работу."

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "B<on>"
msgstr "B<on>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "Turns on process accounting using the default accounting file name."
msgstr ""
"Включить учет процессов с использованием имени файла учета по умолчанию."

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "B<off>"
msgstr "B<off>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "Turns off process accounting."
msgstr "Отключить учет процессов."

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "FILES"
msgstr "ФАЙЛЫ"

#. type: TP
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "I<acct>"
msgstr "I<acct>"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid ""
"The system wide process accounting file. See B<acct>(5)  (or B<pacct>(5))  "
"for further details."
msgstr ""
"Файл системного учета процессов. Смотрите B<acct>(5) (или B<pacct>(5)) для "
"получения более подробной информации."

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "AUTHOR"
msgstr "АВТОРЫ"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid ""
"The GNU accounting utilities were written by Noel Cragg E<lt>noel@gnu.ai.mit."
"eduE<gt>. The man page was adapted from the accounting texinfo page by Susan "
"Kleinmann E<lt>sgk@sgk.tiac.netE<gt>."
msgstr ""
"Утилиты учёта GNU были разработаны Ноэлем Крэггом (Noel Cragg) E<lt>noel@gnu."
"ai.mit.eduE<gt>. Страница руководства была разработана на основе страницы "
"учёта texinfo Сьюзан Кляйнманн (Susan Kleinmann) E<lt>sgk@sgk.tiac.netE<gt>."

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "SEE ALSO"
msgstr "СМОТРИТЕ ТАКЖЕ"

#. type: Plain text
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
msgid "B<acct>(5), B<ac>(1)"
msgstr "B<acct>(5), B<ac>(1)"
