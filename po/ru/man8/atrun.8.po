#. type: TH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "ATRUN"
msgstr "ATRUN"

#. type: TH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "Nov 1996"
msgstr "Ноябрь 1996"

#. type: TH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "local"
msgstr "local"

#. type: TH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "Linux Programmer's Manual"
msgstr "Руководство программиста Linux"

#. type: SH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "NAME"
msgstr "НАИМЕНОВАНИЕ"

#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
msgid "atrun - run jobs queued for later execution"
msgstr ""
"atrun - запускает задания, поставленные в очередь для последующего выполнения"

#. type: SH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr "ОБЗОР"

#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
msgid "B<atrun> [B<-l> I<load_avg>] [B<-d>]"
msgstr "B<atrun> [B<-l> I<load_avg>] [B<-d>]"

#. type: SH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "ОПИСАНИЕ"

#. type: Plain text
#: archlinux
msgid ""
"B<atrun> runs jobs queued by B<at(1)>.  It is a shell script invoking B</usr/"
"bin/atd> with the I<-s> option, and is provided for backward compatibility "
"with older installations."
msgstr ""
"B<atrun> запускает задания, поставленные в очередь с помощью B<at(1)>. Это "
"сценарий оболочки, вызывающий B</usr/bin/atd> с параметром I<-s> и "
"предназначен для обеспечения обратной совместимости со старыми сборками."

#. type: SH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "SEE ALSO"
msgstr "СМОТРИТЕ ТАКЖЕ"

#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
msgid "B<at>(1), B<atd>(8)."
msgstr "B<at>(1), B<atd>(8)."

#. type: SH
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "AUTHOR"
msgstr "АВТОРЫ"

#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
msgid "At was mostly written by Thomas Koenig."
msgstr "At была в основном разработана Томасом Кенигом (Thomas Koenig)."

#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron opensuse-tumbleweed
msgid ""
"B<atrun> runs jobs queued by B<at(1)>.  It is a shell script invoking B</usr/"
"sbin/atd> with the I<-s> option, and is provided for backward compatibility "
"with older installations."
msgstr ""
"B<atrun> запускает задания, поставленные в очередь с помощью B<at(1)>. Это "
"сценарий оболочки, вызывающий B</usr/sbin/atd> с параметром I<-s> и "
"предназначен для обратной совместимости со старыми сборками."
