#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "gzip(1), znew(1), zmore(1), zgrep(1), zdiff(1), gzexe(1)"
msgstr "gzip(1), znew(1), zmore(1), zgrep(1), zdiff(1), gzexe(1)"
