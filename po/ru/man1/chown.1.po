#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<chown> [I<\\,OPTION\\/>]... [I<\\,OWNER\\/>][I<\\,:\\/>[I<\\,GROUP\\/>]] "
"I<\\,FILE\\/>..."
msgstr ""
"B<chown> [I<\\,ПАРАМЕТР\\/>]... [I<\\,ВЛАДЕЛЕЦ\\/>][I<\\,:\\/>[I<\\,ГРУППА\\/"
">]] I<\\,ФАЙЛ\\/>..."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
