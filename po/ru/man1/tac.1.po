#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<cat>(1), B<rev>(1)"
msgstr "B<cat>(1), B<rev>(1)"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Full documentation E<lt>https://www.gnu.org/software/coreutils/tacE<gt>"
msgstr ""
"Полная документация на E<lt>https://www.gnu.org/software/coreutils/tacE<gt>,"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "or available locally via: info \\(aq(coreutils) tac invocation\\(aq"
msgstr ""
"также доступна локально посредством info \\(aq(coreutils) tac invocation\\(aq"

