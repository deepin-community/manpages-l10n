msgid "E<.Nm primes>"
msgstr "E<.Nm primes>"

#. type: Nd
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
#, no-wrap
msgid "generate primes"
msgstr "generează numere prime"

