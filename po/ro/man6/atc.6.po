"\t\t[ ( 12  1 ) ( 12  6 ) ]\n"
"\t\t[ ( 13  7 ) ( 28  7 ) ]\n"
"\t\t[ ( 28  1 ) ( 13 16 ) ]\n"
"\t\t[ (  1 13 ) ( 11 13 ) ]\n"
"\t\t[ ( 12  8 ) ( 12 16 ) ]\n"
"\t\t[ ( 11 18 ) ( 10 19 ) ]\n"
"\t\t[ ( 13 17 ) ( 28 17 ) ]\n"
"\t\t[ (  1  7 ) ( 11  7 ) ] ;\n"

