"\t\t[ ( 11 18 ) ( 10 19 ) ]\n"
"\t\t[ ( 13 17 ) ( 28 17 ) ]\n"
"\t\t[ (  1  7 ) ( 11  7 ) ] ;\n"
msgstr ""
