"$ B<PS1=\\[aq]sh2# \\[aq] sudo sh>\n"
"sh2# B<ls /etc | wc -l>                  # În spațiul-de-nume inițial\n"
"309\n"
"sh2# B<ls /proc/27123/root/etc | wc -l>  # /etc în alt spațiu-de-nume\n"
"0                                     # Directorul tmpfs gol\n"
"sh2# B<ls /dev | wc -l>                  # În spațiul-de-nume inițial\n"
"205\n"
"sh2# B<ls /proc/27123/root/dev | wc -l>  # /dev în alt spațiu-de-nume\n"
"11                                    # De fapt montat\n"
"                                      # bind la /usr\n"
"sh2# B<ls /usr | wc -l>                  # /usr în spațiul-de-nume inițial\n"
"11\n"

