"           (i.e., backed by a file)\n"
"           (inaccurate; same as RssFile+RssShmem in\n"
"           I</proc/>pidI</status>)\n"
"text       (4) text (code)\n"
"lib        (5) library (unused since Linux 2.6; always 0)\n"
"data       (6) data + stack\n"
"dt         (7) dirty pages (unused since Linux 2.6; always 0)\n"
msgstr ""
"size (1) dimensiunea totală a programului\n"
"           (la fel ca VmSize în I</proc/>pidI</status>)\n"
"resident (2) dimensiunea setului de rezidenți\n"
"           (inexactă; la fel ca VmRSS în I</proc/>pidI</status>)\n"
"shared (3) numărul de pagini partajate rezidente\n"
"           (adică, copiate într-un fișier)\n"
"           (inexactă; identic cu RssFile+RssShmem în\n"
"           I</proc/>pidI</status>)\n"
"text (4) text (cod)\n"
"lib (5) bibliotecă (neutilizată de la Linux 2.6; întotdeauna 0)\n"
"data (6) date + stivă\n"
"dt (7) nr. de pagini murdare (neutilizată de la Linux 2.6; întotdeauna 0)\n"

