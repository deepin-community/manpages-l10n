"B<madvise>(2), B<pidfd_open>(2), B<process_vm_readv>(2), "
"B<process_vm_write>(2)"
msgstr ""
"B<madvise>(2), B<pidfd_open>(2), B<process_vm_readv>(2), "
"B<process_vm_write>(2)"

