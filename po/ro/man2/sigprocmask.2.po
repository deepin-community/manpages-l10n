"B<                           old_kernel_sigset_t *_Nullable >I<oldset>B<);>\n"
msgstr ""
"/* Prototip pentru apelul de sistem vechi */\n"
"B<[[depreciat]] int syscall(SYS_sigprocmask, int >I<how>B<,>\n"
"B<                           const old_kernel_sigset_t *_Nullable >I<set>B<,>\n"
"B<                           old_kernel_sigset_t *_Nullable >I<oldset>B<);>\n"

