#, no-wrap
msgid "B<ioctl(int >I<d>B<, unsigned long >I<request>B<, char *>I<argp>B<);>\n"
msgstr "B<ioctl(int >I<d>B<, unsigned long >I<cerere>B<, char *>I<argp>B<);>\n"

