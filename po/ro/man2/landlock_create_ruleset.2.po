msgstr ""
"B<#include E<lt>linux/landlock.hE<gt>>  /* Definirea constantelor B<LANDLOCK_*> */\n"
"B<#include E<lt>sys/syscall.hE<gt>>     /* Definirea constantelor B<SYS_*> */\n"

