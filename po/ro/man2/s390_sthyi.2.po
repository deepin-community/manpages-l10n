#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"B<int syscall(SYS_s390_sthyi, unsigned long >I<function_code>B<,>\n"
"B<            void *>I<resp_buffer>B<, uint64_t *>I<return_code>B<,>\n"
"B<            unsigned long >I<flags>B<);>\n"
msgstr ""
"B<int syscall(SYS_s390_sthyi, unsigned long >I<function_code>B<,>\n"
