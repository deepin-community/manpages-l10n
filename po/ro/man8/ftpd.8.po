msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: archlinux
msgid "ftpd - File Transfer Protocol server."
msgstr ""
"ftpd - server pentru protocolul de transfer de fișiere (File Transfer "
"Protocol)"

#. #-#-#-#-#  archlinux: ftpd.8.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: SH
#. #-#-#-#-#  debian-bookworm: ftpd.8.pot (PACKAGE VERSION)  #-#-#-#-#
