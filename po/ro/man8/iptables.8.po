msgstr "iptables 1.8.11"

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
msgid "B<iptables> [B<-t> I<table>] B<-P> I<chain policy>"
msgstr "B<iptables> [B<-t> I<tabel>] B<-P> I<lanț politică>"

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
msgid "rule-specification := [matches...] [target]"
msgstr "rule-specification = [potriviri...] [ținta]"

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
msgid "match := B<-m> I<matchname> [per-match-options]"
msgstr "potrivire = B<-m> I<nume-potrivire> [opțiuni-per-potrivire]"

#. type: Plain text
#: debian-unstable mageia-cauldron opensuse-tumbleweed
msgid "target := B<-j> I<targetname> [per-target-options]"
msgstr "ținta = B<-j> I<nume-țintă> [opțiuni-per-țintă]"

