msgid "B</usr/sbin/exportfs [-av] -u [>I<client:/path>B< ..]>"
msgstr "B</usr/sbin/exportfs [-av] -u [>I<client:/ruta>B< ..]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
