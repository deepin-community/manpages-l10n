#. type: TH
#: debian-bookworm
#, no-wrap
msgid "GRUB"
msgstr "GRUB"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "January 2022"
msgstr "ianuarie 2022"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "grub (GNU GRUB 0.97)"
msgstr "grub (GNU GRUB 0.97)"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "System Administration Utilities"
msgstr "Utilitare de administrare a sistemului"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: debian-bookworm
msgid "grub - the grub shell"
msgstr "grub - shell-ul grub"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: debian-bookworm
msgid "B<grub> [I<\\,OPTION\\/>]..."
msgstr "B<grub> [I<\\,OPȚIUNE\\/>]..."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIERE"

#. type: Plain text
#: debian-bookworm
msgid "Enter the GRand Unified Bootloader command shell."
msgstr "Accesează shell-ul de comandă GRand Unified Bootloader."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--batch>"
msgstr "B<--batch>"

#. type: Plain text
#: debian-bookworm
msgid "turn on batch mode for non-interactive use"
msgstr ""
"activează modul de procesare pe loturi pentru utilizare non-interactivă"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--boot-drive>=I<\\,DRIVE\\/>"
msgstr "B<--boot-drive>=I<\\,UNITATE\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 boot_drive [default=0x0]"
msgstr "specifică unitatea de pornire pentru stadiul2 [implicit=0x0]"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--config-file>=I<\\,FILE\\/>"
msgstr "B<--config>=I<\\,FIȘIER\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 config_file [default=/boot/grub/menu.lst]"
msgstr ""
"specifică fișierul de configurare pentru stadiul2 [implicit=/boot/grub/"
"menu.lst]"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--device-map>=I<\\,FILE\\/>"
msgstr "B<--device-map>=I<\\,FIȘIER\\/>"

#. type: Plain text
#: debian-bookworm
msgid "use the device map file FILE"
msgstr "utilizează fișierul de hartă a dispozitivelor FIȘIER"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--help>"
msgstr "B<--help>"

#. type: Plain text
#: debian-bookworm
msgid "display this message and exit"
msgstr "afișează acest mesaj de ajutor și iese"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--hold>"
msgstr "B<--hold>"

#. type: Plain text
#: debian-bookworm
msgid "wait until a debugger will attach"
msgstr "așteaptă până când se atașează un depanator"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--install-partition>=I<\\,PAR\\/>"
msgstr "B<--install-partition>=I<\\,PARTIȚIE\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 install_partition [default=0x20000]"
msgstr "specifică partiția de instalare pentru stadiul2 [implicit=0x20000]"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-config-file>"
msgstr "B<--no-config-file>"

#. type: Plain text
#: debian-bookworm
msgid "do not use the config file"
msgstr "nu utilizează fișierul de configurare"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-curses>"
msgstr "B<--no-curses>"

#. type: Plain text
#: debian-bookworm
msgid "do not use curses"
msgstr "nu utilizează curses"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-floppy>"
msgstr "B<--no-floppy>"

#. type: Plain text
#: debian-bookworm
msgid "do not probe any floppy drive"
msgstr "nu testează nicio unitate de dischetă"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-pager>"
msgstr "B<--no-pager>"

#. type: Plain text
#: debian-bookworm
msgid "do not use internal pager"
msgstr "nu utilizează paginatorul intern"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--preset-menu>"
msgstr "B<--preset-menu>"

#. type: Plain text
#: debian-bookworm
msgid "use the preset menu"
msgstr "utilizează meniul predefinit"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--probe-second-floppy>"
msgstr "B<--probe-second-floppy>"

#. type: Plain text
#: debian-bookworm
msgid "probe the second floppy drive"
msgstr "sondează a doua unitate de dischetă"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--read-only>"
msgstr "B<--read-only>"

#. type: Plain text
#: debian-bookworm
msgid "do not write anything to devices"
msgstr "nu scrie nimic pe dispozitive"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--verbose>"
msgstr "B<--verbose>"

#. type: Plain text
#: debian-bookworm
msgid "print verbose messages"
msgstr "afișează mesaje detaliate"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--version>"
msgstr "B<--version>"

#. type: Plain text
#: debian-bookworm
msgid "print version information and exit"
msgstr "afișează informațiile despre versiune și iese"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "REPORTING BUGS"
msgstr "RAPORTAREA ERORILOR"

#. type: Plain text
#: debian-bookworm
msgid "Report bugs to E<lt>bug-grub@gnu.orgE<gt>."
msgstr "Raportați erorile la E<lt>bug-grub@gnu.orgE<gt>."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr "CONSULTAȚI ȘI"

#. type: Plain text
#: debian-bookworm
msgid "B<update-grub>(8), B<grub-install>(8)."
msgstr "B<update-grub>(8), B<grub-install>(8)."

#. type: Plain text
#: debian-bookworm
msgid ""
"The full documentation for B<grub> is maintained as a Texinfo manual.  If "
"the B<info> and B<grub> programs are properly installed at your site, the "
"command"
msgstr ""
"Documentația completă pentru B<grub> este menținută ca un manual Texinfo. "
"Dacă programele B<info> și B<grub> sunt instalate corect în sistemul dvs., "
"comanda"

#. type: Plain text
#: debian-bookworm
msgid "B<info grub>"
msgstr "B<info grub>"

#. type: Plain text
#: debian-bookworm
msgid ""
"should give you access to the complete manual.  You may need to install the "
"B<grub-legacy-doc> package."
msgstr ""
"ar trebui să vă permită accesul la manualul complet. Este posibil să fie "
"necesar să instalați pachetul B<grub-legacy-doc>."
