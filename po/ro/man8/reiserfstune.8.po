msgid "REISERFSTUNE"
msgstr "REISERFSTUNE"

#. type: TH
#: archlinux debian-bookworm debian-unstable mageia-cauldron
#, no-wrap
msgid "January 2009"
msgstr "ianuarie 2009"

#. type: TH
#: archlinux debian-bookworm debian-unstable mageia-cauldron
