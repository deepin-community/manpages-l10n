"B<#FFFF55>\n"
"B<#5555FF>\n"
"B<#FF55FF>\n"
"B<#55FFFF>\n"
"B<#FFFFFF>\n"
msgstr ""
"B<#000000>\n"
"B<#AA0000>\n"
"B<#00AA00>\n"
"B<#AA5500>\n"
"B<#0000AA>\n"
"B<#AA00AA>\n"
