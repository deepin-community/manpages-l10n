#. type: TH
#: debian-bookworm
#, no-wrap
msgid "GRUB-TERMINFO"
msgstr "GRUB-TERMINFO"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "May 2005"
msgstr "mai 2005"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "grub-terminfo (GNU GRUB 0.97)"
msgstr "grub-terminfo (GNU GRUB 0.97)"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "FSF"
msgstr "FSF"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: debian-bookworm
msgid "grub-terminfo - Generate a terminfo command from a terminfo name"
msgstr "grub-terminfo - generează o comandă terminfo de la un nume terminfo"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: debian-bookworm
msgid "B<grub-terminfo> I<TERMNAME>"
msgstr "B<grub-terminfo> I<NUME_TERMINFO>"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIERE"

#. type: Plain text
#: debian-bookworm
msgid "Generate a terminfo command from a terminfo name."
msgstr "Generează o comandă terminfo de la un nume terminfo."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<-h>, B<--help>"
msgstr "B<-h>, B<--help>"

#. type: Plain text
#: debian-bookworm
msgid "print this message and exit"
msgstr "afișează acest mesaj și iese"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr "B<-v>, B<--version>"

#. type: Plain text
#: debian-bookworm
msgid "print the version information and exit"
msgstr "afișează informațiile despre versiune și iese"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "REPORTING BUGS"
msgstr "RAPORTAREA ERORILOR"

#. type: Plain text
#: debian-bookworm
msgid "Report bugs to E<lt>bug-grub@gnu.orgE<gt>."
msgstr "Raportați erorile la E<lt>bug-grub@gnu.orgE<gt>."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr "CONSULTAȚI ȘI"

#. type: Plain text
#: debian-bookworm
msgid ""
"The full documentation for B<grub-terminfo> is maintained as a Texinfo "
"manual.  If the B<info> and B<grub-terminfo> programs are properly installed "
"at your site, the command"
msgstr ""
"Documentația completă pentru B<grub-mkconfig> este menținută ca un manual "
"Texinfo. Dacă programele B<info> și B<grub-terminfo> sunt instalate corect "
"în sistemul dvs., comanda"

#. type: Plain text
#: debian-bookworm
msgid "B<info grub-terminfo>"
msgstr "B<info grub-terminfo>"

#. type: Plain text
#: debian-bookworm
msgid "should give you access to the complete manual."
msgstr "ar trebui să vă permită accesul la manualul complet."
