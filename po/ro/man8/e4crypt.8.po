#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<e4crypt get_policy >I<path> ..."
msgstr "B<e4crypt get_policy >I<ruta> ..."

#. type: TP
