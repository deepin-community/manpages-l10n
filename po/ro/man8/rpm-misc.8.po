#. type: TH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "RPM misc options"
msgstr "Opțiuni diverse pentru RPM"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "NAME rpm - lesser need options for rpm(8)"
msgstr "NAME rpm - opțiuni mai puțin necesare pentru rpm(8)"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "OPTIONS"
msgstr "OPȚIUNI"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--predefine\\f[R]=\\[aq]\\f[I]MACRO EXPR\\f[B]\\[aq]\\fR"
msgstr "\\f[B]--predefine\\f[R]=\\[aq]\\f[I]MACRO EXPR\\f[B]\\[aq]\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Defines \\f[I]MACRO\\f[R] with value \\f[I]EXPR\\f[R].  before loading macro "
"files.\\fR"
msgstr ""
"Definește \\f[I]MACRO\\f[R] cu valoarea \\f[I]EXPR\\f[R]; înainte de a "
"încărca fișierele macro."

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "Switching off features"
msgstr "Dezactivează caracteristicile"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--color [never|auto|always]\\fR"
msgstr "\\f[B]--color [never|auto|always]\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Use terminal colors for highlighting error and debug message.  Default is "
"turning colors on for ttys only (\\f[B]auto\\f[R]).\\fR"
msgstr ""
"Utilizează culorile terminalului pentru evidențierea mesajelor de eroare și "
"de depanare. Valoarea implicită este activarea culorilor numai pentru ttys "
"(\\f[B]auto\\f[R]).\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"\\f[B]--nocontexts\\f[R] Disable the SELinux plugin if available.  This "
"stops the plugin from setting SELinux contexts for files and scriptlets.\\fR"
msgstr ""
"\\f[B]--nocontexts\\f[R] Dezactivează modulul SELinux, dacă este disponibil. "
"Acest lucru împiedică modulul să stabilească contextele SELinux pentru "
"fișiere și scripturi.\\fR"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--noglob\\fR"
msgstr "\\f[B]--noglob\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Do not glob arguments when installing package files."
msgstr ""
"Nu globalizează argumentele (ignoră caracterele Jocker din argumente) atunci "
"când se instalează fișiere de pachete."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nocaps\\fR"
msgstr "\\f[B]--nocaps\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Don\\[aq]t verify capabilities of files."
msgstr "Nu verifică capacitățile fișierelor."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--excludeconfigs, --noconfigs\\fR"
msgstr "\\f[B]--excludeconfigs, --noconfigs\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Do not install configuration files."
msgstr "Nu instalează fișierele de configurare."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nohdrchk\\fR"
msgstr "\\f[B]--nohdrchk\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Don\\[aq]t verify database header(s) when retrieved."
msgstr "Nu verifică antetele bazei de date atunci când sunt recuperate."

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "Debugging"
msgstr "Depanare"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-d, --debug\\fR"
msgstr "\\f[B]-d, --debug\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print debugging information."
msgstr "Imprimă informațiile de depanare."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--deploops\\fR"
msgstr "\\f[B]--deploops\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print dependency loops as warning."
msgstr "Imprimă buclele de dependență ca avertisment."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--fsmdebug\\fR"
msgstr "\\f[B]--fsmdebug\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print debuging information of payload handling code."
msgstr ""
"Afișează informații de depanare despre codul care gestionează datele de "
"încărcare utilă."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rpmfcdebug\\fR"
msgstr "\\f[B]--rpmfcdebug\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print debug information about files packaged."
msgstr "Afișează informații de depanare despre fișierele împachetate."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--rpmiodebug\\fR"
msgstr "\\f[B]--rpmiodebug\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print debug information about file IO."
msgstr "Afișează informații de depanare despre In/Ieș de fișiere."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--stats\\fR"
msgstr "\\f[B]--stats\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Print runtime statistics of often used functions."
msgstr "Afișează statisticile de execuție ale funcțiilor utilizate frecvent."

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "Obsolete Options"
msgstr "Opțiuni învechite"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]-K, --checksig\\fR"
msgstr "\\f[B]-K, --checksig\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "See and use rpmkeys(8)."
msgstr "Consultați și utilizați rpmkeys(8)."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--nodocs\\fR"
msgstr "\\f[B]--nodocs\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Do not install documentation.  Use \\f[B]--excludedocs\\f[R] instead.\\fR"
msgstr ""
"Nu instalează documentația. Folosiți în schimb \\f[B]--excludedocs\\f[R].\\fR"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--promoteepoch\\fR"
msgstr "\\f[B]--promoteepoch\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Enable obsolete epoch handling used in rpm 3.x time frame."
msgstr ""
"Activează manipularea epocii învechite utilizate în perioada de timp a rpm "
"3.x."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "\\f[B]--prtpkts\\fR"
msgstr "\\f[B]--prtpkts\\fR"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"OBSOLETE! Used to print the packages containing and representing the pgp "
"keys for debugging purposes."
msgstr ""
"OBSOLETĂ! Utilizată pentru a afișa pachetele care conțin și reprezintă "
"cheile pgp în scopuri de depanare."
