#: mageia-cauldron
msgid "I</etc/hosts>"
msgstr "I</etc/hosts>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "I</etc/ethers>"
msgstr "I</etc/ethers>"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "SEE ALSO"
msgstr "CONSULTAȚI ȘI"

