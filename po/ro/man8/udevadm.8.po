#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "udevadm - udev management tool"
msgstr "udevadm - instrument de gestionare udev"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm> [B<--debug>] [B<--version>] [B<--help>]"
msgstr "B<udevadm> [B<--debug>] [B<--version>] [B<--help>]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm info >B<[options]>B< >B<[devpath]>"
msgstr "B<udevadm info >B<[opțiuni]>B< >B<[rută-dispozitiv]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm trigger >B<[options]>B< >B<[devpath]>"
msgstr "B<udevadm trigger >B<[opțiuni]>B< >B<[rută-dispozitiv]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm settle >B<[options]>"
msgstr "B<udevadm settle >B<[opțiuni]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm control >I<option>"
msgstr "B<udevadm control >I<opțiuni>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm monitor >B<[options]>"
msgstr "B<udevadm monitor >B<[opțiuni]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm test >B<[options]>B< >I<devpath>"
msgstr "B<udevadm test >B<[opțiuni]>B< >I<rută-dispozitiv>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm test-builtin >B<[options]>B< >I<command>B< >I<devpath>"
msgstr ""
"B<udevadm test-builtin >B<[opțiuni]>B< >I<comanda>B< >I<rută-dispozitiv>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm verify> [options...] [I<file>...]"
msgstr "B<udevadm verify> [opțiuni...] [I<fișier>...]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm wait >B<[options]>B< >I<device|syspath>"
msgstr "B<udevadm wait >B<[opțiuni]>B< >I<dispozitiv|rută-sistem>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<udevadm lock >B<[options]>B< >I<command>"
msgstr "B<udevadm lock >B<[opțiuni]>B< >I<comanda>"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIERE"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"B<udevadm> expects a command and command specific options\\&. It controls "
"the runtime behavior of B<systemd-udevd>, requests kernel events, manages "
"the event queue, and provides simple debugging mechanisms\\&."
msgstr ""
"B<udevadm> așteaptă o comandă și opțiuni specifice comenzii. Acesta "
"controlează comportamentul în timpul rulării al B<systemd-udevd>, solicită "
"evenimente de la nucleu, gestionează coada de evenimente și oferă mecanisme "
"simple de depanare."

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "OPTIONS"
msgstr "OPȚIUNI"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-d>, B<--debug>"
msgstr "B<-d>, B<--debug>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Print debug messages to standard error\\&. This option is implied in "
"B<udevadm test> and B<udevadm test-builtin> commands\\&."
msgstr ""
"Afișează mesajele de depanare la ieșirea de eroare standard. Această opțiune "
"este implicită în comenzile B<udevadm test> și B<udevadm test-builtin>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-h>, B<--help>"
msgstr "B<-h>, B<--help>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Print a short help text and exit\\&."
msgstr "Afișează acest mesaj de ajutor și iese\\&."

#. type: SS
#: archlinux debian-unstable fedora-41 fedora-rawhide
#, no-wrap
msgid "udevadm info [I<options>R<] [>I<devpath>R<|>I<file>R<|>I<unit>R<]>"
msgstr "udevadm info [I<opțiuni>R<] [>I<rută-dispozitiv>R<|>I<fișier>R<|>I<unitate>R<]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Query the udev database for device information\\&."
msgstr "Interoghează baza de date udev pentru informații despre dispozitive."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Positional arguments should be used to specify one or more devices\\&. Each "
"one may be a device name (in which case it must start with /dev/), a sys "
"path (in which case it must start with /sys/), or a systemd device unit name "
"(in which case it must end with \"\\&.device\", see B<systemd.device>(5))\\&."
msgstr ""
"Argumentele poziționale trebuie să fie utilizate pentru a specifica unul sau "
"mai multe dispozitive. Fiecare poate fi un nume de dispozitiv (caz în care "
"trebuie să înceapă cu „/dev/”), o rută de sistem (caz în care trebuie să "
"înceapă cu „/sys/”) sau un nume de unitate de dispozitiv systemd (caz în "
"care trebuie să se termine cu „.device”, a se vedea B<systemd.device>(5))."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-q>, B<--query=>I<TYPE>"
msgstr "B<-q>, B<--query=>I<TIP>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Query the database for the specified type of device data\\&. Valid I<TYPE>s "
"are: B<name>, B<symlink>, B<path>, B<property>, B<all>\\&."
msgstr ""
"Interoghează baza de date pentru tipul specificat de date privind "
"dispozitivul. I<TIP>urile valide sunt: B<name>, B<symlink>, B<path>, "
"B<property>, B<all>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<--property=>I<NAME>"
msgstr "B<--property=>I<NUME>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"When showing device properties using the B<--query=property> option, limit "
"display to properties specified in the argument\\&. The argument should be a "
"comma-separated list of property names\\&. If not specified, all known "
"properties are shown\\&."
msgstr ""
"Atunci când se afișează proprietățile dispozitivului utilizând opțiunea B<--"
"query=property>, limitează afișarea la proprietățile specificate în "
"argument. Argumentul trebuie să fie o listă de nume de proprietăți separate "
"prin virgule. Dacă nu este specificat, sunt afișate toate proprietățile "
"cunoscute."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "Added in version 250\\&."
msgstr "Adăugată în versiunea 250\\&."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<--value>"
msgstr "B<--value>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"When showing device properties using the B<--query=property> option, print "
"only their values, and skip the property name and \"=\"\\&."
msgstr ""
"Atunci când se afișează proprietățile dispozitivului utilizând opțiunea B<--"
"query=property>, afișează numai valorile acestora și ignoră numele "
"proprietății și „=”."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Cannot be used together with B<-x/--export> or B<-P/--export-prefix>\\&."
msgstr ""
"Nu poate fi utilizată împreună cu opțiunea B<-x/--export> sau B<-P/--export-"
"prefix>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-p>, B<--path=>I<DEVPATH>"
msgstr "B<-p>, B<--path=>I<RUTĂ_DISPOZITIV>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"The /sys/ path of the device to query, e\\&.g\\&.  [/sys/]/class/block/"
"sda\\&. This option is an alternative to the positional argument with a /"
"sys/ prefix\\&.  B<udevadm info --path=/class/block/sda> is equivalent to "
"B<udevadm info /sys/class/block/sda>\\&."
msgstr ""
"Ruta „/sys/” a dispozitivului de interogat, de exemplu „[/sys/]/class/block/"
"sda”. Această opțiune este o alternativă la argumentul pozițional cu un "
"prefix „/sys/”. B<udevadm info --path=/class/block/sda> este echivalent cu "
"B<udevadm info /sys/class/block/sda>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-n>, B<--name=>I<FILE>"
msgstr "B<-n>, B<--name=>I<FIȘIER>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"The name of the device node or a symlink to query, e\\&.g\\&.  [/dev/]/"
"sda\\&. This option is an alternative to the positional argument with a /"
"dev/ prefix\\&.  B<udevadm info --name=sda> is equivalent to B<udevadm info /"
"dev/sda>\\&."
msgstr ""
"Numele nodului dispozitivului sau o legătură simbolică pentru interogare, de "
"exemplu „[/dev/]/sda”. Această opțiune este o alternativă la argumentul "
"pozițional cu un prefix „/dev/”. Comanda B<udevadm info --name=sda> este "
"echivalentă cu B<udevadm info /dev/sda>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-r>, B<--root>"
msgstr "B<-r>, B<--root>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Print absolute paths in B<name> or B<symlink> query\\&."
msgstr "Afișează rutele absolute în interogarea B<name> sau B<symlink>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-a>, B<--attribute-walk>"
msgstr "B<-a>, B<--attribute-walk>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Print all sysfs properties of the specified device that can be used in udev "
"rules to match the specified device\\&. It prints all devices along the "
"chain, up to the root of sysfs that can be used in udev rules\\&."
msgstr ""
"Afișează toate proprietățile sysfs ale dispozitivului specificat care pot fi "
"utilizate în regulile udev pentru a se potrivi cu dispozitivul specificat. "
"Afișează toate dispozitivele de-a lungul lanțului, până la rădăcina sysfs, "
"care pot fi utilizate în regulile udev."

#. type: Plain text
#: archlinux debian-unstable fedora-rawhide
msgid ""
"This switch supports JSON output mode (see B<--json=> below)\\&. Note that "
"because this switch generates multiple JSON objects, JSON-SEQ mode is "
"automatically enabled (RFC7464)\\&. (Note: tools such as \\m[blue]B<jq>\\m[]"
"\\&\\s-2\\u[1]\\d\\s+2 natively support JSON-SEQ via the B<--seq> switch\\&.)"
msgstr ""
"Această opțiune acceptă modul de ieșire JSON (consultați B<--json=> mai jos)"
"\\&. Rețineți că, deoarece această opțiune generează mai multe obiecte JSON, "
"modul JSON-SEQ este activat automat (RFC7464)\\&. (Notă: instrumente precum "
"\\m[blue]B<jq>\\m[]\\&\\s-2\\u[1]\\d\\s+2 acceptă nativ JSON-SEQ prin "
"intermediul opțiunii B<--seq>\\&.)"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-t>, B<--tree>"
msgstr "B<-t>, B<--tree>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Display a sysfs tree\\&. This recursively iterates through the sysfs "
"hierarchy and displays it in a tree structure\\&. If a path is specified "
"only the subtree below and its parent directories are shown\\&. This will "
"show both device and subsystem items\\&."
msgstr ""
"Afișează un arbore sysfs. Aceasta itera recursiv prin ierarhia sysfs și o "
"afișează într-o structură arborescentă. Dacă este specificată o rută, sunt "
"afișate numai subarborele de mai jos și directoarele părinte ale acestuia. "
"Aceasta va afișa atât elemente de dispozitiv, cât și de subsistem."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "Added in version 251\\&."
msgstr "Adăugată în versiunea 251\\&."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-x>, B<--export>"
msgstr "B<-x>, B<--export>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Print output as key/value pairs\\&. Values are enclosed in single quotes\\&. "
"This takes effects only when B<--query=property> or B<--device-id-of-"
"file=>I<FILE> is specified\\&."
msgstr ""
"Imprimă ieșirea ca perechi cheie/valoare. Valorile sunt închise între "
"ghilimele simple. Aceasta are efect numai atunci când este specificată B<--"
"query=property> sau B<--device-id-of-file=>I<FIȘIER>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-P>, B<--export-prefix=>I<NAME>"
msgstr "B<-P>, B<--export-prefix=>I<NUME>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Add a prefix to the key name of exported values\\&. This implies B<--"
"export>\\&."
msgstr ""
"Adaugă un prefix la numele cheii valorilor exportate. Aceasta implică B<--"
"export>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-d>, B<--device-id-of-file=>I<FILE>"
msgstr "B<-d>, B<--device-id-of-file=>I<FIȘIER>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Print major/minor numbers of the underlying device, where the file lives "
"on\\&. If this is specified, all positional arguments are ignored\\&."
msgstr ""
"Afișează numerele majore/minore ale dispozitivului de bază, pe care se află "
"fișierul. Dacă acest lucru este specificat, toate argumentele poziționale "
"sunt ignorate."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-e>, B<--export-db>"
msgstr "B<-e>, B<--export-db>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Export the content of the udev database\\&."
msgstr "Exportă conținutul bazei de date udev."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-c>, B<--cleanup-db>"
msgstr "B<-c>, B<--cleanup-db>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Cleanup the udev database\\&."
msgstr "Curăță baza de date udev."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<-w>B<[SECONDS]>, B<--wait-for-initialization>B<[=SECONDS]>"
msgstr "B<-w>B<[SECUNDE]>, B<--wait-for-initialization>B<[=SECUNDE]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Wait for device to be initialized\\&. If argument I<SECONDS> is not "
"specified, the default is to wait forever\\&."
msgstr ""
"Așteaptă ca dispozitivul să fie inițializat. Dacă argumentul I<SECUNDE> nu "
"este specificat, implicit se așteaptă pentru totdeauna."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "Added in version 243\\&."
msgstr "Adăugată în versiunea 243\\&."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"B<--subsystem-match>B<[=SUBSYSTEM]>, B<--subsystem-nomatch>B<[=SUBSYSTEM]>"
msgstr ""
"B<--subsystem-match>B<[=SUBSYSTEM]>, B<--subsystem-nomatch>B<[=SUBSYSTEM]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices of or not of the given "
"subsystem respectively\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"care aparțin sau nu subsistemului dat."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "Added in version 255\\&."
msgstr "Adăugată în versiunea 251\\&."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--attr-match>B<[=FILE[=VALUE]]>, B<--attr-nomatch>B<[=FILE[=VALUE]]>"
msgstr ""
"B<--attr-match>B<[=FIȘIER[=VALOARE]]>, B<--attr-"
"nomatch>B<[=FIȘIER[=VALOARE]]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices matching or not matching "
"the given attribute respectively\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"care corespund sau nu corespund atributului dat."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--property-match>B<[=KEY=VALUE]>"
msgstr "B<--property-match>B<[=CHEIE=VALOARE]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices matching the given property "
"and value\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"care corespund proprietății și valorii date."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--tag-match>B<[=TAG]>"
msgstr "B<--tag-match>B<[=ETICHETA]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "When used with B<--export-db>, only show devices with the given tag\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"cu eticheta dată."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--sysname-match>B<[=NAME]>"
msgstr "B<--sysname-match>B<[=NUME]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices with the given \"/sys\" "
"path\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"cu ruta „/sys” dată."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--name-match>B<[=NAME]>"
msgstr "B<--name-match>B<[=NUME]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices with the given name in \"/"
"dev\"\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"cu numele dat în „/dev”."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--parent-match>B<[=NAME]>"
msgstr "B<--parent-match>B<[=NUME]>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices with the given parent "
"device\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"cu dispozitivul părinte dat."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<--initialized-match>, B<--initialized-nomatch>"
msgstr "B<--initialized-match>, B<--initialized-nomatch>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"When used with B<--export-db>, only show devices that are initialized or not "
"initialized respectively\\&."
msgstr ""
"Atunci când este utilizată cu B<--export-db>, afișează numai dispozitivele "
"care sunt inițializate sau respectiv neinițializate."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid "B<--json=>I<MODE>"
msgstr "B<--json=>I<MODUL>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"Shows output formatted as JSON\\&. Expects one of \"short\" (for the "
"shortest possible output without any redundant whitespace or line breaks), "
"\"pretty\" (for a pretty version of the same, with indentation and line "
"breaks) or \"off\" (to turn off JSON output, the default)\\&."
msgstr ""
"Afișează ieșirea formatată ca JSON\\&. Așteaptă una dintre următoarele "
"variante: short” (pentru o ieșire cât mai scurtă posibil, fără spații albe "
"sau pauze de linie redundante), „pretty” (pentru o versiune plăcută a "
"acesteia, cu indentare și pauze de linie) sau „off” (pentru a dezactiva "
"ieșirea JSON, implicit)\\&."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "B<--no-pager>"
msgstr "B<--no-pager>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Do not pipe output into a pager\\&."
msgstr "Nu canalizează (pipe) ieșirea către un paginator\\&."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"The generated output shows the current device database entry in a terse "
"format\\&. Each line shown is prefixed with one of the following characters:"
msgstr ""
"Ieșirea generată arată intrarea curentă în baza de date a dispozitivului "
"într-un format laconic. Fiecare linie afișată este prefixată cu unul dintre "
"următoarele caractere:"

