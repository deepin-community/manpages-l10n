#: debian-bookworm
msgid "crontab(1), crontab(5), run-parts(8)"
msgstr "crontab(1), crontab(5), run-parts(8)"

#. type: SH
#: debian-bookworm fedora-41 fedora-rawhide mageia-cauldron opensuse-leap-16-0
#: opensuse-tumbleweed
