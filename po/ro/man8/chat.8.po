#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0
msgid "\\&'' ATDT5551212"
msgstr "\\&'' ATDT5551212"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0
msgid "TIMEOUT 120"
msgstr "TIMEOUT 120"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0
msgid "SAY \"Waiting up to 2 minutes for connection ... \""
msgstr "SAY \"Se așteaptă până la 2 minute pentru conectare... \""

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0
msgid "CONNECT ''"
msgstr "CONNECT ''"

