msgid "B</usr/sbin/rpc.mountd [>I<options>B<]>"
msgstr "B</usr/sbin/rpc.mountd [>I<opțiuni>B<]>"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
