msgstr ""
"\\f[B]--nopre\\f[R] \\f[B]--nopost\\f[R] \\f[B]--nopreun\\f[R] \\f[B]--"
"nopostun\\f[R] \\f[B]--nopretrans\\f[R] \\f[B]--noposttrans\\f[R] \\f[B]--"
