#. type: TH
#: debian-bookworm
#, no-wrap
msgid "GRUB-MD5-CRYPT"
msgstr "GRUB-MD5-CRYPT"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "January 2022"
msgstr "ianuarie 2022"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "grub-md5-crypt (GNU GRUB )"
msgstr "grub-md5-crypt (GNU GRUB )"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "System Administration Utilities"
msgstr "Utilitare de administrare a sistemului"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: debian-bookworm
msgid "grub-md5-crypt - Encrypt a password in MD5 format"
msgstr "grub-md5-crypt - criptează o parolă în format MD5"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: debian-bookworm
msgid "B<grub-md5-crypt> [I<\\,OPTION\\/>]"
msgstr "B<grub-md5-crypt> [I<\\,OPȚIUNE\\/>]"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIERE"

#. type: Plain text
#: debian-bookworm
msgid "Encrypt a password in MD5 format."
msgstr "Criptează o parolă în format MD5."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<-h>, B<--help>"
msgstr "B<-h>, B<--help>"

#. type: Plain text
#: debian-bookworm
msgid "print this message and exit"
msgstr "afișează acest mesaj și iese"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<-v>, B<--version>"
msgstr "B<-v>, B<--version>"

#. type: Plain text
#: debian-bookworm
msgid "print the version information and exit"
msgstr "afișează informațiile despre versiune și iese"

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--grub-shell>=I<\\,FILE\\/>"
msgstr "B<--grub-shell>=I<\\,FIȘIER\\/>"

#. type: Plain text
#: debian-bookworm
msgid "use FILE as the grub shell"
msgstr "utilizează FIȘIERUL ca shell grub"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "REPORTING BUGS"
msgstr "RAPORTAREA ERORILOR"

#. type: Plain text
#: debian-bookworm
msgid "Report bugs to E<lt>bug-grub@gnu.orgE<gt>."
msgstr "Raportați erorile la E<lt>bug-grub@gnu.orgE<gt>."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr "CONSULTAȚI ȘI"

#. type: Plain text
#: debian-bookworm
msgid ""
"The full documentation for B<grub-md5-crypt> is maintained as a Texinfo "
"manual.  If the B<info> and B<grub-md5-crypt> programs are properly "
"installed at your site, the command"
msgstr ""
"Documentația completă pentru B<grub-mkconfig> este menținută ca un manual "
"Texinfo. Dacă programele B<info> și B<grub-md5-crypt> sunt instalate corect "
"în sistemul dvs., comanda"

#. type: Plain text
#: debian-bookworm
msgid "B<info grub-md5-crypt>"
msgstr "B<info grub-md5-crypt>"

#. type: Plain text
#: debian-bookworm
msgid ""
"should give you access to the complete manual.  You may need to install the "
"B<grub-legacy-doc> package."
msgstr ""
"ar trebui să vă permită accesul la manualul complet. Este posibil să fie "
"necesar să instalați pachetul B<grub-legacy-doc>."
