"-----   -----------\n"
"Sharp   JX-610\n"
"Sharp   JX-250\n"
"Sharp   JX-320\n"
"Sharp   JX-330\n"
"Sharp   JX-350\\fR\n"
msgstr ""
"\\f(CRFabricant  Id produs:\n"
"---------  ----------\n"
"Sharp      JX-610\n"
"Sharp      JX-250\n"
"Sharp      JX-320\n"
"Sharp      JX-330\n"
"Sharp      JX-350\\fR\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "The following scanners are detected by the backend, but not tested:"
msgstr "Următoarele scanere sunt detectate de controlor, dar nu sunt testate:"

