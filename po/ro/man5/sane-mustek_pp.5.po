msgstr "Opțiuni globale"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
msgid "B<no_epp>"
msgstr "B<no_epp>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"Disable parallel port mode EPP: works around a known bug in the Linux "
"parport code. Enable this option, if the backend hangs when trying to access "
"the parallel port in EPP mode."
msgstr ""
"Dezactivează modul port paralel EPP: rezolvă o eroare cunoscută în codul "
"Linux parport. Activați această opțiune, dacă controlorul se blochează "
"atunci când încearcă să acceseze portul paralel în modul EPP."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Default value: use EPP"
msgstr "Valoarea implicită: use EPP"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
