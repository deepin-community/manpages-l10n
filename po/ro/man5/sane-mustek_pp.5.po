#, no-wrap
msgid "GLOBAL OPTIONS"
msgstr "OPȚIUNI GLOBALE"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid ""
"You can control the overall behaviour of the B<sane-\\mustek_pp> backend by "
"global options which precede any scanner definition in the I<mustek_pp.conf> "
"file."
msgstr ""
"Puteți controla comportamentul general al controlorului B<sane-\\mustek_pp> "
"prin opțiuni globale care preced orice definiție a scanerului în fișierul "
"I<mustek_pp.conf>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
msgid "Currently, there is only one global option:"
msgstr "În prezent, există o singură opțiune globală:"

#. type: SS
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron
#, no-wrap
