msgid ""
"coolscan3 written by A. Zummo E<lt>I<a.zummo@towertech.it>E<gt>, based "
"heavily on coolscan2 written by Andr\\['a]s Major "
"E<lt>I<andras@users.sourceforge.net>E<gt>."
msgstr ""
