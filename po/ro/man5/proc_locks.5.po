#. type: TH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "proc_locks"
msgstr "proc_locks"

#. type: TH
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "2024-05-02"
msgstr "2 mai 2024"

#. type: TH
#: archlinux debian-unstable fedora-41 fedora-rawhide
#, no-wrap
msgid "Linux man-pages 6.9.1"
msgstr "Pagini de manual de Linux 6.9.1"

#. type: SH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "NAME"
msgstr "NUME"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "/proc/locks - current file locks and leases"
msgstr "/proc/locks - blocajele și închirierile curente ale fișierelor"

#. type: SH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIERE"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/locks>"
msgstr "I</proc/locks>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"This file shows current file locks (B<flock>(2)  and B<fcntl>(2))  and "
"leases (B<fcntl>(2))."
msgstr ""
"Acest fișier arată blocajele (B<flock>(2) și B<fcntl>(2)) și închirierile "
"(B<fcntl>(2)) curente ale fișierelor."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "An example of the content shown in this file is the following:"
msgstr "Un exemplu de conținut afișat în acest fișier este următorul:"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"1: POSIX  ADVISORY  READ  5433 08:01:7864448 128 128\n"
"2: FLOCK  ADVISORY  WRITE 2001 08:01:7864554 0 EOF\n"
"3: FLOCK  ADVISORY  WRITE 1568 00:2f:32388 0 EOF\n"
"4: POSIX  ADVISORY  WRITE 699 00:16:28457 0 EOF\n"
"5: POSIX  ADVISORY  WRITE 764 00:16:21448 0 0\n"
"6: POSIX  ADVISORY  READ  3548 08:01:7867240 1 1\n"
"7: POSIX  ADVISORY  READ  3548 08:01:7865567 1826 2335\n"
"8: OFDLCK ADVISORY  WRITE -1 08:01:8713209 128 191\n"
msgstr ""
"1: POSIX  ADVISORY  READ  5433 08:01:7864448 128 128\n"
"2: FLOCK  ADVISORY  WRITE 2001 08:01:7864554 0 EOF\n"
"3: FLOCK  ADVISORY  WRITE 1568 00:2f:32388 0 EOF\n"
"4: POSIX  ADVISORY  WRITE 699 00:16:28457 0 EOF\n"
"5: POSIX  ADVISORY  WRITE 764 00:16:21448 0 0\n"
"6: POSIX  ADVISORY  READ  3548 08:01:7867240 1 1\n"
"7: POSIX  ADVISORY  READ  3548 08:01:7865567 1826 2335\n"
"8: OFDLCK ADVISORY  WRITE -1 08:01:8713209 128 191\n"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "The fields shown in each line are as follows:"
msgstr "Câmpurile afișate pe fiecare linie sunt următoarele:"

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[1]"
msgstr "[1]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "The ordinal position of the lock in the list."
msgstr "Poziția ordinală a blocării în listă."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[2]"
msgstr "[2]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "The lock type.  Values that may appear here include:"
msgstr "Tipul de blocare. Valorile care pot apărea aici includ:"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<FLOCK>"
msgstr "B<FLOCK>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is a BSD file lock created using B<flock>(2)."
msgstr "Acesta este un fișier de blocare BSD creat folosind B<flock>(2)."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<OFDLCK>"
msgstr "B<OFDLCK>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is an open file description (OFD) lock created using B<fcntl>(2)."
msgstr ""
"Aceasta este o blocare OFD (Open File Description) creată cu ajutorul "
"B<fcntl>(2)."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<POSIX>"
msgstr "B<POSIX>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is a POSIX byte-range lock created using B<fcntl>(2)."
msgstr ""
"Aceasta este o blocare de interval de octeți POSIX creată utilizând "
"B<fcntl>(2)."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[3]"
msgstr "[3]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "Among the strings that can appear here are the following:"
msgstr "Printre șirurile care pot apărea aici se numără următoarele:"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<ADVISORY>"
msgstr "B<ADVISORY>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is an advisory lock."
msgstr "Aceasta este o blocare de avizare."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<MANDATORY>"
msgstr "B<MANDATORY>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is a mandatory lock."
msgstr "Aceasta este o blocare obligatorie."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[4]"
msgstr "[4]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "The type of lock.  Values that can appear here are:"
msgstr "Tipul de blocare. Valorile care pot apărea aici sunt:"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<READ>"
msgstr "B<READ>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is a POSIX or OFD read lock, or a BSD shared lock."
msgstr ""
"Aceasta este o blocare de citire POSIX sau OFD, sau o blocare partajată BSD."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<WRITE>"
msgstr "B<WRITE>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is a POSIX or OFD write lock, or a BSD exclusive lock."
msgstr ""
"Aceasta este o blocare de scriere POSIX sau OFD, sau o blocare exclusivă BSD."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[5]"
msgstr "[5]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "The PID of the process that owns the lock."
msgstr "PID-ul procesului care deține blocajul."

#.  commit 9d5b86ac13c573795525ecac6ed2db39ab23e2a8
#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Because OFD locks are not owned by a single process (since multiple "
"processes may have file descriptors that refer to the same open file "
"description), the value -1 is displayed in this field for OFD locks.  "
"(Before Linux 4.14, a bug meant that the PID of the process that initially "
"acquired the lock was displayed instead of the value -1.)"
msgstr ""
"Deoarece blocajele OFD nu sunt deținute de un singur proces (deoarece mai "
"multe procese pot avea descriptori de fișier care se referă la aceeași "
"descriere de fișier deschis), valoarea -1 este afișată în acest câmp pentru "
"blocajele OFD; (înainte de Linux 4.14, o eroare a făcut ca PID-ul procesului "
"care a achiziționat inițial blocajul să fie afișat în locul valorii -1)."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[6]"
msgstr "[6]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Three colon-separated subfields that identify the major and minor device ID "
"of the device containing the filesystem where the locked file resides, "
"followed by the inode number of the locked file."
msgstr ""
"Trei subcâmpuri separate prin două puncte (:) care identifică ID-ul "
"dispozitivului major și minor al dispozitivului care conține sistemul de "
"fișiere în care se află fișierul blocat, urmat de numărul de nod-i al "
"fișierului blocat."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[7]"
msgstr "[7]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The byte offset of the first byte of the lock.  For BSD locks, this value is "
"always 0."
msgstr ""
"Decalajul de octeți al primului octet al blocării. Pentru blocajele BSD, "
"această valoare este întotdeauna 0."

#. type: IP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "[8]"
msgstr "[8]"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The byte offset of the last byte of the lock.  B<EOF> in this field means "
"that the lock extends to the end of the file.  For BSD locks, the value "
"shown is always I<EOF>."
msgstr ""
"Decalajul de octeți al ultimului octet al blocării. B<EOF> în acest câmp "
"înseamnă că blocarea se extinde până la sfârșitul fișierului. Pentru "
"blocajele BSD, valoarea indicată este întotdeauna I<EOF>."

#.  commit d67fd44f697dff293d7cdc29af929241b669affe
#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Since Linux 4.9, the list of locks shown in I</proc/locks> is filtered to "
"show just the locks for the processes in the PID namespace (see "
"B<pid_namespaces>(7))  for which the I</proc> filesystem was mounted.  (In "
"the initial PID namespace, there is no filtering of the records shown in "
"this file.)"
msgstr ""
"Începând cu Linux 4.9, lista de blocaje afișată în I</proc/locks> este "
"filtrată pentru a afișa doar blocajele pentru procesele din spațiul de nume "
"PID (a se vedea B<pid_namespaces>(7)) pentru care a fost montat sistemul de "
"fișiere I</proc>; (în spațiul de nume PID inițial, nu există nicio filtrare "
"a înregistrărilor afișate în acest fișier)."

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The B<lslocks>(8)  command provides a bit more information about each lock."
msgstr ""
"Comanda B<lslocks>(8) oferă ceva mai multe informații despre fiecare blocare."

#. type: SH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "SEE ALSO"
msgstr "CONSULTAȚI ȘI"

