msgstr "Biblioteca statică care implementează acest controlor."

#. type: TP
#: archlinux
#, no-wrap
msgid "I</usr/lib/sane/libsane-apple.so>"
msgstr "I</usr/lib/sane/libsane-apple.so>"

# R-GC, scrie:
