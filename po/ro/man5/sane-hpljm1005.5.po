#: archlinux
#, no-wrap
msgid "I</usr/lib/sane/libsane-hpljm1005.so>"
msgstr "I</usr/lib/sane/libsane-hpljm1005.so>"

# R-GC, scrie:
# pentru motivul traducerii:
# backend = controlor, a se vedea
# pagina:
# <https://en.wikipedia.org/wiki/
# Scanner_Access_Now_Easy>
