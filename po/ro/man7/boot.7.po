#: opensuse-tumbleweed
msgid "I</etc/init.d/>, I</etc/rc[S0-6].d/>, I</etc/sysconfig/>"
msgstr "I</etc/init.d/>, I</etc/rc[S0-6].d/>, I</etc/sysconfig/>"

