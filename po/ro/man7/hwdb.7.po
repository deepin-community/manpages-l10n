"# /lib/udev/hwdb\\&.d/example\\&.hwdb\n"
"# Comments can be placed before any records\\&. This is a good spot\n"
"# to describe what that file is used for, what kind of properties\n"
"# it defines, and the ordering convention\\&.\n"
msgstr ""
