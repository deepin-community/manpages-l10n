#.  not really true ATM
#.  .P
#.  Linux ICMP should be compliant to RFC 1122.
#. type: Plain text
#. #-#-#-#-#  debian-bookworm: icmp.7.pot (PACKAGE VERSION)  #-#-#-#-#
#.  not really true ATM
#.  .PP
#.  Linux ICMP should be compliant to RFC 1122.
#. type: Plain text
#. #-#-#-#-#  debian-unstable: icmp.7.pot (PACKAGE VERSION)  #-#-#-#-#
#.  not really true ATM
#.  .P
#.  Linux ICMP should be compliant to RFC 1122.
#. type: Plain text
#. #-#-#-#-#  fedora-41: icmp.7.pot (PACKAGE VERSION)  #-#-#-#-#
