msgstr "B<--pid=>I<pid>"

#. type: IX
#: archlinux opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "--pid=pid"
msgstr "--pid=pid"

#. type: Plain text
#: archlinux
msgid ""
"Attach \\s-1GDB\\s0 to an already running program, with the \\s-1PID\\s0 "
"I<pid>."
msgstr ""
"Atașează \\s-1GDB\\s0 la un program care rulează deja, cu \\s-1PID\\s0 "
"I<pid>."

#. type: IP
#: archlinux opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
