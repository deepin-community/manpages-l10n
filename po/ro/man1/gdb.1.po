msgstr "--cd=director"

#. type: Plain text
#: archlinux
msgid ""
"Run \\s-1GDB\\s0 using I<directory> as its working directory, instead of the "
"current directory."
msgstr ""
"Rulează \\s-1GDB\\s0 folosind I<directorul> ca director de lucru, în loc de "
"directorul curent."

#. type: IP
#: archlinux opensuse-leap-16-0 opensuse-tumbleweed
