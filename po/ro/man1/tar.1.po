#: mageia-cauldron
#, no-wrap
msgid "B<-L>, B<--tape-length>=I<NUMBER>"
msgstr "B<-L>, B<--tape-length>=I<NUMĂR>"

#. type: Plain text
#: mageia-cauldron
msgid "change tape after writing NUMBER x 1024 bytes"
msgstr "schimbă banda după scriere a NUMĂR x 1024 octeţi"

