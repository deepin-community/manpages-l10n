msgstr "B<-b>, B<--batch>"

#. type: Plain text
#: debian-bookworm debian-unstable
msgid "output non-interactively"
msgstr "ieșire neinteractivă"

#. type: TP
#: debian-bookworm debian-unstable
#, no-wrap
msgid "B<-r>, B<--reverse>"
