msgid ""
"X(7), xev(1), setxkbmap(1), XStringToKeysym(3), I<Xlib> documentation on key "
"and pointer events"
msgstr ""
"X(7), xev(1), setxkbmap(1), XStringToKeysym(3), documentația I<Xlib> privind "
