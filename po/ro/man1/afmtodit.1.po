msgstr "I</usr/\\:share/\\:groff/\\:1.22.4/\\:font/\\:devps/\\:>F"

#. type: Plain text
#: debian-bookworm
msgid "Font description file for font I<F>."
msgstr "Fișierul de descriere a fontului pentru fontul I<F>."

#. type: TP
#: debian-bookworm
#, no-wrap
