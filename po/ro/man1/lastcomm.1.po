msgid "LASTCOMM"
msgstr "LASTCOMM"

#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "1995 October 31"
msgstr "31 octombrie 1995"

#. type: SH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
