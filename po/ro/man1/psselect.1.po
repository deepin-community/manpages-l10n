msgstr "B<-r>, B<--reverse>"

#. type: Plain text
#: archlinux
msgid "reverse the order of the output pages"
msgstr "inversează ordinea paginilor"

#. type: TP
#: archlinux fedora-41 fedora-rawhide mageia-cauldron
#, no-wrap
