#. type: TP
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid "B<-o>, B<--odd>"
msgstr "B<-o>, B<--odd>"

#. type: Plain text
#: archlinux
msgid "select odd-numbered output pages"
