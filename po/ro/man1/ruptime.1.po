msgstr "E<.Nm ruptime>"

#. type: Nd
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide
#, no-wrap
msgid "show host status of local machines"
msgstr "afișează starea gazdei mașinilor locale"

