#: mageia-cauldron opensuse-tumbleweed
msgid ""
"B<mutt_dotlock>(1), B<mutt_pgpring>(1), B<pgpewrap>(1), B<sendmail>(1), "
"B<smail>(1), B<smime_keys>(1), B<curses>(3), B<ncurses>(3), B<mailcap>(5), "
"B<maildir>(5), B<mbox>(5), B<mmdf>(5), B<muttrc>(5)"
msgstr ""
