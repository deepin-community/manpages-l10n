#: debian-bookworm debian-unstable
msgid ""
"E<.Ar hostname | user@hostname> E<.Op Fl l Ar login_name> E<.Op Ar command>"
msgstr ""
"E<.Ar nume-gazdă | utilizator@nume-gazdă> E<.Op Fl l Ar nume-utilizator-"
