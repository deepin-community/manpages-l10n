#. type: Plain text
#: archlinux fedora-41 fedora-rawhide mageia-cauldron opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "B<gs> [ I<options> ] [ I<files> ] ... B<(Unix, VMS)>"
msgstr "B<gs> [ I<opțiuni> ] [ I<fișiere> ] ... B<(Unix, VMS)>"

#. type: Plain text
