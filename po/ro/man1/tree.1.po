msgid "B<LS_COLORS>\t\tColor information created by dircolors"
msgstr "B<LS_COLORS>\t\tInformații despre culori create de B<dircolors>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
