#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<sdiff> [I<OPTION>]... I<FILE1 FILE2>"
msgstr "B<sdiff> [I<OPȚIUNE>]... I<FIȘIER1 FIȘIER2>"

