#. type: Plain text
#: archlinux
msgid "B<pspdfutils> [OPTION...] [INFILE [OUTFILE]]"
msgstr "B<pspdfutils> [OPȚIUNE...] [FIȘIER_INTRARE [FIȘIER_IEȘIRE]]"

