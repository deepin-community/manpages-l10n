#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron opensuse-leap-16-0
#: opensuse-tumbleweed
msgid ""
"B<grub-mount> [I<\\,OPTION\\/>...] I<\\,IMAGE1 \\/>[I<\\,IMAGE2 \\/>...] "
"I<\\,MOUNTPOINT\\/>"
msgstr ""
"B<grub-mount> [I<\\,OPȚIUNE\\/>...] I<\\,IMAGINE1 \\/>[I<\\,IMAGINE2 \\/"
">...] I<\\,PUNCT_MONTARE\\/>"

