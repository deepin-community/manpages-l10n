msgstr "Afișează opțiunile liniei de comandă\\&."

#. type: Plain text
#: archlinux
msgid "B<-c>"
msgstr "B<-c>"

#. type: Plain text
#: archlinux
msgid "Recreate the chroot before building."
msgstr "Recreează chroot-ul înainte de construire."

#. type: Plain text
#: archlinux
msgid "B<-r> E<lt>dirE<gt>"
msgstr "B<-r> E<lt>directorE<gt>"

#. type: Plain text
#: archlinux
msgid "Create chroots in this directory."
msgstr "Creează chroot-uri în acest director."

