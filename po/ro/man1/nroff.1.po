#. type: SH
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: SY
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "nroff"
msgstr "nroff"

#. type: Plain text
#: debian-bookworm mageia-cauldron
