msgstr "JED"

#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#, no-wrap
msgid "OCT 1996"
msgstr "octombrie 1996"

#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#, no-wrap
msgid "Debian"
msgstr "Debian"

#. type: TH
#: debian-bookworm debian-unstable fedora-41 fedora-rawhide mageia-cauldron
