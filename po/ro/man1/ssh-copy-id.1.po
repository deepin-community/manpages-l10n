msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: archlinux debian-unstable fedora-rawhide
msgid ""
"E<.Nm> E<.Op Fl f> E<.Op Fl n> E<.Op Fl s> E<.Op Fl x> E<.Op Fl i Op Ar "
"identity_file> E<.Op Fl t Ar target_path> E<.Op Fl F Ar ssh_config> E<.Op Bo "
"Fl o Ar ssh_option Bc ...> E<.Op Fl p Ar port> E<.Op Ar user Ns @ Ns> E<.Ar "
