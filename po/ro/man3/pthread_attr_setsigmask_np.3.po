#, no-wrap
msgid ""
"B<int pthread_attr_setsigmask_np(pthread_attr_t *>I<attr>B<,>\n"
"B<                               const sigset_t *>I<sigmask>B<);>\n"
"B<int pthread_attr_getsigmask_np(const pthread_attr_t *>I<attr>B<,>\n"
"B<                               sigset_t *>I<sigmask>B<);>\n"
msgstr ""
"B<int pthread_attr_setsigmask_np(pthread_attr_t *>I<attr>B<,>\n"
