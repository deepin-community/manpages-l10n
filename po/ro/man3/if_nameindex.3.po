#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
#, no-wrap
msgid ""
"#include E<lt>net/if.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    struct if_nameindex *if_ni, *i;\n"
"\\&\n"
"    if_ni = if_nameindex();\n"
"    if (if_ni == NULL) {\n"
"        perror(\"if_nameindex\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    for (i = if_ni; !(i-E<gt>if_index == 0 && i-E<gt>if_name == NULL); i++)\n"
"        printf(\"%u: %s\\[rs]n\", i-E<gt>if_index, i-E<gt>if_name);\n"
"\\&\n"
"    if_freenameindex(if_ni);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"#include E<lt>net/if.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    struct if_nameindex *if_ni, *i;\n"
"\\&\n"
"    if_ni = if_nameindex();\n"
"    if (if_ni == NULL) {\n"
"        perror(\"if_nameindex\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    for (i = if_ni; !(i-E<gt>if_index == 0 && i-E<gt>if_name == NULL); i++)\n"
"        printf(\"%u: %s\\[rs]n\", i-E<gt>if_index, i-E<gt>if_name);\n"
"\\&\n"
"    if_freenameindex(if_ni);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

