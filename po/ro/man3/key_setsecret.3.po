"B<int key_decryptsession(char *>I<remotename>B<, des_block *>I<deskey>B<);>\n"
"B<int key_encryptsession(char *>I<remotename>B<, des_block *>I<deskey>B<);>\n"
msgstr ""
"B<int key_decryptsession(char *>I<remotename>B<, des_block *>I<deskey>B<);>\n"
"B<int key_encryptsession(char *>I<remotename>B<, des_block *>I<deskey>B<);>\n"

