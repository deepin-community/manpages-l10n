"    for (char *p = argv[1]; *p; p++)\n"
"        putchar(toupper_l(*p, nloc));\n"
msgstr ""
"    for (char *p = argv[1]; *p; p++)\n"
"        putchar(toupper_l(*p, nloc));\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    printf(\"\\en\");\n"
msgstr "    printf(\"\\en\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
