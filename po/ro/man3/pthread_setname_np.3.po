#: debian-bookworm
msgid ""
"These functions are nonstandard GNU extensions; hence the suffix \"_np\" "
"(nonportable) in the names."
msgstr ""
"Aceste funcții sunt extensii GNU nestandardizate; de aici și sufixul „_np” "
"(„neportabilă”) din nume."

#. type: Plain text
#: debian-bookworm
msgid ""
"B<pthread_setname_np>()  internally writes to the thread-specific I<comm> "
"file under the I</proc> filesystem: I</proc/self/task/[tid]/comm>.  "
"B<pthread_getname_np>()  retrieves it from the same location."
msgstr ""
"B<pthread_setname_np>() scrie intern în fișierul specific firului I<comm> "
"din cadrul sistemului de fișiere I</proc>: I</proc/self/task/[tid]/comm>. "
"B<pthread_getname_np>() îl recuperează din aceeași locație."

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#define _GNU_SOURCE\n"
"#include E<lt>err.hE<gt>\n"
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>string.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
msgstr ""
"#define _GNU_SOURCE\n"
"#include E<lt>err.hE<gt>\n"
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>string.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "#define NAMELEN 16\n"
msgstr "#define NAMELEN 16\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"static void *\n"
"threadfunc(void *parm)\n"
"{\n"
"    sleep(5);          // allow main program to set the thread name\n"
"    return NULL;\n"
"}\n"
msgstr ""
"static void *\n"
"threadfunc(void *parm)\n"
"{\n"
"    sleep(5);          // permite programului principal să stabilească numele firului\n"
"    return NULL;\n"
"}\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    pthread_t thread;\n"
"    int rc;\n"
"    char thread_name[NAMELEN];\n"
msgstr ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    pthread_t thread;\n"
"    int rc;\n"
"    char thread_name[NAMELEN];\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    rc = pthread_create(&thread, NULL, threadfunc, NULL);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_create\");\n"
msgstr ""
"    rc = pthread_create(&thread, NULL, threadfunc, NULL);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_create\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    rc = pthread_getname_np(thread, thread_name, NAMELEN);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_getname_np\");\n"
msgstr ""
"    rc = pthread_getname_np(thread, thread_name, NAMELEN);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_getname_np\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"Created a thread. Default name is: %s\\en\", thread_name);\n"
"    rc = pthread_setname_np(thread, (argc E<gt> 1) ? argv[1] : \"THREADFOO\");\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_setname_np\");\n"
msgstr ""
"    printf(\"A fost creat un fir. Numele implicit este: %s\\en\", thread_name);\n"
"    rc = pthread_setname_np(thread, (argc E<gt> 1) ? argv[1] : \"THREADFOO\");\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_setname_np\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    sleep(2);\n"
msgstr "    sleep(2);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    rc = pthread_getname_np(thread, thread_name, NAMELEN);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_getname_np\");\n"
"    printf(\"The thread name after setting it is %s.\\en\", thread_name);\n"
msgstr ""
"    rc = pthread_getname_np(thread, thread_name, NAMELEN);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_getname_np\");\n"
"    printf(\"Numele firului după definire este %s.\\en\", thread_name);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    rc = pthread_join(thread, NULL);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_join\");\n"
msgstr ""
"    rc = pthread_join(thread, NULL);\n"
"    if (rc != 0)\n"
"        errc(EXIT_FAILURE, rc, \"pthread_join\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"Done\\en\");\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"    printf(\"Gata\\en\");\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

