"B<int pthread_attr_getscope(const pthread_attr_t *restrict >I<attr>B<,>\n"
"B<                          int *restrict >I<scope>B<);>\n"
msgstr ""
"B<int pthread_attr_setscope(pthread_attr_t *>I<attr>B<, int >I<scope>B<);>\n"
