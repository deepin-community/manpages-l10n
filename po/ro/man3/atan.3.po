msgid ""
"B<double atan(double >I<x>B<);>\n"
"B<float atanf(float >I<x>B<);>\n"
"B<long double atanl(long double >I<x>B<);>\n"
msgstr ""
"B<double atan(double >I<x>B<);>\n"
"B<float atanf(float >I<x>B<);>\n"
"B<long double atanl(long double >I<x>B<);>\n"

