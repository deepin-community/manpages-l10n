"bye(void)\n"
"{\n"
"    printf(\"Asta a fost tot, prieteni\\[rs]n\");\n"
"}\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    long a;\n"
"    int i;\n"
"\\&\n"
"    a = sysconf(_SC_ATEXIT_MAX);\n"
"    printf(\"ATEXIT_MAX = %ld\\en\", a);\n"
"\\&\n"
"    i = atexit(bye);\n"
"    if (i != 0) {\n"
"        fprintf(stderr, \"nu se poate defini funcția de ieșire\\[rs]n\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

