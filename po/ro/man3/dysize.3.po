"    Since glibc 2.19:\n"
"        _DEFAULT_SOURCE\n"
"    glibc 2.19 and earlier:\n"
"        _BSD_SOURCE || _SVID_SOURCE\n"
msgstr ""
"    Începând cu glibc 2.19:\n"
"        _DEFAULT_SOURCE\n"
"    glibc 2.19 și versiunile anterioare:\n"
