msgid ""
"B<void swab(const void >I<from>B<[restrict .>I<n>B<], void >I<to>B<[restrict .>I<n>B<],>\n"
"B<          ssize_t >I<n>B<);>\n"
msgstr ""
"B<void swab(const void >I<de-la>B<[restrict .>I<n>B<], void >I<la>B<[restrict .>I<n>B<],>\n"
"B<          ssize_t >I<n>B<);>\n"

#. type: SH
