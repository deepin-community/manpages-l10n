#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"B<double scalbn(double >I<x>B<, int >I<exp>B<);>\n"
"B<float scalbnf(float >I<x>B<, int >I<exp>B<);>\n"
"B<long double scalbnl(long double >I<x>B<, int >I<exp>B<);>\n"
msgstr ""
"B<double scalbn(double >I<x>B<, int >I<exp>B<);>\n"
"B<float scalbnf(float >I<x>B<, int >I<exp>B<);>\n"
"B<long double scalbnl(long double >I<x>B<, int >I<exp>B<);>\n"

