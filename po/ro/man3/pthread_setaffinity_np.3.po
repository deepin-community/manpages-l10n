#. type: Plain text
#: debian-bookworm
msgid ""
"These functions are nonstandard GNU extensions; hence the suffix \"_np\" "
"(nonportable) in the names."
msgstr ""
"Aceste funcții sunt extensii GNU nestandardizate; de aici și sufixul „_np” "
"(„neportabilă”) din nume."

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#define _GNU_SOURCE\n"
"#include E<lt>err.hE<gt>\n"
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
msgstr ""
"#define _GNU_SOURCE\n"
"#include E<lt>err.hE<gt>\n"
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(void)\n"
"{\n"
"    int s;\n"
"    cpu_set_t cpuset;\n"
"    pthread_t thread;\n"
msgstr ""
"int\n"
"main(void)\n"
"{\n"
"    int s;\n"
"    cpu_set_t cpuset;\n"
"    pthread_t thread;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    thread = pthread_self();\n"
msgstr "    thread = pthread_self();\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Set affinity mask to include CPUs 0 to 7. */\n"
msgstr "    /* Definește masca de afinitate pentru a include CPU de la 0 la 7. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    CPU_ZERO(&cpuset);\n"
"    for (size_t j = 0; j E<lt> 8; j++)\n"
"        CPU_SET(j, &cpuset);\n"
msgstr ""
"    CPU_ZERO(&cpuset);\n"
"    for (size_t j = 0; j E<lt> 8; j++)\n"
"        CPU_SET(j, &cpuset);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_setaffinity_np(thread, sizeof(cpuset), &cpuset);\n"
"    if (s != 0)\n"
"        errc(EXIT_FAILURE, s, \"pthread_setaffinity_np\");\n"
msgstr ""
"    s = pthread_setaffinity_np(thread, sizeof(cpuset), &cpuset);\n"
"    if (s != 0)\n"
"        errc(EXIT_FAILURE, s, \"pthread_setaffinity_np\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Check the actual affinity mask assigned to the thread. */\n"
msgstr "    /* Verifică masca de afinitate actuală atribuită firului. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_getaffinity_np(thread, sizeof(cpuset), &cpuset);\n"
"    if (s != 0)\n"
"        errc(EXIT_FAILURE, s, \"pthread_getaffinity_np\");\n"
msgstr ""
"    s = pthread_getaffinity_np(thread, sizeof(cpuset), &cpuset);\n"
"    if (s != 0)\n"
"        errc(EXIT_FAILURE, s, \"pthread_getaffinity_np\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"Set returned by pthread_getaffinity_np() contained:\\en\");\n"
"    for (size_t j = 0; j E<lt> CPU_SETSIZE; j++)\n"
"        if (CPU_ISSET(j, &cpuset))\n"
"            printf(\"    CPU %zu\\en\", j);\n"
msgstr ""
"    printf(\"Setul returnat de pthread_getaffinity_np() conține:\\en\");\n"
"    for (size_t j = 0; j E<lt> CPU_SETSIZE; j++)\n"
"        if (CPU_ISSET(j, &cpuset))\n"
"            printf(\"    CPU %zu\\en\", j);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"    exit(EXIT_SUCCESS);\n"
"}\n"

