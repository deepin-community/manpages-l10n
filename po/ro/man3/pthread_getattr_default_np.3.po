msgid ""
"pthread_getattr_default_np, pthread_setattr_default_np, - get or set default "
"thread-creation attributes"
msgstr ""
"pthread_getattr_default_np, pthread_setattr_default_np, - obține sau "
"stabilește atributele implicite de creare a firelor"

