msgid ""
"B<size_t wcsrtombs(char >I<dest>B<[restrict .>I<len>B<], const wchar_t **restrict >I<src>B<,>\n"
"B<                 size_t >I<len>B<, mbstate_t *restrict >I<ps>B<);>\n"
msgstr ""
"B<size_t wcsrtombs(char >I<dest>B<[restrict .>I<len>B<], const wchar_t **restrict >I<src>B<,>\n"
