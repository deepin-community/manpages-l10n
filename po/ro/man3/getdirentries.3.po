"B<ssize_t getdirentries(int >I<fd>B<, char >I<buf>B<[restrict .>I<nbytes>B<], size_t >I<nbytes>B<,>\n"
"B<                      off_t *restrict >I<basep>B<);>\n"
msgstr ""
