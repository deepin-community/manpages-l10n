"        res = bsearch(&key, months, ARRAY_SIZE(months),\n"
"                      sizeof(months[0]), compmi);\n"
"        if (res == NULL)\n"
"            printf(\"\\[aq]%s\\[aq]: lună necunoscută\\en\", argv[i]);\n"
"        else\n"
"            printf(\"%s: luna nr.%d\\en\", res-E<gt>name, res-E<gt>nr);\n"
"    }\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

