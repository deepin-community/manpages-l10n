"B<int fseeko(FILE *>I<stream>B<, off_t >I<offset>B<, int >I<whence>B<);>\n"
"B<off_t ftello(FILE *>I<stream>B<);>\n"
msgstr ""
"B<int fseeko(FILE *>I<flux>B<, off_t >I<poziția>B<, int >I<whence>B<);>\n"
"B<off_t ftello(FILE *>I<flux>B<);>\n"

