#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
msgstr ""
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#define handle_error_en(en, msg) \\e\n"
"        do { errno = en; perror(msg); exit(EXIT_FAILURE); } while (0)\n"
msgstr ""
"#define handle_error_en(en, msg) \\e\n"
"        do { errno = en; perror(msg); exit(EXIT_FAILURE); } while (0)\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"static void *\n"
"thread_func(void *ignored_argument)\n"
"{\n"
"    int s;\n"
msgstr ""
"static void *\n"
"thread_func(void *ignored_argument)\n"
"{\n"
"    int s;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    /* Disable cancelation for a while, so that we don\\[aq]t\n"
"       immediately react to a cancelation request. */\n"
msgstr ""
"    /* Dezactivează anularea pentru o perioadă, astfel încât\n"
"       să nu reacționăm imediat la o cerere de anulare. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_setcancelstate\");\n"
msgstr ""
"    s = pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_setcancelstate\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"%s(): started; cancelation disabled\\en\", __func__);\n"
"    sleep(5);\n"
"    printf(\"%s(): about to enable cancelation\\en\", __func__);\n"
msgstr ""
"    printf(\"%s(): pornit; anulare dezactivată\\en\", __func__);\n"
"    sleep(5);\n"
"    printf(\"%s(): privind activarea anulării\\en\", __func__);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_setcancelstate\");\n"
msgstr ""
"    s = pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_setcancelstate\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* sleep() is a cancelation point. */\n"
msgstr "    /* sleep() este un punct de anulare. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    sleep(1000);        /* Should get canceled while we sleep */\n"
msgstr "    sleep(1000);        /* Ar trebui să se anuleze în timp ce dormim */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Should never get here. */\n"
msgstr "    /* N-ar trebui să ajungă niciodată aici. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"%s(): not canceled!\\en\", __func__);\n"
"    return NULL;\n"
"}\n"
msgstr ""
"    printf(\"%s(): nu este anulat!\\en\", __func__);\n"
"    return NULL;\n"
"}\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(void)\n"
"{\n"
"    pthread_t thr;\n"
"    void *res;\n"
"    int s;\n"
msgstr ""
"int\n"
"main(void)\n"
"{\n"
"    pthread_t thr;\n"
"    void *res;\n"
"    int s;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Start a thread and then send it a cancelation request. */\n"
msgstr "    /* Începem un fir și apoi îi trimitem o cerere de anulare. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_create(&thr, NULL, &thread_func, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_create\");\n"
msgstr ""
"    s = pthread_create(&thr, NULL, &thread_func, NULL);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_create\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    sleep(2);           /* Give thread a chance to get started */\n"
msgstr "    sleep(2);           /* Dă firului o șansă de a începe */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"%s(): sending cancelation request\\en\", __func__);\n"
"    s = pthread_cancel(thr);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_cancel\");\n"
msgstr ""
"    printf(\"%s(): se trimite cererea de anulare\\en\", __func__);\n"
"    s = pthread_cancel(thr);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_cancel\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Join with thread to see what its exit status was. */\n"
msgstr "    /* Se alătură firului pentru a vedea care a fost starea sa de ieșire. */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    s = pthread_join(thr, &res);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_join\");\n"
msgstr ""
"    s = pthread_join(thr, &res);\n"
"    if (s != 0)\n"
"        handle_error_en(s, \"pthread_join\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (res == PTHREAD_CANCELED)\n"
"        printf(\"%s(): thread was canceled\\en\", __func__);\n"
"    else\n"
"        printf(\"%s(): thread wasn\\[aq]t canceled (shouldn\\[aq]t happen!)\\en\",\n"
"               __func__);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"    if (res == PTHREAD_CANCELED)\n"
"        printf(\"%s(): firul a fost anulat\\en\", __func__);\n"
"    else\n"
"        printf(\"%s(): firul nu a fost anulat (nu ar trebui să se întâmple!)\\en\",\n"
"               __func__);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

