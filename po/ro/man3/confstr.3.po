#: debian-bookworm
#, no-wrap
msgid ""
"char *pathbuf;\n"
"size_t n;\n"
msgstr ""
"char *pathbuf;\n"
"size_t n;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
