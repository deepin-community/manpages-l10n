"$ B<ls -id /tmp/rootfs>    # Inode-Anzahl des neuen Wurzelverzeichnisses zeigen\n"
"319459 /tmp/rootfs\n"
"$ B<cp $(which busybox) /tmp/rootfs>\n"
"$ B<PS1=\\[aq]bbsh$ \\[aq] sudo ./pivot_root_demo /tmp/rootfs /busybox sh>\n"
