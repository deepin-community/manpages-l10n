#: debian-bookworm
#, no-wrap
msgid ""
"                while (read(STDIN_FILENO, &buf, 1) E<gt> 0 && buf != \\[aq]\\en\\[aq])\n"
"                    continue;\n"
"                break;\n"
"            }\n"
msgstr ""
"                while (read(STDIN_FILENO, &buf, 1) E<gt> 0 && buf != \\[aq]\\en\\[aq])\n"
"                    continue;\n"
"                break;\n"
"            }\n"

#: debian-bookworm
#, no-wrap
msgid ""
"            /* Increment a byte at a time so we can see exactly\n"
"               what size buffer was required. */\n"
msgstr ""
"            /* Erhöhung um jeweils ein Byte auf einmal, so dass wir exakt\n"
"               sehen können, welche Puffergröße benötigt wurde. */\n"

#: debian-bookworm
#, no-wrap
msgid "            buflen++;\n"
msgstr "            buflen++;\n"

#: debian-bookworm
#, no-wrap
msgid ""
"            if (buflen E<gt> MAX_BUF) {\n"
"                printf(\"Exceeded buffer limit (%d)\\en\", MAX_BUF);\n"
"                exit(EXIT_FAILURE);\n"
"            }\n"
"        }\n"
"    } while (s == ERANGE);\n"
msgstr ""
"            if (buflen E<gt> MAX_BUF) {\n"
"                printf(\"Puffergrößenbeschränkung (%d) überschritten\\en\", MAX_BUF);\n"
"                exit(EXIT_FAILURE);\n"
"            }\n"
"        }\n"
"    } while (s == ERANGE);\n"

#: debian-bookworm
#, no-wrap
msgid "            if (fds[1].revents & POLLIN) {\n"
msgstr "            if (fds[1].revents & POLLIN) {\n"

#: debian-bookworm
#, no-wrap
msgid "        /* Loop over all events in the buffer. */\n"
msgstr ""

#: debian-bookworm
#, no-wrap
msgid "        /* Read some events. */\n"
msgstr "        /* Einige Ereignisse lesen. */\n"

#: debian-bookworm
#, no-wrap
msgid "        exit(EXIT_SUCCESS);\n"
msgstr "        exit(EXIT_SUCCESS);\n"

#: debian-bookworm
#, no-wrap
msgid ""
"        if (len E<lt>= 0)\n"
"            break;\n"
msgstr ""
"        if (len E<lt>= 0)\n"
"            break;\n"

#: debian-bookworm
#, no-wrap
msgid ""
"        len = read(fd, buf, sizeof(buf));\n"
"        if (len == -1 && errno != EAGAIN) {\n"
"            perror(\"read\");\n"
"            exit(EXIT_FAILURE);\n"
"        }\n"
msgstr ""
"        len = read(fd, buf, sizeof(buf));\n"
"        if (len == -1 && errno != EAGAIN) {\n"
"            perror(\"read\");\n"
"            exit(EXIT_FAILURE);\n"
"        }\n"

