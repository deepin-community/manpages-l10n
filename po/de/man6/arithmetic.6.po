msgstr "E<.Nm arithmetic>"

#. type: Nd
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "quiz on simple arithmetic"
msgstr "einfaches Rechen-Quiz"

#. type: Sh
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
