msgid "SYSTEMD-PCRLOCK"
msgstr "SYSTEMD-PCRLOCK"

#. type: TH
#: archlinux
#, no-wrap
msgid "systemd 257"
msgstr "systemd 257"

#. type: TH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
