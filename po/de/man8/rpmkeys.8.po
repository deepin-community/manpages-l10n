"\\f[B]rpmkeys\\f[R] {\\f[B]--list|--import|--delete|--checksig\\f[R]}\\fR"
msgstr ""
"\\f[B]rpmkeys\\f[R] {\\f[B]--list|--import|--delete|--checksig\\f[R]}\\fR"

