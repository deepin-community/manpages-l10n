"\\f[C]\n"
" $ rpmspec --shell\n"
" E<gt> %define foo bar\n"
" E<gt> %foo\n"
" bar\n"
" E<gt> %(date)\n"
" Tue Apr 13 03:55:37 PM EEST 2021\n"
" E<gt> %getncpus\n"
" 8\\fR\n"
"\n"
