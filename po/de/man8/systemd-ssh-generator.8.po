"B<systemd>(1), B<kernel-command-line>(7), B<systemd.system-credentials>(7), "
"B<vsock>(7), B<unix>(7), B<ssh>(1), B<sshd>(8)"
msgstr ""
"B<systemd>(1), B<kernel-command-line>(7), B<systemd.system-credentials>(7), "
