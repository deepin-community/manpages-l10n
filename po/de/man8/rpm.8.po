"\\f[B]%posttrans\\f[R], \\f[B]%preuntrans\\f[R] and \\f[B]%postuntrans\\f[R] "
"scriptlet(s).\\fR"
msgstr ""
"und deaktiviert die Ausführung der zugehörigen Scriptlets \\f[B]%pre\\f[R], "
"\\f[B]%post\\f[R], \\f[B]%preun\\f[R], \\f[B]%postun\\f[R] \\f[B]"
"%pretrans\\f[R], \\f[B]%posttrans\\f[R], \\f[B]%preuntrans\\f[R] und \\f[B]"
"%postuntrans\\f[R].\\fR"

#. type: TP
