msgid "The general form of an rpm verify command is"
msgstr ""
"Die allgemeine Form eines \\f[B]rpm\\f[R]-Überprüfungsbefehls lautet\\fR"

# FIXME "\\f[B]--excludedocs\\f[R]" → \\f[B]--excludedocs\\f[R]
