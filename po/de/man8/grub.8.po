#. type: TH
#: debian-bookworm
#, no-wrap
msgid "GRUB"
msgstr "GRUB"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "January 2022"
msgstr "Januar 2022"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "grub (GNU GRUB 0.97)"
msgstr "grub (GNU GRUB 0.97)"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "System Administration Utilities"
msgstr "Systemverwaltungswerkzeuge"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "NAME"
msgstr "BEZEICHNUNG"

#. type: Plain text
#: debian-bookworm
msgid "grub - the grub shell"
msgstr "grub - die Grub-Shell"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SYNOPSIS"
msgstr "ÜBERSICHT"

#. type: Plain text
#: debian-bookworm
msgid "B<grub> [I<\\,OPTION\\/>]..."
msgstr "B<grub> [I<\\,OPTION\\/>]…"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "DESCRIPTION"
msgstr "BESCHREIBUNG"

#. type: Plain text
#: debian-bookworm
msgid "Enter the GRand Unified Bootloader command shell."
msgstr "Startet die Befehls-Shell des »GRand-Unified-Bootloaders«."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--batch>"
msgstr "B<--batch>"

#. type: Plain text
#: debian-bookworm
msgid "turn on batch mode for non-interactive use"
msgstr ""
"aktiviert den Stapelverarbeitungs-Modus für nicht-interaktive Verwendung."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--boot-drive>=I<\\,DRIVE\\/>"
msgstr "B<--boot-drive>=I<\\,LAUFWERK\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 boot_drive [default=0x0]"
msgstr "gibt Stufe-2-Boot-Laufwerk an (Vorgabe ist 0x0)."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--config-file>=I<\\,FILE\\/>"
msgstr "B<--config-file>=I<\\,DATEI\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 config_file [default=/boot/grub/menu.lst]"
msgstr "gibt Stufe-2-Konfigurationsdatei an (Vorgabe ist /boot/grub/menu.lst)."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--device-map>=I<\\,FILE\\/>"
msgstr "B<--device-map>=I<\\,DATEI\\/>"

#. type: Plain text
#: debian-bookworm
msgid "use the device map file FILE"
msgstr "verwendet die Gerätezuordnungsdatei DATEI."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--help>"
msgstr "B<--help>"

#. type: Plain text
#: debian-bookworm
msgid "display this message and exit"
msgstr "zeigt Hilfemeldungen an und beendet das Programm."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--hold>"
msgstr "B<--hold>"

#. type: Plain text
#: debian-bookworm
msgid "wait until a debugger will attach"
msgstr "wartet auf das Anhängen eines Debuggers."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--install-partition>=I<\\,PAR\\/>"
msgstr "B<--install-partition>=I<\\,PAR\\/>"

#. type: Plain text
#: debian-bookworm
msgid "specify stage2 install_partition [default=0x20000]"
msgstr "gibt Stufe-2-Installationspartition an (Vorgabe ist 0x20000)."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-config-file>"
msgstr "B<--no-config-file>"

#. type: Plain text
#: debian-bookworm
msgid "do not use the config file"
msgstr "verwendet die Konfigurationsdatei nicht."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-curses>"
msgstr "B<--no-curses>"

#. type: Plain text
#: debian-bookworm
msgid "do not use curses"
msgstr "verwendet Curses nicht."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-floppy>"
msgstr "B<--no-floppy>"

#. type: Plain text
#: debian-bookworm
msgid "do not probe any floppy drive"
msgstr "prüft keine Diskettenlaufwerke."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--no-pager>"
msgstr "B<--no-pager>"

#. type: Plain text
#: debian-bookworm
msgid "do not use internal pager"
msgstr "verwendet das interne Textanzeigeprogramm nicht."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--preset-menu>"
msgstr "B<--preset-menu>"

#. type: Plain text
#: debian-bookworm
msgid "use the preset menu"
msgstr "verwendet das Voreinstellungsmenü."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--probe-second-floppy>"
msgstr "B<--probe-second-floppy>"

#. type: Plain text
#: debian-bookworm
msgid "probe the second floppy drive"
msgstr "prüft das zweite Diskettenlaufwerk."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--read-only>"
msgstr "B<--read-only>"

#. type: Plain text
#: debian-bookworm
msgid "do not write anything to devices"
msgstr "schreibt nichts auf die Geräte."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--verbose>"
msgstr "B<--verbose>"

#. type: Plain text
#: debian-bookworm
msgid "print verbose messages"
msgstr "gibt ausführliche Meldungen aus."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "B<--version>"
msgstr "B<--version>"

#. type: Plain text
#: debian-bookworm
msgid "print version information and exit"
msgstr "gibt Versionsinformationen aus und beendet das Programm."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "REPORTING BUGS"
msgstr "FEHLER MELDEN"

#. type: Plain text
#: debian-bookworm
msgid "Report bugs to E<lt>bug-grub@gnu.orgE<gt>."
msgstr "Melden Sie Fehler (auf Englisch) an E<.MT bug-grub@gnu.org> E<.ME .>"

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr "SIEHE AUCH"

#. type: Plain text
#: debian-bookworm
msgid "B<update-grub>(8), B<grub-install>(8)."
msgstr "B<update-grub>(8), B<grub-install>(8)."

# FIXME B<info> -> B<info>(1)
# FIXME B<grub> -> B<update-grub>?
#. type: Plain text
#: debian-bookworm
msgid ""
"The full documentation for B<grub> is maintained as a Texinfo manual.  If "
"the B<info> and B<grub> programs are properly installed at your site, the "
"command"
msgstr ""
"Die vollständige Dokumentation für B<grub> wird als ein Texinfo-Handbuch "
"gepflegt. Wenn die Programme B<info>(1) und B<grub> auf Ihrem Rechner "
"ordnungsgemäß installiert sind, können Sie mit dem Befehl"

#. type: Plain text
#: debian-bookworm
msgid "B<info grub>"
msgstr "B<info grub>"

#. type: Plain text
#: debian-bookworm
msgid ""
"should give you access to the complete manual.  You may need to install the "
"B<grub-legacy-doc> package."
msgstr ""
"auf das vollständige Handbuch zugreifen. Möglicherweise müssen Sie das Paket "
"B<grub-legacy-doc> installieren."
