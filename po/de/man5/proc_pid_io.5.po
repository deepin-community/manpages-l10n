#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "B<getrusage>(2), B<proc>(5)"
msgstr "B<getrusage>(2), B<proc>(5)"

