#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I<NFS_Unstable> %lu (since Linux 2.6.18)"
msgstr "I<NFS_Unstable> %lu (seit Linux 2.6.18)"

#. type: Plain text
