#: opensuse-tumbleweed
msgid "250-firmware-code-early\\&.pcrlock"
msgstr "250-firmware-code-early\\&.pcrlock"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-tumbleweed
