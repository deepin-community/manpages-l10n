msgstr "B<-cap-height>I<\\ n>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
msgid "height of uppercase letters such as \\[lq]A\\[rq]"
msgstr "Die Höhe von Großbuchstaben, wie beispielsweise »A«."

#. type: TP
