#: archlinux debian-unstable fedora-rawhide
#, no-wrap
msgid ""
"yes\n"
"+firmware\n"
"+driver\n"
"+system\n"
"+subsystem\n"
"+libraries\n"
"  +libtss2-esys\\&.so\\&.0\n"
"  +libtss2-rc\\&.so\\&.0\n"
"  +libtss2-mu\\&.so\\&.0\n"
msgstr ""
"yes\n"
"+firmware\n"
"+driver\n"
"+system\n"
"+subsystem\n"
"+libraries\n"
"  +libtss2-esys\\&.so\\&.0\n"
"  +libtss2-rc\\&.so\\&.0\n"
"  +libtss2-mu\\&.so\\&.0\n"

