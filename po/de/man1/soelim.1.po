#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "SOELIM"
msgstr "SOELIM"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "7 March 2023"
msgstr "7. März 2023"

#. type: TH
