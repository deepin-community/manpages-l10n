#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<pamdice>(1)  \\&, B<pamcat>(1)  \\&, B<pnmindex>(1)  \\&, B<pnmtile>(1)  "
"\\&, B<pnm>(5)  \\& B<pam>(5)  \\&"
msgstr ""
"B<pamdice>(1), B<pamcat>(1), B<pnmindex>(1), B<pnmtile>(1), B<pnm>(5), "
"B<pam>(5)"
