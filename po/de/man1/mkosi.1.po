#. type: Plain text
#: opensuse-tumbleweed
#, no-wrap
msgid ""
"\\f[B][Host]\\f[R]\n"
"QemuDrives=btrfs:10G\n"
"           ext4:20G\n"
"QemuArgs=-device nvme,serial=btrfs,drive=btrfs\n"
"         -device nvme,serial=ext4,drive=ext4\\fR\n"
msgstr ""
"\\f[B][Host]\\f[R]\n"
"QemuDrives=btrfs:10G\n"
"           ext4:20G\n"
"QemuArgs=-device nvme,serial=btrfs,drive=btrfs\n"
"         -device nvme,serial=ext4,drive=ext4\\fR\n"

