#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]MinimumVersion=\\f[R], \\f[V]--minimum-version=\\fR"
msgstr "\\f[V]MinimumVersion=\\f[R], \\f[V]--minimum-version=\\fR"

#. type: TP
#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]ConfigureScripts=\\f[R], \\f[V]--configure-script=\\fR"
