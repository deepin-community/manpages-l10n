#, no-wrap
msgid "\\f[V]Repositories=\\fR"
msgstr "\\f[V]Repositories=\\fR"

# FIXME Remove final \\fR
#. type: Plain text
#: debian-bookworm debian-unstable
msgid ""
"Matches against repositories enabled with the \\f[V]Repositories=\\f[R] "
"setting.  Takes a single repository name.\\fR"
msgstr ""
"Übereinstimmung mit Depots, die mit der Einstellung "
"\\f[V]Repositories=\\f[R] aktiviert wurden. Akzeptiert einen einzelnen "
"Depotnamen.\\fR"

#. type: tbl table
#: debian-bookworm debian-unstable
#, no-wrap
