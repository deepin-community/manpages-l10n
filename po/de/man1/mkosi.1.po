#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]&e\\fR"
msgstr "\\f[V]&e\\fR"

#. type: tbl table
#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]&k\\fR"
msgstr "\\f[V]&k\\fR"

#. type: tbl table
#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]&h\\fR"
msgstr "\\f[V]&h\\fR"

#. type: tbl table
#: debian-bookworm debian-unstable
#, no-wrap
msgid "\\f[V]roothash=\\f[R] or \\f[V]usrhash=\\f[R] value of kernel argument\\fR"
msgstr "\\f[V]roothash=\\f[R] oder \\f[V]usrhash=\\f[R] Wert des Kernelarguments\\fR"

#. type: tbl table
