#: opensuse-tumbleweed
msgid "B<time> [I<option>\\ .\\|.\\|.\\&]I< command >[I<argument>\\ .\\|.\\|.]"
msgstr "B<time> [I<Option>\\ …\\&]I< Befehl >[I<Argument>\\ …]"

