"B<                                int *restrict >I<policy>B<);>\n"
msgstr ""
"B<int pthread_attr_setschedpolicy(pthread_attr_t *>I<attr>B<, int >I<richtlinie>B<);>\n"
"B<int pthread_attr_getschedpolicy(const pthread_attr_t *restrict >I<attr>B<,>\n"
"B<                                int *restrict >I<richtlinie>B<);>\n"

