"B<int fseek(FILE *>I<stream>B<, long >I<offset>B<, int >I<whence>B<);>\n"
"B<long ftell(FILE *>I<stream>B<);>\n"
msgstr ""
"B<int fseek(FILE *>I<datenstrom>B<, long >I<Versatz>B<, int >I<woher>B<);>\n"
"B<long ftell(FILE *>I<datenstrom>B<);>\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<void rewind(FILE *>I<stream>B<);>\n"
msgstr "B<void rewind(FILE *>I<datenstrom>B<);>\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
