"B<#define _XOPEN_SOURCE>\n"
"B<#include E<lt>stdlib.hE<gt>>\n"
msgstr ""
"B<#define _XOPEN_SOURCE>\n"
"B<#include E<lt>stdlib.hE<gt>>\n"

