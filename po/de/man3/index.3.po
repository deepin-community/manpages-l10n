#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"B<[[deprecated]] char *index(const char *>I<s>B<, int >I<c>B<);>\n"
"B<[[deprecated]] char *rindex(const char *>I<s>B<, int >I<c>B<);>\n"
msgstr ""
"B<[[veraltet]] char *index(const char *>I<s>B<, int >I<c>B<);>\n"
"B<[[veraltet]] char *rindex(const char *>I<s>B<, int >I<c>B<);>\n"

