"            printf(\"\\[aq]%s\\[aq]: unbekannter Monat\\en\", argv[i]);\n"
"        else\n"
"            printf(\"%s: Monat #%d\\en\", res-E<gt>name, res-E<gt>nr);\n"
"    }\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

