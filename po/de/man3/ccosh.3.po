#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "ccosh, ccoshf, ccoshl - complex hyperbolic cosine"
msgstr "ccosh, ccoshf, ccoshl - komplexer hyperbolischer Kosinus"

