#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "asinh, asinhf, asinhl - inverse hyperbolic sine function"
msgstr "asinh, asinhf, asinhl - Areasinus Hyperbolicus-Funktion"

