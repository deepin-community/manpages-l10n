#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"B<size_t fread(void >I<ptr>B<[restrict .>I<size>B< * .>I<nmemb>B<],>\n"
"B<             size_t >I<size>B<, size_t >I<nmemb>B<,>\n"
"B<             FILE *restrict >I<stream>B<);>\n"
"B<size_t fwrite(const void >I<ptr>B<[restrict .>I<size>B< * .>I<nmemb>B<],>\n"
"B<             size_t >I<size>B<, size_t >I<nmemb>B<,>\n"
"B<             FILE *restrict >I<stream>B<);>\n"
msgstr ""
"B<size_t fread(void >I<zeiger>B<[restrict .>I<groesse>B< * .>I<nmemb>B<],>\n"
"B<             size_t >I<groesse>B<, size_t >I<nmemb>B<,>\n"
"B<             FILE *restrict >I<datenstrom>B<);>\n"
"B<size_t fwrite(const void >I<ptr>B<[restrict .>I<groesse>B< * .>I<nmemb>B<],>\n"
"B<             size_t >I<groesse>B<, size_t >I<nmemb>B<,>\n"
"B<             FILE *restrict >I<datenstrom>B<);>\n"

