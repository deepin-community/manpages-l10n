"B<void clearerr(FILE *>I<stream>B<);>\n"
"B<int feof(FILE *>I<stream>B<);>\n"
"B<int ferror(FILE *>I<stream>B<);>\n"
msgstr ""
"B<void clearerr(FILE *>I<datenstrom>B<);>\n"
"B<int feof(FILE *>I<datenstrom>B<);>\n"
"B<int ferror(FILE *>I<datenstrom>B<);>\n"

