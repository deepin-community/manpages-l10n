msgid ""
"B<size_t wcsnrtombs(char >I<dest>B<[restrict .>I<len>B<], const wchar_t **restrict >I<src>B<,>\n"
"B<                  size_t >I<nwc>B<, size_t >I<len>B<, mbstate_t *restrict >I<ps>B<);>\n"
msgstr ""
"B<size_t wcsnrtombs(char >I<Ziel>B<[restrict .>I<Länge>B<], const wchar_t **restrict >I<Quelle>B<,>\n"
"B<                  size_t >I<awz>B<, size_t >I<Länge>B<, mbstate_t *restrict >I<ps>B<);>\n"

