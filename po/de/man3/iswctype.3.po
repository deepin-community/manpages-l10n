#, no-wrap
msgid "B<int iswctype(wint_t >I<wc>B<, wctype_t >I<desc>B<);>\n"
msgstr "B<int iswctype(wint_t >I<wz>B<, wctype_t >I<besch>B<);>\n"

#. type: SH
