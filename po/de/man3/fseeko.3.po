msgid ""
"B<int fseeko(FILE *>I<stream>B<, off_t >I<offset>B<, int >I<whence>B<);>\n"
"B<off_t ftello(FILE *>I<stream>B<);>\n"
msgstr ""
"B<int fseeko(FILE *>I<Datenstrom>B<, off_t >I<Versatz>B<, int >I<woher>B<);>\n"
"B<off_t ftello(FILE *>I<Datenstrom>B<);>\n"

