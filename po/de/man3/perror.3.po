#. type: Plain text
#: debian-bookworm
msgid ""
"Since glibc 2.32, the declarations of I<sys_errlist> and I<sys_nerr> are no "
"longer exposed by I<E<lt>stdio.hE<gt>>."
msgstr ""
"Seit Glibc Version 2.32 befinden sich die Definitionen von I<sys_fehlanz> "
"und I<sys_fehllist> nicht mehr in I<E<lt>stdio.hE<gt>>."

#. type: Plain text
#: debian-bookworm
msgid "B<perror>(), I<errno>: POSIX.1-2001, POSIX.1-2008, C99, 4.3BSD."
msgstr "B<perror>(), I<fehlern>: POSIX.1-2001, POSIX.1-2008, C99, 4.3BSD."

#. type: Plain text
#: debian-bookworm
msgid ""
"The externals I<sys_nerr> and I<sys_errlist> derive from BSD, but are not "
"specified in POSIX.1."
msgstr ""
"Die externen I<sys_fehlanz> und I<sys_fehllist> leiten sich aus BSD ab, "
"werden aber nicht in POSIX.1 spezifiziert."

#. type: SH
#: debian-bookworm
#, no-wrap
