msgid ""
"while (something) {\n"
"    int ret = system(\"foo\");\n"
msgstr ""
"while (etwas) {\n"
"    int ret = system(\"foo\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (WIFSIGNALED(ret) &&\n"
"        (WTERMSIG(ret) == SIGINT || WTERMSIG(ret) == SIGQUIT))\n"
"            break;\n"
"}\n"
msgstr ""
"    if (WIFSIGNALED(ret) &&\n"
"        (WTERMSIG(ret) == SIGINT || WTERMSIG(ret) == SIGQUIT))\n"
"            break;\n"
"}\n"

