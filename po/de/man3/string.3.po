"B<char *strncat(char >I<dest>B<[restrict strlen(.>I<dest>B<) + .>I<n>B< + 1],>\n"
"B<       const char >I<src>B<[restrict .>I<n>B<],>\n"
"B<       size_t >I<n>B<);>\n"
msgstr ""
"B<char *strncat(char >I<ziel>B<[restrict strlen(.>I<ziel>B<) + .>I<n>B< + 1],>\n"
"B<       const char >I<quelle>B<[restrict .>I<n>B<],>\n"
"B<       size_t >I<n>B<);>\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
