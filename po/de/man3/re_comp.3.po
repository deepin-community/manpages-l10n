msgid ""
"B<[[deprecated]] char *re_comp(const char *>I<regex>B<);>\n"
"B<[[deprecated]] int re_exec(const char *>I<string>B<);>\n"
msgstr ""
"B<[[veraltet]] char *re_comp(const char *>I<Regulärer_Ausdruck>B<);>\n"
"B<[[veraltet]] int re_exec(const char *>I<Zeichenkette>B<);>\n"

#. type: SH
