"B<double nan(const char *>I<tagp>B<);>\n"
"B<float nanf(const char *>I<tagp>B<);>\n"
"B<long double nanl(const char *>I<tagp>B<);>\n"
msgstr ""
"B<double nan(const char *>I<tagp>B<);>\n"
"B<float nanf(const char *>I<tagp>B<);>\n"
"B<long double nanl(const char *>I<tagp>B<);>\n"

