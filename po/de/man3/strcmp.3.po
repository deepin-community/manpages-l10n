"B<int strcmp(const char *>I<s1>B<, const char *>I<s2>B<);>\n"
"B<int strncmp(const char >I<s1>B<[.>I<n>B<], const char >I<s2>B<[.>I<n>B<], size_t >I<n>B<);>\n"
msgstr ""
"B<int strcmp(const char *>I<s1>B<, const char *>I<s2>B<);>\n"
"B<int strncmp(const char >I<s1>B<[.>I<n>B<], const char >I<s2>B<[.>I<n>B<], size_t >I<n>B<);>\n"

