#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "sincos, sincosf, sincosl - calculate sin and cos simultaneously"
msgstr "sincos, sincosf, sincosl - Simultane Berechnung vom Sinus und Kosinus"

