#: archlinux debian-bookworm debian-unstable
msgid "B<info grub-macbless>"
msgstr "B<info grub-macbless>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable
msgid "should give you access to the complete manual."
msgstr "ge dig tillgång till den kompletta manualen."

