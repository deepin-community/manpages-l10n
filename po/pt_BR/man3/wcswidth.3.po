#, no-wrap
msgid "RETURN VALUE"
msgstr "VALOR DE RETORNO"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, fuzzy
#| msgid ""
#| "The B<wcswidth> function returns the number of column positions for the "
#| "wide-character string I<s>, truncated to at most length I<n>."
msgid ""
"The B<wcswidth>()  function returns the number of column positions for the "
"wide-character string I<s>, truncated to at most length I<n>."
msgstr ""
"A função B<wcswidth> retorna o número de posições de coluna para a cadeia de "
"caracteres largos I<s>, truncada para o tamanho máximo I<n>."

