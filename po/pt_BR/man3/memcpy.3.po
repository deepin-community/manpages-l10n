#| msgid ""
#| "The B<memcpy()> function copies I<n> bytes from memory area I<src> to "
#| "memory area I<dest>.  The memory areas may not overlap.  Use "
#| "B<memmove>(3) if the memory areas do overlap."
msgid ""
"The B<memcpy>()  function copies I<n> bytes from memory area I<src> to "
"memory area I<dest>.  The memory areas must not overlap.  Use B<memmove>(3)  "
"if the memory areas do overlap."
msgstr ""
"A função B<memcpy()> copia I<n> bytes da área de memória I<src> para a área "
"de memória I<dest>. As áreas de memória não podem se sobrepor. Use "
"B<memmove>(3) se as áreas de memória se sobrepõem."

