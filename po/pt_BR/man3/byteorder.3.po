#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"htonl, htons, ntohl, ntohs - convert values between host and network byte "
"order"
msgstr ""
"htonl, htons, ntohl, ntohs - muda a ordem dos bytes para a ordem do 'host' "
"ou a da rede"

