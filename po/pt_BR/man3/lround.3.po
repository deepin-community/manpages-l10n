"B<long lround(double >I<x>B<);>\n"
"B<long lroundf(float >I<x>B<);>\n"
"B<long lroundl(long double >I<x>B<);>\n"
msgstr ""
"B<long lround(double >I<x>B<);>\n"
"B<long lroundf(float >I<x>B<);>\n"
"B<long lroundl(long double >I<x>B<);>\n"

