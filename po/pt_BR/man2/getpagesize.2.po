#. type: Plain text
#. #-#-#-#-#  fedora-41: getpagesize.2.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: Plain text
#. #-#-#-#-#  fedora-rawhide: getpagesize.2.pot (PACKAGE VERSION)  #-#-#-#-#
