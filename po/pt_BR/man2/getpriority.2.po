#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<which> was not one of B<PRIO_PROCESS>, B<PRIO_PGRP>, or B<PRIO_USER>."
msgstr ""
"I<which> não era nenhum de B<PRIO_PROCESS>, B<PRIO_PGRP> ou B<PRIO_USER>."

