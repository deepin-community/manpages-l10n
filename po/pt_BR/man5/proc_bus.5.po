msgstr "NOME"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "/proc/bus/ - installed buses"
msgstr "/proc/bus/ - barramentos instalados"

#. type: SH
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIÇÃO"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/bus/>"
msgstr "I</proc/bus/>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "Contains subdirectories for installed buses."
msgstr "Contém subdiretórios para barramentos instalados."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/bus/pccard/>"
msgstr "I</proc/bus/pccard/>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Subdirectory for PCMCIA devices when B<CONFIG_PCMCIA> is set at kernel "
"compilation time."
msgstr ""
"Subdiretório para dispositivos PCMCIA quando B<CONFIG_PCMCIA> é definido no "
"momento da compilação do kernel."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/bus/pccard/drivers>"
msgstr "I</proc/bus/pccard/drivers>"

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/bus/pci/>"
msgstr "I</proc/bus/pci/>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Contains various bus subdirectories and pseudo-files containing information "
"about PCI buses, installed devices, and device drivers.  Some of these files "
"are not ASCII."
msgstr ""
"Contém vários subdiretórios de barramento e pseudoarquivos contendo "
"informações sobre barramentos PCI, dispositivos instalados e drivers de "
"dispositivos. Alguns desses arquivos não são ASCII."

#. type: TP
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "I</proc/bus/pci/devices>"
msgstr "I</proc/bus/pci/devices>"

#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Information about PCI devices.  They may be accessed through B<lspci>(8)  "
"and B<setpci>(8)."
msgstr ""
"Informações sobre dispositivos PCI. Eles podem ser acessados através de "
"B<lspci>(8) e B<setpci>(8)."

