msgstr "Recria o chroot antes de compilar."

#. type: Plain text
#: archlinux
msgid "B<-r> E<lt>dirE<gt>"
msgstr "B<-r> E<lt>dirE<gt>"

#. type: Plain text
#: archlinux
msgid "Create chroots in this directory."
msgstr "Cria chroots neste diretório."

