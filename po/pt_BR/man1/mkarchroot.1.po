#. type: SH
#: archlinux
#, no-wrap
msgid "NAME"
msgstr "NOME"

#. type: Plain text
#: archlinux
msgid ""
"mkarchroot - Creates an arch chroot in a specified location with a specified "
"set of packages"
msgstr ""
"mkarchroot - Cria um chroot de Arch em um local especificado com um conjunto "
"especificado de pacotes"

#. type: SH
#: archlinux
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSE"

#. type: Plain text
#: archlinux
msgid "mkarchroot [options] [location] [packages]"
msgstr "mkarchroot [opções] [local] [pacotes]"

#. type: SH
#: archlinux
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIÇÃO"

#. type: Plain text
#: archlinux
msgid ""
"I<mkarchroot> is a script to create an Arch Linux chroot at a specified "
"location with specified packages. Typically used by I<makechrootpkg> to "
"create build chroots. Apart from installing specified packages the chroot is "
"created with an en_US.UTF-8 and de_DE.UTF-8 locale and a generated machine-"
"id."
msgstr ""
"I<mkarchroot> é um script para criar um chroot do Arch Linux em um local "
"especificado com pacotes especificados. Normalmente usado por "
"I<makechrootpkg> para criar chroots de compilação. Além de instalar pacotes "
"especificados, o chroot é criado com uma localidade en_US.UTF-8 e de_DE."
"UTF-8 e um machine-id gerado."

#. type: SH
#: archlinux
#, no-wrap
msgid "OPTIONS"
msgstr "OPÇÕES"

#. type: Plain text
#: archlinux
msgid "B<-U>"
msgstr "B<-U>"

#. type: Plain text
#: archlinux
msgid "Use I<pacman -U> to install packages."
msgstr "Usa I<pacman -U> para instalar pacotes."

#. type: Plain text
#: archlinux
msgid "B<-C> E<lt>fileE<gt>"
msgstr "B<-C> E<lt>arquivoE<gt>"

#. type: Plain text
#: archlinux
msgid "Location of a pacman config file."
msgstr "Local de um arquivo de configuração do pacman."

#. type: Plain text
#: archlinux
msgid "B<-M> E<lt>fileE<gt>"
msgstr "B<-M> E<lt>arquivoE<gt>"

#. type: Plain text
#: archlinux
msgid "Location of a makepkg config file."
msgstr "Local de um arquivo de configuração do makepkg."

#. type: Plain text
#: archlinux
msgid "B<-c> E<lt>dirE<gt>"
msgstr "B<-c> E<lt>dirE<gt>"

#. type: Plain text
#: archlinux
msgid "Set pacman cache."
msgstr "Define o cache do pacman."

#. type: Plain text
#: archlinux
msgid "B<-f> E<lt>srcE<gt>[:E<lt>dstE<gt>]"
msgstr "B<-f> E<lt>srcE<gt>[:E<lt>dstE<gt>]"

#. type: Plain text
#: archlinux
msgid ""
"Copy file from the host to the chroot.  If I<dst> is not provided, it "
"defaults to I<src> inside of the chroot."
msgstr ""
"Copia o arquivo do host para o chroot. Se I<dst> não for fornecido, o padrão "
"será I<src> dentro do chroot."

#. type: Plain text
#: archlinux
msgid "B<-s>"
msgstr "B<-s>"

#. type: Plain text
#: archlinux
msgid "Do not run setarch."
msgstr "Não executa setarch"

#. type: Plain text
#: archlinux
msgid "B<-h>"
msgstr "B<-h>"

#. type: Plain text
#: archlinux
msgid "Output command line options."
msgstr "Emite as opções da linha de comando."

#. type: SH
#: archlinux
#, no-wrap
msgid "SEE ALSO"
msgstr "VEJA TAMBÉM"

#. type: Plain text
#: archlinux
msgid "pacman(1)"
msgstr "pacman(1)"

