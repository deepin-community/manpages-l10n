#. type: TH
#: archlinux
#, no-wrap
msgid "PKGCTL"
msgstr "PKGCTL"

#. type: TH
#: archlinux
#, no-wrap
msgid "2024-06-18"
msgstr "18 junho 2024"

#. type: TH
#: archlinux
#, no-wrap
msgid "\\ \" "
msgstr "\\ \" "

#. type: TH
