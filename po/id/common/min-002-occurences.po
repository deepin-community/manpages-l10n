#, no-wrap
msgid ""
"\\&B<perl> [\\ B<-sTtuUWX>\\ ]\n"
"        [\\ B<-hv>\\ ]\\ [\\ B<-V>[:I<configvar>]\\ ]\n"
"        [\\ B<-cw>\\ ]\\ [\\ B<-d>[B<t>][:I<debugger>]\\ ]\\ [\\ B<-D>[I<number/list>]\\ ]\n"
"        [\\ B<-pna>\\ ]\\ [\\ B<-F>I<pattern>\\ ]\\ [\\ B<-l>[I<octal>]\\ ]\\ [\\ B<-0>[I<octal/hexadecimal>]\\ ]\n"
"        [\\ B<-I>I<dir>\\ ]\\ [\\ B<-m>[B<->]I<module>\\ ]\\ [\\ B<-M>[B<->]I<'module...'>\\ ]\\ [\\ B<-f>\\ ]\n"
"        [\\ B<-C\\ [>\\f(BInumber/listB<]\\ >]\n"
"        [\\ B<-S>\\ ]\n"
"        [\\ B<-x>[I<dir>]\\ ]\n"
"        [\\ B<-i>[I<extension>]\\ ]\n"
