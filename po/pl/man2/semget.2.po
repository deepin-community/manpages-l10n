"        perror(\"semget\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    printf(\"ID = %d\\[rs]n\", semid);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
