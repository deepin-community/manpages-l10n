"    }\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    uid = strtol(argv[1], &endptr, 10);  /* Allow a numeric string */\n"
msgstr "    uid = strtol(argv[1], &endptr, 10);  /* Akceptuje łańcuch numeryczny */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
