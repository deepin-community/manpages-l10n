"B<fchmod>():\n"
"    Od glibc 2.24:\n"
"        _POSIX_C_SOURCE E<gt>= 199309L\n"
"    glibc 2.19 do glibc 2.23\n"
"        _POSIX_C_SOURCE\n"
"    glibc 2.16 do glibc 2.19:\n"
"        _BSD_SOURCE || _POSIX_C_SOURCE\n"
