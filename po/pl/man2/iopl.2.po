#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<ioperm>(2), B<outb>(2), B<capabilities>(7)"
msgstr "B<ioperm>(2), B<outb>(2), B<capabilities>(7)"

