msgid ""
"This function is a nonstandard GNU extension; hence the suffix "
"\"_np\" (nonportable) in the name."
msgstr ""

#: debian-bookworm
msgid "This function is available since glibc 2.2."
msgstr "Funkcja jest dostępna od glibc 2.2."

