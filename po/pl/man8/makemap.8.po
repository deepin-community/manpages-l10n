#. type: Sh
#. #-#-#-#-#  debian-bookworm: makemap.8.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: SH
#. #-#-#-#-#  debian-unstable: makemap.8.pot (PACKAGE VERSION)  #-#-#-#-#
