"E<.Xr aliases 5>, E<.Xr smtpd.conf 5>, E<.Xr table 5>, E<.Xr newaliases 8>, "
"E<.Xr smtpd 8>"
msgstr ""
"E<.Xr aliases 5>, E<.Xr smtpd.conf 5>, E<.Xr table 5>, E<.Xr newaliases 8>, "
"E<.Xr smtpd 8>"

