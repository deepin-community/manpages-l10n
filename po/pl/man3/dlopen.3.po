msgid ""
"B<void *dlopen(const char *>I<filename>B<, int >I<flags>B<);>\n"
"B<int dlclose(void *>I<handle>B<);>\n"
msgstr ""
"B<void *dlopen(const char *>I<filename>B<, int >I<flags>B<);>\n"
