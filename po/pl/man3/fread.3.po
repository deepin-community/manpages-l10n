"B<size_t fwrite(const void >I<ptr>B<[restrict .>I<size>B< * .>I<nmemb>B<],>\n"
"B<             size_t >I<size>B<, size_t >I<nmemb>B<,>\n"
"B<             FILE *restrict >I<stream>B<);>\n"
msgstr ""
"B<size_t fread(void >I<ptr>B<[restrict .>I<size>B< * .>I<nmemb>B<],>\n"
