"           buffer[2], buffer[3]);\n"
"\\&\n"
"    ret = fread(buffer, 1, 1, fp);\n"
"    if (ret != 1) {\n"
"        fprintf(stderr, \"fread() zawiodło: %zu\\en\", ret);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    printf(\"Klasa: %#04x\\en\", buffer[0]);\n"
"\\&\n"
"    fclose(fp);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

