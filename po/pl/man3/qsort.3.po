"}\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    if (argc E<lt> 2) {\n"
"        fprintf(stderr, \"Użycie: %s E<lt>łańcuchE<gt>...\\en\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    qsort(&argv[1], argc - 1, sizeof(char *), cmpstringp);\n"
"\\&\n"
"    for (size_t j = 1; j E<lt> argc; j++)\n"
"        puts(argv[j]);\n"
