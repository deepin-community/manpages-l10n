"B<int abs(int >I<j>B<);>\n"
"B<long labs(long >I<j>B<);>\n"
"B<long long llabs(long long >I<j>B<);>\n"
msgstr ""
"B<int abs(int >I<j>B<);>\n"
"B<long labs(long >I<j>B<);>\n"
"B<long long llabs(long long >I<j>B<);>\n"

