msgstr "B<#include E<lt>curses.hE<gt>>"

#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"This option is used to avoid file name conflicts between I<\\%ncurses> and "
"an existing I<curses> installation on the system.  If I<\\%ncurses> is "
"installed disabling overwrite, it puts its header files in a subdirectory.  "
"Here is an example."
msgstr ""

#.  The dummy character prevents undesired rewriting of the next line on
#.  installation of the man page.
#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron
#, fuzzy, no-wrap
#| msgid "B<#include E<lt>ncurses/curses.hE<gt>>"
msgid "B<#\\&include E<lt>ncurses/curses.hE<gt>>\n"
msgstr "B<#include E<lt>ncurses/curses.hE<gt>>"

#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"Installation also omits a symbolic link that would cause the compiler's B<-"
"lcurses> option to link object files with I<\\%ncurses> instead of the "
"system I<curses> library."
msgstr ""

#. type: Plain text
#: fedora-41 fedora-rawhide mageia-cauldron
msgid ""
"The directory used by this configuration of I<\\%ncurses> is shown in "
"section \\*(``SYNOPSIS\\*('' above."
msgstr ""

#. type: TP
#: fedora-41 fedora-rawhide mageia-cauldron
#, fuzzy, no-wrap
