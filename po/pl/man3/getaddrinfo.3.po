msgstr ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int                      sfd, s;\n"
"    char                     buf[BUF_SIZE];\n"
"    ssize_t                  nread;\n"
"    socklen_t                peer_addrlen;\n"
"    struct addrinfo          hints;\n"
"    struct addrinfo          *result, *rp;\n"
