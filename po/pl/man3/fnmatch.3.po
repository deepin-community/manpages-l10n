#. type: TQ
#. #-#-#-#-#  debian-bookworm: fnmatch.3.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: TP
#. #-#-#-#-#  debian-unstable: fnmatch.3.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: TQ
#. #-#-#-#-#  fedora-41: fnmatch.3.pot (PACKAGE VERSION)  #-#-#-#-#
