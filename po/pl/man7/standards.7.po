"B<getconf>(1), B<confstr>(3), B<pathconf>(3), B<sysconf>(3), "
"B<attributes>(7), B<feature_test_macros>(7), B<libc>(7), B<posixoptions>(7), "
"B<system_data_types>(7)"
msgstr ""
