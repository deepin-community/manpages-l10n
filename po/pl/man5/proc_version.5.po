msgid "Linux version 1.0.9 (quinlan@phaze) #1 Sat May 14 01:51:54 EDT 1994\n"
msgstr "Linux version 1.0.9 (quinlan@phaze) #1 Sat May 14 01:51:54 EDT 1994\n"

