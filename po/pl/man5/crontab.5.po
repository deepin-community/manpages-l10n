#: debian-unstable
#, no-wrap
msgid "@reboot"
msgstr "@reboot"

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "Run once, at startup\\&."
msgstr "Uruchamiany raz, przy rozruchu\\&."

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "@yearly"
msgstr "@yearly"

