#: debian-unstable
#, no-wrap
msgid "minute"
msgstr "minuta"

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "0-59"
msgstr "0-59"

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "hour"
msgstr "godzina"

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "0-23"
msgstr "0-23"

#. type: tbl table
#: debian-unstable
#, no-wrap
msgid "day of month"
msgstr "dzień miesiąca"

