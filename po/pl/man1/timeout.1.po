msgid "TIMEOUT"
msgstr "CZAS OCZEKIWANIA"

#. type: TH
#: archlinux
#, no-wrap
msgid "August 2024"
msgstr "sierpień 2024"

#. type: TH
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "GNU coreutils 9.5"
msgstr "GNU coreutils 9.5"

#. type: TH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "User Commands"
msgstr "Polecenia użytkownika"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "NAME"
msgstr "NAZWA"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "timeout - run a command with a time limit"
msgstr "timeout - uruchamia polecenie z limitem czasu"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr "SKŁADNIA"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<timeout> [I<\\,OPTION\\/>] I<\\,DURATION COMMAND \\/>[I<\\,ARG\\/>]..."
msgstr "B<timeout> [I<OPCJA>] I<CZAS-TRWANIA POLECENIE >[I<ARGUMENTY>]..."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<timeout> [I<\\,OPTION\\/>]"
msgstr "B<timeout> [I<OPCJA>]"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "OPIS"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Start COMMAND, and kill it if still running after DURATION."
msgstr ""
"Uruchamia I<POLECENIE> i zabija je, jeśli jest wciąż aktywne po danym "
"I<CZASIE-TRWANIA>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Mandatory arguments to long options are mandatory for short options too."
msgstr ""
"Argumenty, które są obowiązkowe dla długich opcji, są również obowiązkowe "
"dla krótkich."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<--preserve-status>"
msgstr "B<--preserve-status>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "exit with the same status as COMMAND, even when the"
msgstr "wychodzi z tym samym kodem zakończenia co I<POLECENIE>, nawet jeśli"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "command times out"
msgstr "polecenie się przeterminowało"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<--foreground>"
msgstr "B<--foreground>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "when not running timeout directly from a shell prompt,"
msgstr ""
"Jeśli polecenie B<timeout> nie jest uruchomione bezpośrednio w powłoce "
"interaktywnej,"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"allow COMMAND to read from the TTY and get TTY signals; in this mode, "
"children of COMMAND will not be timed out"
msgstr ""
"pozwala I<POLECENIU> czytać z TTY i otrzymywać sygnały TTY. W tym trybie, "
"procesy potomne I<POLECENIA> nie podlegają ograniczeniu czasu."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<-k>, B<--kill-after>=I<\\,DURATION\\/>"
msgstr "B<-k>, B<--kill-after>=I<CZAS-TRWANIA>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "also send a KILL signal if COMMAND is still running"
msgstr "wysyła także sygnał B<KILL>, jeśli I<POLECENIE> wciąż działa"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "this long after the initial signal was sent"
msgstr "po wysłaniu pierwszego sygnału"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<-s>, B<--signal>=I<\\,SIGNAL\\/>"
msgstr "B<-s>, B<--signal>=I<SYGNAŁ>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "specify the signal to be sent on timeout;"
msgstr "określa sygnał wysłany po I<CZASIE-TRWANIA>;"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"SIGNAL may be a name like 'HUP' or a number; see 'kill B<-l>' for a list of "
"signals"
msgstr ""
"I<SYGNAŁ> może być nazwą (np. B<HUP>) lub numerem. Listę sygnałów można "
"otrzymać wykonując polecenie B<kill -l>"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-v>, B<--verbose>"
msgstr "B<-v>, B<--verbose>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "diagnose to stderr any signal sent upon timeout"
msgstr ""
"diagnozuje na standardowe wyjście błędów każdy sygnał wysłany po I<CZASIE-"
"TRWANIA>"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<--help>"
msgstr "B<--help>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "display this help and exit"
msgstr "wyświetla ten tekst i kończy pracę"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<--version>"
msgstr "B<--version>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "output version information and exit"
msgstr "wyświetla informacje o wersji i kończy działanie"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"DURATION is a floating point number with an optional suffix: \\&'s' for "
"seconds (the default), 'm' for minutes, 'h' for hours or 'd' for days.  A "
"duration of 0 disables the associated timeout."
msgstr ""
"I<CZAS-TRWANIA> jest liczbą zmiennoprzecinkową z opcjonalnym przyrostkiem: "
"B<s> - sekundy (domyślnie), B<m> - minuty, B<h> - godziny lub B<d> - dni. "
"I<CZAS-TRWANIA> równy 0 wyłącza powiązany limit czasu."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Upon timeout, send the TERM signal to COMMAND, if no other SIGNAL "
"specified.  The TERM signal kills any process that does not block or catch "
"that signal.  It may be necessary to use the KILL signal, since this signal "
"can't be caught."
msgstr ""
"Po minięciu limitu czasu, wysyła sygnał B<TERM> do I<POLECENIA>, jeśli nie "
"określono innego sygnału. B<TERM> zabija te procesy, które nie blokują go "
"ani nie przechwytują. Może być konieczne również użycie sygnału B<KILL>, "
"ponieważ nie może on zostać przechwycony."

#. type: SS
#: archlinux debian-unstable fedora-41 fedora-rawhide mageia-cauldron
#: opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "Exit status:"
msgstr "Status zakończenia:"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "124"
msgstr "124"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "if COMMAND times out, and B<--preserve-status> is not specified"
msgstr ""
"jeśli I<POLECENIE> się przeterminowało i nie podano B<--preserve-status>"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "125"
msgstr "125"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "if the timeout command itself fails"
msgstr "jeśli samo polecenie timeout zawiedzie"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "126"
msgstr "126"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "if COMMAND is found but cannot be invoked"
msgstr "jeśli odnaleziono I<POLECENIE>, ale nie można go wywołać"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "127"
msgstr "127"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "if COMMAND cannot be found"
msgstr "jeśli nie znaleziono I<POLECENIA>"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "137"
msgstr "137"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "if COMMAND (or timeout itself) is sent the KILL (9) signal (128+9)"
msgstr ""
"jeśli do I<POLECENIA> (lub samego timeout) wysłany jest sygnał B<KILL> "
"(B<9>) (128+9)"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "-"
msgstr "-"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "the exit status of COMMAND otherwise"
msgstr "w pozostałych przypadkach jest to kod zakończenia I<POLECENIA>"

