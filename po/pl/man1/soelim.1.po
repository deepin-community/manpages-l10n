#. type: SH
#: archlinux debian-unstable opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "See also"
msgstr "Zobacz także"

#. type: Plain text
#: archlinux debian-unstable opensuse-leap-16-0 opensuse-tumbleweed
msgid "E<.MR groff 1>"
msgstr "E<.MR groff 1>"

