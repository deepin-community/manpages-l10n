msgstr "groff 1.22.4"

#. type: SH
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "NAME"
msgstr "NAZWA"

#. type: Plain text
#: debian-bookworm mageia-cauldron
msgid "soelim - interpret .so requests in groff input"
msgstr "soelim - interpretuje zapytania .so w wejściu groff"

#.  ====================================================================
#. type: SH
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "SYNOPSIS"
msgstr "SKŁADNIA"

#. type: SY
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "soelim"
msgstr "soelim"

#. type: OP
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "-Crtv"
msgstr "-Crtv"

#. type: OP
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "-I"
msgstr "-I"

#. type: OP
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "dir"
msgstr "dir"

