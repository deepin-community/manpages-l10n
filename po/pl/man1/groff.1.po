msgstr "Jest zawsze uruchamiany przed jakimkolwiek innym preprocesorem."

#. type: Plain text
#: debian-bookworm mageia-cauldron
msgid ""
"Please refer to B<preconv>'s manual page for its behaviour if no B<-K> (or "
"B<-D>)  option is specified."
msgstr ""
"Domyślne zachowanie, jeśli nie podano opcji B<-K> (ani B<-D>) opisano na "
"stronie podręcznika B<preconv>."

#. type: TP
#: debian-bookworm mageia-cauldron
#, no-wrap
msgid "B<-K\\ >I<arg>"
msgstr "B<-K\\ >I<arg>"

#. type: Plain text
#: debian-bookworm mageia-cauldron
msgid "Set input encoding used by B<preconv> to I<arg>."
msgstr "Ustawia na I<arg> kodowanie wejściowe używane przez B<preconv>."

#. type: Plain text
#: debian-bookworm mageia-cauldron
#, fuzzy
#| msgid ""
#| "The postprocessor to be used for a device is specified by the B<postpro> "
#| "command in the device description file; see B<\\%groff_font>(5)."
