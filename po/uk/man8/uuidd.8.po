#: debian-bookworm
#, no-wrap
msgid "AUTHOR"
msgstr "АВТОР"

#. type: Plain text
#: debian-bookworm
msgid "The B<uuidd> daemon was written by"
msgstr "Фонову службу B<uuidd> було написано"

