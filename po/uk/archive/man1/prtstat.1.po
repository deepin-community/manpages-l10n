#, no-wrap
msgid "PRTSTAT"
msgstr "PRTSTAT"

#. type: TH
#: opensuse-leap-16-0
#, no-wrap
msgid "2020-09-09"
msgstr "9 вересня 2020 року"

#. type: TH
#: opensuse-leap-16-0
#, no-wrap
msgid "psmisc"
msgstr "psmisc"

#. type: TH
#: opensuse-leap-16-0
#, no-wrap
msgid "User Commands"
msgstr "Команди користувача"

#. type: SH
#: opensuse-leap-16-0
#, no-wrap
msgid "NAME"
msgstr "НАЗВА"

#. type: Plain text
#: opensuse-leap-16-0
msgid "prtstat - print statistics of a process"
msgstr "prtstat - виводить статистику процесу"

#. type: SH
#: opensuse-leap-16-0
#, no-wrap
msgid "SYNOPSIS"
msgstr "КОРОТКИЙ ОПИС"

#. type: Plain text
#: opensuse-leap-16-0
msgid "B<prtstat> [B<-r>|B<--raw>] I<pid>"
msgstr "B<prtstat> [B<-r>|B<--raw>] I<pid>"

#. type: Plain text
#: opensuse-leap-16-0
#, fuzzy
#| msgid "B<prtstat> -VB<|>--version"
msgid "B<prtstat> B<-V>|B<--version>"
msgstr "B<prtstat> -VB<|>--version"

#. type: SH
#: opensuse-leap-16-0
#, no-wrap
msgid "DESCRIPTION"
msgstr "ОПИС"

#. type: Plain text
#: opensuse-leap-16-0
#, fuzzy
#| msgid ""
#| "B<prtstat> prints the statistics of the specified process.  This "
#| "information comes from the I</proc/PID/stat> file."
msgid ""
"B<prtstat> prints the statistics of the specified process.  This information "
"comes from the B</proc/>I<pid>B</stat> file."
msgstr ""
"B<prtstat> виводить статистику визначеного процесу. Дані беруться з файлу I</"
"proc/PID/stat>."

#. type: SH
#: opensuse-leap-16-0
#, no-wrap
msgid "OPTIONS"
msgstr "ПАРАМЕТРИ"

#. type: TP
#: opensuse-leap-16-0
#, no-wrap
msgid "B<-r>,B<\\ --raw>"
msgstr "B<-r>,B<\\ --raw>"

#. type: Plain text
#: opensuse-leap-16-0
msgid "Print the information in raw format."
msgstr "Вивести інформацію у raw-форматі."

#. type: TP
#: opensuse-leap-16-0
#, no-wrap
msgid "B<-V>,B<\\ --version>"
msgstr "B<-V>,B<\\ --version>"

#. type: Plain text
#: opensuse-leap-16-0
msgid "Show the version information for B<prtstat>."
msgstr "Показати інформацію про версію B<prtstat>."

#. type: SH
#: opensuse-leap-16-0
#, no-wrap
msgid "FILES"
msgstr "ФАЙЛИ"

#. type: TP
#: opensuse-leap-16-0
#, fuzzy, no-wrap
#| msgid "/proc/E<lt>PIDE<gt>/stat"
msgid "B</proc/>I<pid>B</stat>"
msgstr "/proc/E<lt>PIDE<gt>/stat"

#. type: Plain text
#: opensuse-leap-16-0
#, fuzzy
#| msgid "source of the information B<prtstat> uses"
msgid "source of the information B<prtstat> uses."
msgstr "джерело інформації, яке використовує B<prtstat>"
