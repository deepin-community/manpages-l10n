msgid "B<time_t time(time_t *_Nullable >I<tloc>B<);>\n"
msgstr "B<time_t time(time_t Null_baar*_>I<tloc>B<);>\n"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
