#, no-wrap
msgid "    printf(\"I-node number:            %ju\\en\", (uintmax_t) sb.st_ino);\n"
msgstr "    printf(\"I-node number:            %ju\\en\", (uintmax_t) sb.st_ino);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
