msgstr "B<-e>I<koodaustiedosto>"

#. type: Plain text
#: debian-bookworm
msgid "The format of I<enc-file> is described in I<grops>(1)."
msgstr "I<Koodaustiedoston> muoto on selvitetty B<grops>(1):ssa."

#. type: TP
