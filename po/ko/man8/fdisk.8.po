#. type: TH
#: debian-bookworm
#, no-wrap
msgid "FDISK"
msgstr "FDISK"

#. type: TH
#: debian-bookworm
#, no-wrap
msgid "2022-05-11"
msgstr "2022년 5월 11일"

#. type: TH
#: debian-bookworm
