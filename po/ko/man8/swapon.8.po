#: debian-bookworm
#, no-wrap
msgid "HISTORY"
msgstr "이력"

#. type: Plain text
#: debian-bookworm
msgid "The B<swapon> command appeared in 4.0BSD."
msgstr "B<swapon> 명령은 4.0BSD에서 생겼다."

