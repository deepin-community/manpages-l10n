#. type: Plain text
#: mageia-cauldron
msgid ""
"Set another pathname and filename for the configuration file. The default "
"configuration file is I</etc/lilo.conf>."
msgstr ""

#. type: IP
#: mageia-cauldron
#, fuzzy, no-wrap
