#: mageia-cauldron
msgid ""
"Generate 'cylinder/head/sector' (\\s-1CHS\\s0 geometric) disk addresses. "
"Limited to cylinders up to 1023. Forces compatibility with very old versions "
"of \\s-1LILO \\s0I<(obsolete switch)>."
msgstr ""

