#. type: Plain text
#: debian-bookworm
msgid "Display help text and exit."
msgstr "도움말을 보여주고 마친다."

#. type: Plain text
#: debian-bookworm
msgid "B<-V>, B<--version>"
msgstr "B<-V>, B<--version>"

#. type: Plain text
#: debian-bookworm
msgid "Print version and exit."
msgstr "버전 정보를 보여주고 마친다."

#. type: SH
#: debian-bookworm
#, no-wrap
msgid "FILES"
msgstr "파일"

#. type: Plain text
