#: debian-bookworm
#, no-wrap
msgid "VERSIONS"
msgstr "버전S"

#. type: Plain text
#: debian-bookworm
msgid ""
"B<unlinkat>()  was added in Linux 2.6.16; library support was added in glibc "
"2.4."
msgstr ""

