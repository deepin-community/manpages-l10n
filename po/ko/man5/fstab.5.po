#: debian-bookworm
#, no-wrap
msgid "HISTORY"
msgstr "이력"

#. type: Plain text
#: debian-bookworm
#, fuzzy
#| msgid "The B<fstab> file format appeared in 4.0BSD."
msgid "The ancestor of this B<fstab> file format appeared in 4.0BSD."
msgstr "B<fstab> 형식은 4.0BSD에서 생겼다."

