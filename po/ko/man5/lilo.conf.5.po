"    menu-scheme=wr:bw:wr:Yr    the LILO default\n"
"    menu-scheme=Yk:kw    bright yellow on black\n"
msgstr ""

#. type: Plain text
#: mageia-cauldron
msgid ""
"If I<menu> is not installed as the boot loader, then this line has no effect."
msgstr ""

#. type: TP
#: mageia-cauldron
#, fuzzy, no-wrap
#| msgid "B<message=>I<message-file>"
