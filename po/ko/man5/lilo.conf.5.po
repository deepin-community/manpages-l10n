msgstr "B<message=>I<message-file>"

#. type: Plain text
#: mageia-cauldron
#, fuzzy
#| msgid ""
#| "specifies a file containing a message that is displayed before the boot "
#| "prompt. No message is displayed while waiting for a shifting key after "
