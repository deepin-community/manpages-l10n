"       disk=/dev/loop0\n"
"            bios=0x80\t\t\t# use this BIOS code\n"
"            max-partitions=7\t\t# declare partitionable\n"
"            paritition=/dev/loop1\n"
"                 start=63\t\t# offset from sector 0\n"
"            paritition=/dev/loop2\n"
"                 start=102400\t\t# offset from sector 0\n"
msgstr ""

#. type: TP
#: mageia-cauldron
#, fuzzy, no-wrap
