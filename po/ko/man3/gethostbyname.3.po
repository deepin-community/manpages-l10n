#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, fuzzy, no-wrap
#| msgid ""
#| "struct hostent {\n"
#| "\tchar\t*h_name;\t\t/* official name of host */\n"
#| "\tchar\t**h_aliases;\t\t/* alias list */\n"
#| "\tint\th_addrtype;\t\t/* host address type */\n"
#| "\tint\th_length;\t\t/* length of address */\n"
