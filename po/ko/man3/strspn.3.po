"B<size_t strspn(const char *>I<s>B<, const char *>I<accept>B<);>\n"
"B<size_t strcspn(const char *>I<s>B<, const char *>I<reject>B<);>\n"
msgstr ""
"B<size_t strspn(const char *>I<s>B<, const char *>I<accept>B<);>\n"
