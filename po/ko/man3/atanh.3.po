#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"B<double atanh(double >I<x>B<);>\n"
"B<float atanhf(float >I<x>B<);>\n"
"B<long double atanhl(long double >I<x>B<);>\n"
msgstr ""
"B<double atanh(double >I<x>B<);>\n"
"B<float atanhf(float >I<x>B<);>\n"
"B<long double atanhl(long double >I<x>B<);>\n"

