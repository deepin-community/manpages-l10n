msgid ""
"B<int sigemptyset(sigset_t *>I<set>B<);>\n"
"B<int sigfillset(sigset_t *>I<set>B<);>\n"
msgstr ""
"B<int sigemptyset(sigset_t *>I<set>B<);>\n"
"B<int sigfillset(sigset_t *>I<set>B<);>\n"

