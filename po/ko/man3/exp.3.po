#, no-wrap
msgid ""
"B<double exp(double >I<x>B<);>\n"
"B<float expf(float >I<x>B<);>\n"
"B<long double expl(long double >I<x>B<);>\n"
msgstr ""
"B<double exp(double >I<x>B<);>\n"
"B<float expf(float >I<x>B<);>\n"
"B<long double expl(long double >I<x>B<);>\n"

