#| msgid "B<Ram> is a block device to access the ram disk in raw mode."
msgid "The I<ram> device is a block device to access the ram disk in raw mode."
msgstr "B<Ram> 는 램디스크에 액세스하기위한 블록장치이다."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "It is typically created by:"
msgstr "다음에 의해 생성된다:"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"mknod -m 660 /dev/ram b 1 1\n"
"chown root:disk /dev/ram\n"
msgstr ""
"mknod -m 660 /dev/ram b 1 1\n"
"chown root:disk /dev/ram\n"

