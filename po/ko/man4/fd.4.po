#. type: TP
#. #-#-#-#-#  fedora-rawhide: fd.4.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: TP
#. #-#-#-#-#  opensuse-leap-16-0: fd.4.pot (PACKAGE VERSION)  #-#-#-#-#
#. type: TP
