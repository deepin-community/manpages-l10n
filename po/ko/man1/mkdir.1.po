#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "or available locally via: info \\(aq(coreutils) mkdir invocation\\(aq"
msgstr "또는 로컬 문서: info \\(aq(coreutils) mkdir invocation\\(aq"

