#: debian-bookworm
#, no-wrap
msgid "SEE ALSO"
msgstr "추가 참조"

#. type: Plain text
#: debian-bookworm
msgid ""
"B<csh>(1) (for the I<history> mechanism), B<scriptreplay>(1), "
"B<scriptlive>(1)"
msgstr ""

