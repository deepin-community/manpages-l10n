msgstr "B<백스페이스>"

#. type: Plain text
#: debian-bookworm
msgid "moves back one column (8); ignored in the first column"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "B<newline>"
msgstr "B<개행문자>"

#. type: Plain text
#: debian-bookworm
msgid "forward line feed (10); also does carriage return"
msgstr ""

#. type: Plain text
#: debian-bookworm
msgid "B<carriage return>"
msgstr "B<캐리지 리턴>"

#. type: Plain text
#: debian-bookworm
msgid "(13)"
