"        _POSIX_C_SOURCE\n"
"    glibc 2.16 to glibc 2.19:\n"
"        _BSD_SOURCE || _POSIX_C_SOURCE\n"
"    glibc 2.12 to glibc 2.16:\n"
"        _BSD_SOURCE || _XOPEN_SOURCE E<gt>= 500\n"
"            || _POSIX_C_SOURCE E<gt>= 200809L\n"
"    glibc 2.11 and earlier:\n"
"        _BSD_SOURCE || _XOPEN_SOURCE E<gt>= 500\n"
