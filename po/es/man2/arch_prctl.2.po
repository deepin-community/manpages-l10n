"B<int syscall(SYS_arch_prctl, int >I<op>B<, unsigned long >I<addr>B<);>\n"
"B<int syscall(SYS_arch_prctl, int >I<op>B<, unsigned long *>I<addr>B<);>\n"
msgstr ""
"B<int syscall(SYS_arch_prctl, int >I<code>B<, unsigned long >I<addr>B<);>\n"
