msgid ""
"#define MY_SOCK_PATH \"/somepath\"\n"
"#define LISTEN_BACKLOG 50\n"
msgstr ""
"#define MY_SOCK_PATH \"/unaruta\"\n"
"#define LISTEN_BACKLOG 50\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#define handle_error(msg) \\e\n"
"    do { perror(msg); exit(EXIT_FAILURE); } while (0)\n"
msgstr ""
"#define handle_error(msg) \\e\n"
"    do { perror(msg); exit(EXIT_FAILURE); } while (0)\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(void)\n"
"{\n"
"    int                 sfd, cfd;\n"
"    socklen_t           peer_addr_size;\n"
"    struct sockaddr_un  my_addr, peer_addr;\n"
msgstr ""
"int\n"
"main(void)\n"
"{\n"
"    int                 sfd, cfd;\n"
"    socklen_t           peer_addr_size;\n"
"    struct sockaddr_un  my_addr, peer_addr;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    sfd = socket(AF_UNIX, SOCK_STREAM, 0);\n"
"    if (sfd == -1)\n"
"        handle_error(\"socket\");\n"
msgstr ""
"    sfd = socket(AF_UNIX, SOCK_STREAM, 0);\n"
"    if (sfd == -1)\n"
"        handle_error(\"socket\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    memset(&my_addr, 0, sizeof(my_addr));\n"
"    my_addr.sun_family = AF_UNIX;\n"
"    strncpy(my_addr.sun_path, MY_SOCK_PATH,\n"
"            sizeof(my_addr.sun_path) - 1);\n"
msgstr ""
"    memset(&my_addr, 0, sizeof(my_addr));\n"
"    my_addr.sun_family = AF_UNIX;\n"
"    strncpy(my_addr.sun_path, MY_SOCK_PATH,\n"
"            sizeof(my_addr.sun_path) - 1);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (bind(sfd, (struct sockaddr *) &my_addr,\n"
"             sizeof(my_addr)) == -1)\n"
"        handle_error(\"bind\");\n"
msgstr ""
"    if (bind(sfd, (struct sockaddr *) &my_addr,\n"
"             sizeof(my_addr)) == -1)\n"
"        handle_error(\"bind\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (listen(sfd, LISTEN_BACKLOG) == -1)\n"
"        handle_error(\"listen\");\n"
msgstr ""
"    if (listen(sfd, LISTEN_BACKLOG) == -1)\n"
"        handle_error(\"listen\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    /* Now we can accept incoming connections one\n"
"       at a time using accept(2). */\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    peer_addr_size = sizeof(peer_addr);\n"
"    cfd = accept(sfd, (struct sockaddr *) &peer_addr,\n"
"                 &peer_addr_size);\n"
"    if (cfd == -1)\n"
"        handle_error(\"accept\");\n"
msgstr ""
"    peer_addr_size = sizeof(peer_addr);\n"
"    cfd = accept(sfd, (struct sockaddr *) &peer_addr,\n"
"                 &peer_addr_size);\n"
"    if (cfd == -1)\n"
"        handle_error(\"accept\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    /* Code to deal with incoming connection(s)... */\n"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (close(sfd) == -1)\n"
"        handle_error(\"close\");\n"
msgstr ""
"    if (close(sfd) == -1)\n"
"        handle_error(\"close\");\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (unlink(MY_SOCK_PATH) == -1)\n"
"        handle_error(\"unlink\");\n"
"}\n"
msgstr ""
"    if (unlink(MY_SOCK_PATH) == -1)\n"
"        handle_error(\"unlink\");\n"
"}\n"

#. type: TH
#: mageia-cauldron
#, no-wrap
msgid "2023-10-31"
msgstr "31 Octubre 2023"

