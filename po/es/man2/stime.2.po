msgid "B<NOTE>: This function is deprecated; use B<clock_settime>(2)  instead."
msgstr "Estas funciones están obsoletas. Use B<clock_settime>(2)  en su lugar."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, fuzzy
#| msgid ""
#| "B<stime> sets the system's idea of the time and date.  Time, pointed to "
#| "by I<t>, is measured in seconds from 00:00:00 GMT January 1, 1970.  "
#| "B<stime()> may only be executed by the super user."
msgid ""
"B<stime>()  sets the system's idea of the time and date.  The time, pointed "
"to by I<t>, is measured in seconds since the Epoch, 1970-01-01 00:00:00 "
"+0000 (UTC).  B<stime>()  may be executed only by the superuser."
msgstr ""
"B<stime> pone la hora y fecha según la idea que el sistema tiene de ello. La "
"hora/fecha, a la que apunta I<t>, se mide en segundos transcurridos desde "
"\"La Época\", las 00:00:00 GMT del 1 de Enero de 1970.  B<stime()> sólo "
"puede ser llamado por el súper-usuario."

