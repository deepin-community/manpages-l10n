#: debian-bookworm
msgid "B<+>I<number>"
msgstr ""

#. type: Plain text
#: debian-bookworm
#, fuzzy
#| msgid "Display current line number."
msgid "Start displaying each file at line I<number>."
msgstr "Mostrar el número de línea actual."

#. type: Plain text
#: debian-bookworm
#, fuzzy
#| msgid "B<+/>I<string>"
msgid "B<+>/I<string>"
msgstr "B<+/>I<cadena>"

#. type: Plain text
