#, no-wrap
msgid "NAME"
msgstr "NOMBRE"

#. type: Plain text
#: fedora-41 fedora-rawhide opensuse-tumbleweed
msgid ""
"python - an interpreted, interactive, object-oriented programming language"
msgstr ""
"python - lenguaje de programación orientado a objetos interactivo e "
"interpretado"

#. type: SH
#: fedora-41 fedora-rawhide opensuse-tumbleweed
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

