"    if (sizeof(buf1) E<lt> strlen(\"Hello world!\"))\n"
"        errx(\"stpncpy: truncating character sequence\");\n"
"    p = stpncpy(buf1, \"Hello world!\", sizeof(buf1));\n"
"    len = p - buf1;\n"
"\\&\n"
"    printf(\"[len = %zu]: \", len);\n"
"    fwrite(buf1, 1, len, stdout);\n"
"    putchar(\\[aq]\\en\\[aq]);\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
