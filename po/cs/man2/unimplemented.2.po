#| msgid "Unimplemented system calls."
msgid "Unimplemented system calls.\n"
msgstr "afs_syscall, break, fattach, fdetach, ftime, getmsg, getpmsg, gtty, isastream, lock, madvise1, mpx, multiplexer, prof, pro- fil, putmsg, putpmsg, security, stty, tuxcall, ulimit, vserver - neimplementovaná systémová volání."

