#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<ip> [ I<OPTIONS> ] B<address> { I<COMMAND> | B<help> }"
msgstr "B<ip> [ I<OPTIONS> ] B<address> { I<COMMANDE> | B<help> }"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<ip address> { B<add> | B<change> | B<replace> } I<IFADDR>B< dev >I<IFNAME> "
"[ I<LIFETIME> ] [ I<CONFFLAG-LIST> ]"
msgstr ""
"B<ip address> { B<add> | B<change> | B<replace> } I<ADDR_INTERFACE>B< dev> "
"I<NOM_INTERFACE> [ I<DURÉE_VIE> ] [ I<LISTE_DRAPEAUX-CONFIG> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-rawhide
msgid "B<ip address delete> I<IFADDR>B< dev >I<IFNAME>B< [ >I<mngtmpaddr>B< ]>"
msgstr ""
"B<ip address delete> I<ADDR_INTERFACE>B< dev >I<NOM_INTERFACE>B< [> "
"I<mngtmpaddr>B< ]>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<ip address> { B<save> | B<flush> } [ B<dev> I<IFNAME> ] [ B<scope> I<SCOPE-"
"ID> ] [ B<metric> I<METRIC> ] [ B<to> I<PREFIX> ] [ I<FLAG-LIST> ] "
"[ B<label> I<PATTERN> ] [ I<up> ]"
msgstr ""
"B<ip address> { B<save> | B<flush> } [ B<dev> I<NOM_INTERFACE> ] [ B<scope> "
"I<ID_PORTÉE> ] [ B<metric> I<MÉTRIQUE> ] [ B<to> I<PRÉFIXE> ] [ I<LISTE-"
"DRAPEAUX> ] [ B<label> I<MOTIF> ] [ I<up> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"B<ip address> [ B<show> [ B<dev> I<IFNAME> ] [ B<scope> I<SCOPE-ID> ] "
"[ B<to> I<PREFIX> ] [ I<FLAG-LIST> ] [ B<label> I<PATTERN> ] [ B<master> "
"I<DEVICE> ] [ B<type> I<TYPE> ] [ B<vrf> I<NAME> ] [ B<up> ] [ B<nomaster> ] "
"B<proto> I<ADDRPROTO> ] ]"
msgstr ""
"B<ip address> [ B<show> [ B<dev> I<NOM_INTERFACE> ] [ B<scope> "
"I<ID_PORTÉE> ] [ B<to> I<PRÉFIXE> ] [ I<LISTE-DRAPEAUX> ] [ B<label> "
"I<MOTIF> ] [ B<master> I<PÉRIPH> ] [ B<type> I<TYPE> ] [ B<vrf> I<NOM> ] "
"[ B<up> ] [ B<nomaster> ] B<proto> I<PROTOCOLE_ADRESSE> ] ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<ip address> { B<showdump> | B<restore> }"
msgstr "B<ip address> { B<showdump> | B<restore> }"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"I<IFADDR> := I<PREFIX> | I<ADDR> B<peer> I<PREFIX> [ B<broadcast> I<ADDR> ] "
"[ B<anycast> I<ADDR> ] [ B<label> I<LABEL> ] [ B<scope> I<SCOPE-ID> ] "
"[ B<proto> I<ADDRPROTO> ]"
msgstr ""
"I<ADDR_INTERFACE> := I<PRÉFIXE> | I<ADDR> B<peer> I<PRÉFIXE> [ B<broadcast> "
"I<ADDR> ] [ B<anycast> I<ADDR> ] [ B<label> I<LABEL> ] [ B<scope> "
"I<ID_PORTÉE> ] [ B<proto> I<PROTOCOLE_ADRESSE> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<SCOPE-ID> := [ B<host> | B<link> | B<global> | I<NUMBER> ]"
msgstr "I<ID_PORTÉE> := [ B<host> | B<link> | B<global> | I<NOMBRE> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid "I<ADDRPROTO> := [ I<NAME> | I<NUMBER> ]"
msgstr "I<PROTOCOLE_ADRESSE> := [ I<NOM> | I<NOMBRE> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<FLAG-LIST> := [ I<FLAG-LIST> ] I<FLAG>"
msgstr "I<LISTE-DRAPEAUX> := [ I<LISTE-DRAPEAUX> ] I<DRAPEAU>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"I<FLAG> := [ [B<->]B<permanent> | [B<->]B<dynamic> | [B<->]B<secondary> | "
"[B<->]B<primary> | [B<->]B<tentative> | [B<->]B<deprecated> | [B<-"
">]B<dadfailed> | [B<->]B<temporary> | I<CONFFLAG-LIST> ]"
msgstr ""
"I<DRAPEAU> := [ [B<->]B<permanent> | [B<->]B<dynamic> | [B<->]B<secondary> | "
"[B<->]B<primary> | [B<->]B<tentative> | [B<->]B<deprecated> | [B<-"
">]B<dadfailed> | [B<->]B<temporary> | I<LISTE_CONFIG-DRAPEAUX> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<CONFFLAG-LIST> := [ I<CONFFLAG-LIST> ] I<CONFFLAG>"
msgstr ""
"I<LISTE_CONFIG-DRAPEAUX> := [ I<LISTE_CONFIG-DRAPEAUX> ] I<CONFIG-DRAPEAUX>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"I<CONFFLAG> := [ B<home> | B<mngtmpaddr> | B<nodad> | B<optimistic> | "
"B<noprefixroute> | B<autojoin> ]"
msgstr ""
"I<CONFIG-DRAPEAUX> := [ B<home> | B<mngtmpaddr> | B<nodad> | B<optimistic> | "
"B<noprefixroute> | B<autojoin> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<LIFETIME> := [ B<valid_lft>I< LFT> ] [ B<preferred_lft> I<LFT> ]"
msgstr ""
"I<DURÉE_VIE> := [ B<valid_lft>I< DURÉE_VIE> ] [ B<preferred_lft> "
"I<DURÉE_VIE> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "I<LFT> := [ B<forever> | I<SECONDS> ]"
msgstr "I<DURÉE_VIE> := [ B<forever> | I<SECONDES> ]"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: opensuse-tumbleweed
msgid ""
"I<TYPE> := [ B<bridge> | B<bridge_slave> | B<bond> | B<bond_slave> | B<can> "
"| B<dummy> | B<hsr> | B<ifb> | B<ipoib> | B<macvlan> | B<macvtap> | B<vcan> "
"| B<veth> | B<vlan> | B<vxlan> | B<ip6tnl> | B<ipip> | B<sit> | B<gre> | "
"B<gretap> | B<erspan> | B<ip6gre> | B<ip6gretap> | B<ip6erspan> | B<vti> | "
"B<vrf> | B<nlmon> | B<ipvlan> | B<lowpan> | B<geneve> | B<macsec> | "
"B<netkit> ]"
msgstr ""
"I<TYPE> := [ B<bridge> | B<bridge_slave> | B<bond> | B<bond_slave> | B<can> "
"| B<dummy> | B<hsr> | B<ifb> | B<ipoib> | B<macvlan> | B<macvtap> | B<vcan> "
"| B<veth> | B<vlan> | B<vxlan> | B<ip6tnl> | B<ipip> | B<sit> | B<gre> | "
"B<gretap> | B<erspan> | B<ip6gre> | B<ip6gretap> | B<ip6erspan> | B<vti> | "
"B<vrf> | B<nlmon> | B<ipvlan> | B<lowpan> | B<geneve> | B<macsec> | "
"B<netkit> ]"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The B<address> is a protocol (IPv4 or IPv6) address attached to a network "
"device. Each device must have at least one address to use the corresponding "
"protocol. It is possible to have several different addresses attached to one "
"device. These addresses are not discriminated, so that the term B<alias> is "
"not quite appropriate for them and we do not use it in this document."
msgstr ""
"B<address> est une adresse avec protocole (IPv4 ou IPv6) attachée à un "
"périphérique réseau. Chaque périphérique doit avoir au moins une adresse "
"pour utiliser le protocole correspondant. Il est possible d'avoir "
"différentes adresses attachées à un périphérique. Ces adresses ne sont pas "
"traitées différemment, alors le terme B<alias> n'est pas vraiment approprié "
"pour elles et il ne sera pas utilisé dans ce document."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The B<ip address> command displays addresses and their properties, adds new "
"addresses and deletes old ones."
msgstr ""
"La commande B<ip-address> affiche les adresses et leurs caractéristiques, "
"ajoute de nouvelles adresses et efface les anciennes."

#. type: SS
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "ip address add - add new protocol address."
msgstr "ip address add – Ajouter de nouvelles adresses avec protocole."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<dev>I< IFNAME >"
msgstr "B<dev>I< NOM_INTERFACE >"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "the name of the device to add the address to."
msgstr "le nom du périphérique auquel rajouter l'adresse."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<local>I< ADDRESS >B<(default)>"
msgstr "B<local>I< ADRESSE >B<(default)>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"the address of the interface. The format of the address depends on the "
"protocol. It is a dotted quad for IP and a sequence of hexadecimal halfwords "
"separated by colons for IPv6. The I<ADDRESS> may be followed by a slash and "
"a decimal number which encodes the network prefix length."
msgstr ""
"l'adresse de l'interface. Le format de l'adresse dépend du protocole. Il "
"s'agit d'une notation décimale avec points pour l'IP et d'une séquence de "
"demi-mots hexadécimaux séparés par des deux-points pour l'IPv6. L'I<ADRESSE> "
"doit être suivie d'une barre oblique et d'un nombre décimal qui encode la "
"longueur du préfixe de réseau."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<peer>I< ADDRESS>"
msgstr "B<peer>I< ADRESSE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"the address of the remote endpoint for pointopoint interfaces.  Again, the "
"I<ADDRESS> may be followed by a slash and a decimal number, encoding the "
"network prefix length. If a peer address is specified, the local address "
"cannot have a prefix length. The network prefix is associated with the peer "
"rather than with the local address."
msgstr ""
"l'adresse distante pour les interfaces « point à point ». De même, "
"l'I<ADRESSE> doit être suivie d'une barre oblique et d'un nombre décimal "
"pour encoder la longueur du préfixe de réseau. Si l'adresse d'un pair est "
"indiquée, l'adresse locale ne peut pas avoir de longueur de préfixe. Le "
"préfixe réseau est associé avec le pair plutôt qu'à l'adresse locale."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<broadcast>I< ADDRESS>"
msgstr "B<broadcast>I< ADRESSE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "the broadcast address on the interface."
msgstr "l'adresse de diffusion de l'interface."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"It is possible to use the special symbols B<'+'> and B<'-'> instead of the "
"broadcast address. In this case, the broadcast address is derived by setting/"
"resetting the host bits of the interface prefix."
msgstr ""
"Il est possible d'utiliser les symboles spéciaux B<+> et B<-> au lieu de "
"l'adresse de diffusion. Dans ce cas, l'adresse de diffusion est obtenue en "
"paramétrant les bits de l'hôte du préfixe de l'interface."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<label>I< LABEL>"
msgstr "B<label>I< LABEL>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Each address may be tagged with a label string.  The maximum allowed total "
"length of label is 15 characters."
msgstr ""
"Chaque adresse doit être étiquetée avec une chaîne I<LABEL>. La taille "
"maximale autorisée pour I<LABEL> est de quinze caractères."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<scope>I< SCOPE_VALUE>"
msgstr "B<scope>I< VALEUR_PORTÉE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: opensuse-tumbleweed
msgid ""
"the scope of the area where this address is valid.  The available scopes are "
"listed in B</usr/share/iproute2/rt_scopes> or B</etc/iproute2/rt_scopes> "
"(has precedence if exists).  Predefined scope values are:"
msgstr ""
"l’étendue de la zone où l'adresse est valable. Les portées disponibles sont "
"listées dans I</usr/share/iproute2/rt_scopes> ou I</etc/iproute2/rt_scopes> "
"(qui a la priorité s'il existe). Les valeurs de portées prédéfinies sont :"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<global> - the address is globally valid."
msgstr "B<global> – l'adresse est valable globalement."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<site> - (IPv6 only, deprecated) the address is site local, i.e. it is "
"valid inside this site."
msgstr ""
"B<site> – (seulement IPv6, obsolète) l'adresse est le site local, c'est-à-"
"dire qu’elle est valable dans ce site."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<link> - the address is link local, i.e. it is valid only on this device."
msgstr ""
"B<link> – l'adresse est un lien local, c'est-à-dire seulement valable sur ce "
"périphérique."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<host> - the address is valid only inside this host."
msgstr "B<host> – cette adresse n'est valable que dans cet hôte."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<metric>I< NUMBER>"
msgstr "B<metric>I< NOMBRE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "priority of prefix route associated with address."
msgstr "priorité de la route avec ce préfixe associée à l'adresse."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<valid_lft>I< LFT>"
msgstr "B<valid_lft>I< DURÉE_VIE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"the valid lifetime of this address; see section 5.5.4 of RFC 4862. When it "
"expires, the address is removed by the kernel.  Defaults to B<forever>."
msgstr ""
"la durée de vie de cette adresse ; voir section 5.5.4 de la RFC 4862. Après "
"expiration, l'adresse est supprimée par le noyau. La valeur par défaut est "
"B<forever>."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<preferred_lft>I< LFT>"
msgstr "B<preferred_lft>I< DURÉE_VIE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"the preferred lifetime of this address; see section 5.5.4 of RFC 4862. When "
"it expires, the address is no longer used for new outgoing connections. "
"Defaults to B<forever>."
msgstr ""
"la durée de vie préférée de cette adresse ; voir section 5.5.4 de la "
"RFC 4862. Après expiration, l'adresse n'est plus utilisée pour les nouvelles "
"connexions sortantes. La valeur par défaut est B<forever>."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<home>"
msgstr "B<home>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) designates this address the \"home address\" as defined in RFC "
"6275."
msgstr ""
"[IPv6 uniquement) désigner cette adresse comme « home address » comme "
"définie définie dans la RFC 6275."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<mngtmpaddr>"
msgstr "B<mngtmpaddr>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) make the kernel manage temporary addresses created from this one "
"as template on behalf of Privacy Extensions (RFC3041). For this to become "
"active, the B<use_tempaddr> sysctl setting has to be set to a value greater "
"than zero.  The given address needs to have a prefix length of 64. This flag "
"allows to use privacy extensions in a manually configured network, just like "
"if stateless auto-configuration was active."
msgstr ""
"(IPv6 uniquement) faire que le noyau gère ces adresses temporaires créées à "
"partir de celle-là comme modèle relativement aux extensions de vie privée "
"« Privacy Extensions » (RFC 3041). Pour devenir actives, le réglage sysctl "
"B<use_tempaddr> doit être défini à une valeur supérieure à zéro. L'adresse "
"donnée doit avoir une longueur de préfixe de B<64>. Ce drapeau permet "
"d'utiliser les extensions de vie privée dans un réseau configuré "
"manuellement, comme si l'auto-configuration sans état était active."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<nodad>"
msgstr "B<nodad>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) do not perform Duplicate Address Detection (RFC 4862) when "
"adding this address."
msgstr ""
"(IPv6 uniquement) ne pas exécuter de détection d'adresse dupliquée "
"(Duplicate Address Detection – RFC 4862) lors de l'ajout de cette adresse."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<optimistic>"
msgstr "B<optimistic>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) When performing Duplicate Address Detection, use the RFC 4429 "
"optimistic variant."
msgstr ""
"(IPv6 uniquement) utiliser la variante « optimistic » de la RFC 4429 lors de "
"la détection d'adresse dupliquée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<noprefixroute>"
msgstr "B<noprefixroute>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Do not automatically create a route for the network prefix of the added "
"address, and don't search for one to delete when removing the address. "
"Changing an address to add this flag will remove the automatically added "
"prefix route, changing it to remove this flag will create the prefix route "
"automatically."
msgstr ""
"Ne pas créer automatiquement une route pour le préfixe de réseau de "
"l'adresse ajoutée, et ne pas en chercher une à supprimer lors de la "
"suppression de l'adresse. Changer une adresse pour lui ajouter ce drapeau "
"supprimera la route du préfixe automatiquement ajoutée ; changer la route "
"pour enlever ce drapeau créera automatiquement la route du préfixe."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<autojoin>"
msgstr "B<autojoin>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Joining multicast groups on Ethernet level via B<ip maddr> command does not "
"work if connected to an Ethernet switch that does IGMP snooping since the "
"switch would not replicate multicast packets on ports that did not have IGMP "
"reports for the multicast addresses."
msgstr ""
"Joindre des groupes de multidiffusion au niveau d'Ethernet avec la commande "
"B<ip maddr> ne fonctionne pas s'ils sont connectés à un commutateur Ethernet "
"qui réalise du « IGMP snooping » puisque le commutateur ne répliquerait pas "
"les paquets de multidiffusion sur les ports qui n'ont pas de rapports IGMP "
"pour les adresses de multidiffusion."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Linux VXLAN interfaces created via B<ip link add vxlan> have the B<group> "
"option that enables them to do the required join."
msgstr ""
"Les interfaces VXLAN de Linux créées avec B<ip link add vxlan> ont l'option "
"B<group> qui les active pour réaliser la jonction requise."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Using the B<autojoin> flag when adding a multicast address enables similar "
"functionality for Openvswitch VXLAN interfaces as well as other tunneling "
"mechanisms that need to receive multicast traffic."
msgstr ""
"Utiliser le drapeau B<autojoin> lors de l'ajout d'une adresse de "
"multidiffusion active la fonctionnalité similaire des interfaces VXLAN "
"d'Openvswitch ainsi que les mécanismes de tunnel qui nécessitent de recevoir "
"un trafic de multidiffusion."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid "B<proto>I< ADDRPROTO>"
msgstr "B<proto>I< PROTOCOLE_ADRESSE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"the protocol identifier of this route.  I<ADDRPROTO> may be a number or a "
"string from the file B</etc/iproute2/rt_addrprotos>.  If the protocol ID is "
"not given,"
msgstr ""
"l'identifiant du protocole de cette route. I<PROTOCOLE_ADRESSE> doit être un "
"nombre ou une chaîne du fichier I</etc/iproute2/rt_addrprotos>. Si "
"l'identifiant du protocole n'est pas donné,"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"B<ip assumes protocol 0. Several protocol> values have a fixed "
"interpretation. Namely:"
msgstr ""
"B<ip présume le protocole 0>. Plusieurs valeurs de protocole ont une "
"interprétation fixe. À savoir :"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
#, no-wrap
msgid ""
"B<kernel_lo>\n"
"- The ::1 address that kernel installs on a loopback netdevice has this\n"
"  protocol value\n"
msgstr ""
"B<kernel_lo>\n"
"– L'adresse ::1 que le noyau installe sur le périphérique réseau de bouclage\n"
"  a cette valeur de protocole\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"B<kernel_ra> - IPv6 addresses installed in response to router advertisement "
"messages"
msgstr ""
"B<kernel_ra> – adresses IPv6 installées en réponse aux messages d'annonce du "
"routeur"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid "B<kernel_ll> - Link-local addresses have this protocol value"
msgstr "B<kernel_ll> – les adresses link-local ont cette valeur de protocole"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-tumbleweed
msgid ""
"The rest of the values are not reserved and the administrator is free to "
"assign (or not to assign) protocol tags."
msgstr ""
"Le reste des valeurs n'est pas réservé et l'administrateur est libre "
"d'assigner (ou de ne pas assigner) des étiquettes de protocole."

#. type: SS
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "ip address delete - delete protocol address"
msgstr "ip address delete – Effacer des adresses avec protocole"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-rawhide
msgid "B<Arguments:> coincide with the arguments of B<ip address add.>"
msgstr "B<Arguments:> coïncide avec les arguments de B<ip adress add>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-rawhide
msgid "The device name is a required argument."
msgstr "Le nom de périphérique est un argument requis."

#. type: SS
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "ip address show - look at protocol addresses"
msgstr "ip address show – Examiner les adresses avec protocole"

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<dev>I< IFNAME >B<(default)>"
msgstr "B<dev>I< NOM_INTERFACE >B<(default)>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "name of device."
msgstr "nom du périphérique."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<scope>I< SCOPE_VAL>"
msgstr "B<scope>I< VALEUR_PORTÉE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list addresses with this scope."
msgstr "ne lister que les adresses avec cette portée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<to>I< PREFIX>"
msgstr "B<to>I< PRÉFIXE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list addresses matching this prefix."
msgstr "ne lister que les adresses correspondant à ce préfixe."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<label>I< PATTERN>"
msgstr "B<label>I< MOTIF>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"only list addresses with labels matching the I<PATTERN>.  I<PATTERN> is a "
"usual shell style pattern."
msgstr ""
"ne lister que les adresses dont le label correspond au I<MOTIF>. I<MOTIF> "
"est un motif de type interpréteur de commande habituel."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<master>I< DEVICE>"
msgstr "B<master>I< PÉRIPHÉRIQUE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list interfaces enslaved to this master device."
msgstr "ne lister que les interfaces asservies ce périphérique maître."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<vrf>I< NAME >"
msgstr "B<vrf>I< NOM >"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list interfaces enslaved to this vrf."
msgstr "ne lister que les interfaces asservies à ce vrf."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<type>I< TYPE>"
msgstr "B<type>I< TYPE>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list interfaces of the given type."
msgstr "ne lister que les interfaces du I<TYPE> donné."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Note that the type name is not checked against the list of supported types - "
"instead it is sent as-is to the kernel. Later it is used to filter the "
"returned interface list by comparing it with the relevant attribute in case "
"the kernel didn't filter already. Therefore any string is accepted, but may "
"lead to empty output."
msgstr ""
"Notez que le nom du type n'est pas vérifié dans la liste des types pris en "
"charge – à la place, il est envoyé « tel quel » au noyau. Il est ensuite "
"utilisé pour filtrer la liste d'interfaces renvoyée en la comparant à "
"l'attribut pertinent dans le cas où le noyau n'a pas déjà procédé à un "
"filtrage. Par conséquent, n'importe quelle chaîne est acceptée, mais cela "
"peut conduire à un résultat vide."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<up>"
msgstr "B<up>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list running interfaces."
msgstr "ne lister que les interfaces en fonctionnement."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<nomaster>"
msgstr "B<nomaster>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "only list interfaces with no master."
msgstr "ne lister que les interfaces sans maître."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<dynamic> and B<permanent>"
msgstr "B<dynamic> et B<permanent>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) only list addresses installed due to stateless address "
"configuration or only list permanent (not dynamic)  addresses. These two "
"flags are inverses of each other, so B<-dynamic> is equal to B<permanent> "
"and B<-permanent> is equal to B<dynamic>."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses installées dues à une "
"configuration sans état des adresses ou ne lister que les adresses "
"permanentes (pas dynamiques). Ces deux drapeaux sont l'inverse l'un de "
"l'autre, ainsi B<-dynamic> est égal à B<permanent> et B<-permanent> est égal "
"à B<dynamic>."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<tentative>"
msgstr "B<tentative>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) only list addresses which have not yet passed duplicate address "
"detection."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses qui n'ont pas déjà passé la "
"détection d'adresse dupliquée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-tentative>"
msgstr "B<-tentative>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) only list addresses which are not in the process of duplicate "
"address detection currently."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses qui ne sont pas actuellement "
"dans le processus de détection d'adresse dupliquée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<deprecated>"
msgstr "B<deprecated>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "(IPv6 only) only list deprecated addresses."
msgstr "(IPv6 uniquement) ne lister que les adresses obsolètes."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-deprecated>"
msgstr "B<-deprecated>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "(IPv6 only) only list addresses not being deprecated."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses qui ne sont pas obsolètes."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<dadfailed>"
msgstr "B<dadfailed>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) only list addresses which have failed duplicate address "
"detection."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses qui ont échoué à la détection "
"d'adresse dupliquée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-dadfailed>"
msgstr "B<-dadfailed>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"(IPv6 only) only list addresses which have not failed duplicate address "
"detection."
msgstr ""
"(IPv6 uniquement) ne lister que les adresses qui n'ont pas échoué à la "
"détection d'adresse dupliquée."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<temporary> or B<secondary>"
msgstr "B<temporary> ou B<secondary>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"List temporary IPv6 or secondary IPv4 addresses only. The Linux kernel "
"shares a single bit for those, so they are actually aliases for each other "
"although the meaning differs depending on address family."
msgstr ""
"Ne lister que les adresses IPv6 temporaires ou IPv4 secondaires. Le noyau "
"Linux partage un seul bit pour elles, il y a donc un alias pour chacune même "
"si la signification diffère en fonction de la famille d'adresses."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-temporary> or B<-secondary>"
msgstr "B<-temporary> ou B<-secondary>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "These flags are aliases for B<primary>."
msgstr "Ces drapeaux sont des alias de B<primary>."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<primary>"
msgstr "B<primary>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"List only primary addresses, in IPv6 exclude temporary ones. This flag is "
"the inverse of B<temporary> and B<secondary>."
msgstr ""
"Ne lister que les adresses primaires et exclure les adresses IPv6 "
"temporaires. Ce drapeau est l'inverse de B<temporary> et B<secondary>."

#. type: TP
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "B<-primary>"
msgstr "B<-primary>"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "This is an alias for B<temporary> or B<secondary>."
msgstr "C'est un alias pour B<temporary> ou B<secondary>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-rawhide
msgid ""
"Only show addresses with a given protocol, or those for which the kernel "
"response did not include protocol. See the corresponding argument to B<ip "
"address add> for details about address protocols."
msgstr ""
"N'afficher que les adresses avec un protocole donné, ou celles pour "
"lesquelles la réponse du noyau n'inclut pas de protocole. Voir les arguments "
"correspondants de B<ip address add> pour davantage de détails sur les "
"protocoles d'adresse."

#. type: SS
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "ip address flush - flush protocol addresses"
msgstr "ip address flush – Vidage d'adresses avec protocole"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "This command flushes the protocol addresses selected by some criteria."
msgstr ""
"Cette commande vide les adresses avec protocole désignées par un critère."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"This command has the same arguments as B<show> except that B<type> and "
"B<master> selectors are not supported.  Another difference is that it does "
"not run when no arguments are given."
msgstr ""
"Cette commande prend les même arguments que B<show>, sauf que les sélecteurs "
"B<type> et B<master> ne sont pas pris en charge. Une autre différence est "
"que cette commande ne fonctionne pas si aucun argument n'est donné."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<Warning:> This command and other B<flush> commands are unforgiving. They "
"will cruelly purge all the addresses."
msgstr ""
"B<ATTENTION> : cette commande et les autres commandes B<flush> sont "
"impitoyables. Elles purgeront sans remords toutes les adresses."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"With the B<-statistics> option, the command becomes verbose. It prints out "
"the number of deleted addresses and the number of rounds made to flush the "
"address list.  If this option is given twice, B<ip address flush> also dumps "
"all the deleted addresses in the format described in the previous subsection."
msgstr ""
"Avec l'option B<-statistics>, la commande devient prolixe. Elle affiche le "
"nombre d'adresses effacées et le nombre de tours effectués pour vider la "
"liste d'adresses. Si cette option est donnée deux fois, B<ip address flush> "
"décharge aussi toutes les adresses effacées dont le format est décrit dans "
"la précédente sous-section."

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "EXAMPLES"
msgstr "EXEMPLES"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "ip address show"
msgstr "ip address show"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Shows IPv4 and IPv6 addresses assigned to all network interfaces. The 'show' "
"subcommand can be omitted."
msgstr ""
"Afficher les adresses IPv4 et IPv6 assignées à toutes les interfaces réseau. "
"La sous-commande « show » peut être omise."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "ip address show up"
msgstr "ip address show up"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"Same as above except that only addresses assigned to active network "
"interfaces are shown."
msgstr ""
"Pareil que ci-dessus, sauf que seules les adresses assignées à des "
"interfaces réseau actives sont affichées."

