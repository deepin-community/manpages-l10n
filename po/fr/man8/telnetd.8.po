#: debian-bookworm debian-unstable
#, no-wrap
msgid "FILES"
msgstr "FICHIERS"

#. type: Plain text
#: debian-bookworm debian-unstable
msgid "E<.Pa /etc/services>"
msgstr "E<.Pa /etc/services>"

#. type: Plain text
#: debian-bookworm debian-unstable
msgid "E<.Xr telnet 1>, E<.Xr login 1>, E<.Xr bftp 1> (if supported)"
msgstr "E<.Xr telnet 1>, E<.Xr login 1>, E<.Xr bftp 1> (si pris en charge)"

