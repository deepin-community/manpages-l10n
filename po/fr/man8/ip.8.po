"B<ioam> | B<l2tp> | B<link> | B<macsec> | B<maddress> | B<monitor> | "
"B<mptcp> | B<mroute> | B<mrule> | B<neighbor> | B<neighbour> | B<netconf> | "
"B<netns> | B<nexthop> | B<ntable> | B<ntbl> | B<route> | B<rule> | B<sr> | "
"B<tap> | B<tcpmetrics> | B<token> | B<tunnel> | B<tuntap> | B<vrf> | "
"B<xfrm> }"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"I<OPTIONS> := { B<-V>[I<ersion>] | B<-h>[I<uman-readable>] | B<-"
"s>[I<tatistics>] | B<-d>[I<etails>] | B<-r>[I<esolve>] | B<-iec> | B<-"
"f>[I<amily>] { B<inet> | B<inet6> | B<link> } | B<-4> | B<-6> | B<-B> | "
"B<-0> | B<-l>[I<oops>] { B<maximum-addr-flush-attempts> } | B<-o>[I<neline>] "
"| B<-rc>[I<vbuf>] [B<size>] | B<-t>[I<imestamp>] | B<-ts>[I<hort>] | B<-"
"n>[I<etns>] name | B<-N>[I<umeric>] | B<-a>[I<ll>] | B<-c>[I<olor>] | B<-"
"br>[I<ief>] | B<-j>[son] | B<-p>[retty] }"
msgstr ""
"I<OPTIONS> := { B<-V>[I<ersion>] | B<-h>[I<uman-readable>] | B<-"
"s>[I<tatistics>] | B<-d>[I<etails>] | B<-r>[I<esolve>] | B<-iec> | B<-"
"f>[I<amily>] { B<inet> | B<inet6> | B<link> } | B<-4> | B<-6> | B<-B> | "
"B<-0> | B<-l>[I<oops>] { B<maximum-addr-flush-attempts> } | B<-o>[I<neline>] "
"| B<-rc>[I<vbuf>] [B<size>] | B<-t>[I<imestamp>] | B<-ts>[I<hort>] | B<-"
"n>[I<etns>] nom | B<-N>[I<umeric>] | B<-a>[I<ll>] | B<-c>[I<olor>] | B<-"
"br>[I<ief>] | B<-j>[son] | B<-p>[retty] }"

