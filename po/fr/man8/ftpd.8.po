msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: archlinux
msgid "File Transfer Protocol daemon."
msgstr ""
"Démon du « File Transfer Protocol » (Protocole de Transfert de Fichier ou "
"FTP)."

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-4>, B<--ipv4>"
msgstr "B<-4>, B<--ipv4>"

#. type: Plain text
#: archlinux
msgid "restrict daemon to IPv4"
msgstr "restreindre le démon à IPv4"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-6>, B<--ipv6>"
msgstr "B<-6>, B<--ipv6>"

#. type: Plain text
#: archlinux
msgid "restrict daemon to IPv6"
msgstr "restreindre le démon à IPv6"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-a>, B<--auth>=I<\\,AUTH\\/>"
msgstr "B<-a>, B<--auth>=I<\\,AUTH\\/>"

#. type: Plain text
#: archlinux
msgid "use AUTH for authentication"
msgstr "utiliser AUTH pour l’authentification"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-A>, B<--anonymous-only>"
msgstr "B<-A>, B<--anonymous-only>"

#. type: Plain text
#: archlinux
msgid "server configured for anonymous service only"
msgstr "serveur configuré pour un service anonyme seulement"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-d>, B<--debug>"
msgstr "B<-d>, B<--debug>"

#. type: Plain text
#: archlinux
msgid "debug mode"
msgstr "mode de débogage"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-D>, B<--daemon>"
msgstr "B<-D>, B<--daemon>"

#. type: Plain text
#: archlinux
msgid "start the ftpd standalone"
msgstr "démarrer B<ftpd> en mode autonome"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-l>, B<--logging>"
msgstr "B<-l>, B<--logging>"

#. type: Plain text
#: archlinux
msgid "increase verbosity of syslog messages"
msgstr "augmenter la prolixité des messages de syslog"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<--non-rfc2577>"
msgstr "B<--non-rfc2577>"

#. type: Plain text
#: archlinux
msgid "neglect RFC 2577 by giving info on missing users"
msgstr ""
"passer outre la RFC 2577 en donnant des informations sur les utilisateurs "
"rejetés"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-p>, B<--pidfile>[=I<\\,PIDFILE\\/>]"
msgstr "B<-p>, B<--pidfile>[=I<\\,FICHIER_PID\\/>]"

#. type: Plain text
#: archlinux
msgid "change default location of pidfile"
msgstr "changer l’emplacement par défaut du fichier PID"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-q>, B<--no-version>"
msgstr "B<-q>, B<--no-version>"

#. type: Plain text
#: archlinux
msgid "do not display version in banner"
msgstr "ne pas afficher la version dans la bannière"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-t>, B<--timeout>=I<\\,TIMEOUT\\/>"
msgstr "B<-t>, B<--timeout>=I<\\,DÉLAI\\/>"

#. type: Plain text
#: archlinux
msgid "set default idle timeout"
msgstr "définir le délai d’inactivité par défaut"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-T>, B<--max-timeout>=I<\\,MAX_TIMEOUT\\/>"
msgstr "B<-T>, B<--max-timeout>=I<\\,DÉLAI_MAX\\/>"

#. type: Plain text
#: archlinux
msgid "set maximum value of timeout allowed"
msgstr "définir la valeur maximale du délai autorisé"

#. type: TP
#: archlinux
#, no-wrap
msgid "B<-u>, B<--umask>=I<\\,VAL\\/>"
msgstr "B<-u>, B<--umask>=I<\\,VALEUR\\/>"

#. type: Plain text
#: archlinux
msgid "set default umask"
msgstr "définir le masque de création de fichier (umask) par défaut"

#. type: Plain text
#: archlinux
msgid "AUTH can be one of the following:"
msgstr "AUTH peut prendre les valeurs suivantes :"

