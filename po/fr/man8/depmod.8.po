msgid ""
"B<depmod> [B<-e>] [B<-E\\ >I<Module\\&.symvers>] [B<-F\\ >I<System\\&.map>] "
"[B<-n>] [B<-v>] [B<-P\\ >I<prefix>] [B<-w>] [I<version>] [I<filename>...]"
msgstr ""
"B<depmod> [B<-e>] [B<-E\\ >I<Module\\&.symvers>] [B<-F\\ >I<System\\&.map>] "
