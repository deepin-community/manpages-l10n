msgid "\\\t32\\\t-\\ E2fsck canceled by user request"
msgstr "\\\t32\\\t-\\ e2fsck annulé par l'utilisateur"

#. type: Plain text
#: opensuse-leap-16-0 opensuse-tumbleweed
msgid "\\\t128\\\t-\\ Shared library error"
