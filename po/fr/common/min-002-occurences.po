"309\n"
"sh2# B<ls /proc/27123/root/etc | wc -l>  # /etc in other NS\n"
"0                                     # The empty tmpfs dir\n"
"sh2# B<ls /dev | wc -l>                  # In initial NS\n"
"205\n"
"sh2# B<ls /proc/27123/root/dev | wc -l>  # /dev in other NS\n"
"11                                    # Actually bind\n"
