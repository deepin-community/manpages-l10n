"           I</proc/>pidI</status>)\n"
"text       (4) text (code)\n"
"lib        (5) library (unused since Linux 2.6; always 0)\n"
"data       (6) data + stack\n"
"dt         (7) dirty pages (unused since Linux 2.6; always 0)\n"
