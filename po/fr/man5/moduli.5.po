msgstr "Non testé."

#. type: It
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "0x01"
msgstr "0x01"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Composite number \\(en not prime."
msgstr "Nombre composite \\(en pas premier."

#. type: It
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "0x02"
msgstr "0x02"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Sieve of Eratosthenes."
msgstr "Crible d’Ératosthène."

#. type: It
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "0x04"
msgstr "0x04"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "Probabilistic Miller-Rabin primality tests."
msgstr "Tests de primalité probabilistes de Miller-Rabin."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The E<.Xr ssh-keygen 1> moduli candidate generation uses the Sieve of "
"Eratosthenes (flag 0x02).  Subsequent E<.Xr ssh-keygen 1> primality tests "
"are Miller-Rabin tests (flag 0x04)."
msgstr ""
"La génération du modulus candidat à l’aide de E<.Xr ssh-keygen 1> utilise le "
"Crible d'Ératosthène (type de test 0x02). Les tests de primalité suivants de "
"E<.Xr ssh-keygen 1> sont des tests de Miller-Rabin (type de test 0x04)."

#. type: It
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "trials"
msgstr "essais"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
