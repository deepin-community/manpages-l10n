#. type: Plain text
#: debian-bookworm
msgid "B<TERMINAL_COLORS_DEBUG>=all"
msgstr "B<TERMINAL_COLORS_DEBUG>=all"

#. type: Plain text
#: debian-bookworm
msgid "enables debug output."
msgstr "Activer la sortie de débogage."

