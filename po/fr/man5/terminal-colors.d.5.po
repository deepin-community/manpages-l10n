#. type: SS
#: debian-bookworm
#, no-wrap
msgid "Escape sequences"
msgstr "Séquences d’échappement"

#. type: Plain text
#: debian-bookworm
msgid ""
"To specify control or blank characters in the color sequences, C-style \\(rs-"
"escaped notation can be used:"
msgstr ""
"Pour indiquer les caractères de contrôle ou les blancs dans les séquences de "
"couleur, la notation d’échappement \\(rs-échappement de style C peut être "
"utilisée :"

#. type: tbl table
#: debian-bookworm
#, no-wrap
msgid "B<\\(rsa>"
msgstr "B<\\(rsa>"

#. type: tbl table
#: debian-bookworm
#, no-wrap
msgid "Bell (ASCII 7)"
msgstr "sonnerie (ASCII 7)"

#. type: tbl table
#: debian-bookworm
#, no-wrap
msgid "B<\\(rsb>"
msgstr "B<\\(rsb>"

#. type: tbl table
#: debian-bookworm
#, no-wrap
msgid "Backspace (ASCII 8)"
msgstr "retour arrière (ASCII 8)"

#. type: tbl table
#: debian-bookworm
#, no-wrap
msgid "B<\\(rse>"
msgstr "B<\\(rse>"

#. type: tbl table
