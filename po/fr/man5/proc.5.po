msgid ""
"major:minor: the value of I<st_dev> for files on this filesystem (see "
"B<stat>(2))."
msgstr ""
"majeur:mineur : valeur de I<st_dev> pour les fichiers sur ce système de "
"fichiers (consulter B<stat>(2))."

#. type: TP
#: debian-bookworm
#, no-wrap
msgid "(4)"
msgstr "(4)"

#. type: Plain text
