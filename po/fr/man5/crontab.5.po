msgstr "/bin/sh: LANG=zh_TW\\&.UTF-8: command not found\n"

#. type: SH
#: debian-unstable
#, no-wrap
msgid "DIAGNOSTICS"
msgstr "DIAGNOSTICS"

#. type: Plain text
#: debian-unstable
msgid ""
"cron requires that each entry in a crontab end in a newline character\\&. If "
"the last entry in a crontab is missing a newline (i\\&.e\\&. terminated by "
"EOF), cron will consider the crontab (at least partially) broken\\&. A "
"warning will be written to syslog\\&."
msgstr ""
"Chaque entrée d'une I<crontab> doit être terminée par un caractère nouvelle "
"ligne\\&. Si la dernière entrée d'une crontab ne se termine pas par un "
"retour à la ligne (autrement dit se termine par EOF), B<cron> la considérera "
"(au moins partiellement) corrompue\\&. Un avertissement sera écrit dans le "
"journal système (« syslog »)\\&."

