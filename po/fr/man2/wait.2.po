"            } else if (WIFCONTINUED(wstatus)) {\n"
"                printf(\"relancé\\en\");\n"
"            }\n"
"        } while (!WIFEXITED(wstatus) && !WIFSIGNALED(wstatus));\n"
"        exit(EXIT_SUCCESS);\n"
"    }\n"
"}\n"

