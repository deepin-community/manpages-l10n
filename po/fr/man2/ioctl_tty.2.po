#.  .BI "TIOCGSERIAL	struct serial_struct *" argp
#.  Get serial info.
#.  .TP
#.  .BI "TIOCSSERIAL	const struct serial_struct *" argp
#.  Set serial info.
#. type: Plain text
#. #-#-#-#-#  mageia-cauldron: ioctl_tty.2.pot (PACKAGE VERSION)  #-#-#-#-#
