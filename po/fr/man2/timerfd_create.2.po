"            err(EXIT_FAILURE, \"clock_gettime\");\n"
"    }\n"
"\\&\n"
"    if (clock_gettime(CLOCK_MONOTONIC, &curr) == -1)\n"
"        err(EXIT_FAILURE, \"clock_gettime\");\n"
"\\&\n"
"    secs = curr.tv_sec - start.tv_sec;\n"
"    nsecs = curr.tv_nsec - start.tv_nsec;\n"
"    if (nsecs E<lt> 0) {\n"
"        secs--;\n"
"        nsecs += 1000000000;\n"
"    }\n"
"    printf(\"%d.%03d: \", secs, (nsecs + 500000) / 1000000);\n"
