msgid ""
"B<inotify_init>()  first appeared in Linux 2.6.13; library support was added "
"in glibc 2.4.  B<inotify_init1>()  was added in Linux 2.6.27; library "
"support was added in glibc 2.9."
msgstr ""
"B<inotify_init>() est apparu dans Linux 2.6.13 ; la gestion de la "
"bibliothèque a été ajoutée dans la glibc 2.4. B<inotify_init1>() a été "
"ajouté dans Linux 2.6.27 ; la gestion de la bibliothèque a été ajoutée dans "
"la glibc 2.9."

