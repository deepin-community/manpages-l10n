#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "s390_runtime_instr - enable/disable s390 CPU run-time instrumentation"
msgstr ""
"s390_runtime_instr - Activer ou désactiver l’instrumentation de l'activité "
"du processeur s390"

