#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"The watch descriptor I<wd> is not valid; or I<fd> is not an inotify file "
"descriptor."
msgstr ""
"Le descripteur de surveillance I<wd> est invalide, ou I<fd> n'est pas un "
"descripteur inotify."

