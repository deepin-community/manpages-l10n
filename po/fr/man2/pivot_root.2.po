msgstr ""
"static int              /* Fonction de démarrage pour l’enfant cloné */\n"
"child(void *arg)\n"
"{\n"
"    char        path[PATH_MAX];\n"
"    char        **args = arg;\n"
"    char        *new_root = args[0];\n"
