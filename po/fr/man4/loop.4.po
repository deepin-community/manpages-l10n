"    fichsauv = open(argv[1], O_RDWR);\n"
"    if (fichsauv == -1)\n"
"        errExit(\"open: fichsauv\");\n"
"\\&\n"
"    if (ioctl(ddfloop, LOOP_SET_FD, fichsauv) == -1)\n"
"        errExit(\"ioctl-LOOP_SET_FD\");\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

