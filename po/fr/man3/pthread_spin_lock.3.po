msgid ""
"pthread_spin_lock, pthread_spin_trylock, pthread_spin_unlock - lock and "
"unlock a spin lock"
msgstr ""
"pthread_spin_lock, pthread_spin_trylock, pthread_spin_unlock — Verrouiller "
"et déverrouiller un verrou tournant"

