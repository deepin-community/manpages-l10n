#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<ffs>():"
msgstr "B<ffs>() :"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"    Since glibc 2.12:\n"
"        _XOPEN_SOURCE E<gt>= 700\n"
"            || ! (_POSIX_C_SOURCE E<gt>= 200809L)\n"
"            || /* glibc E<gt>= 2.19: */ _DEFAULT_SOURCE\n"
"            || /* glibc E<lt>= 2.19: */ _BSD_SOURCE || _SVID_SOURCE\n"
"    Before glibc 2.12:\n"
"        none\n"
msgstr ""
"    Depuis la glibc 2.12 :\n"
"        _XOPEN_SOURCE E<gt>= 700\n"
"            || ! (_POSIX_C_SOURCE E<gt>= 200809L)\n"
"            || /* glibc E<gt>= 2.19 : */ _DEFAULT_SOURCE\n"
"            || /* glibc E<lt>= 2.19 : */ _BSD_SOURCE || _SVID_SOURCE\n"
"    Avant la glibc 2.12 :\n"
"        none\n"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<ffsl>(), B<ffsll>():"
msgstr "B<ffsl>(), B<ffsll>() :"

#.  glibc commit 68fe16dd327c895c08b9ee443b234c49c13b36e9
#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid ""
"    Since glibc 2.27:\n"
"        _DEFAULT_SOURCE\n"
"    Before glibc 2.27:\n"
"        _GNU_SOURCE\n"
msgstr ""
"    Depuis la glibc 2.27 :\n"
"        _DEFAULT_SOURCE\n"
"    Avant la glibc 2.27 :\n"
"        _GNU_SOURCE\n"

#. type: SH
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
