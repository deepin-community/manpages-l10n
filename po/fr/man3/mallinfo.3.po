"    printf(\"============== Before allocating blocks ==============\\[rs]n\");\n"
"    display_mallinfo2();\n"
"\\&\n"
"    for (size_t j = 0; j E<lt> numBlocks; j++) {\n"
"        if (numBlocks E<gt>= MAX_ALLOCS) {\n"
