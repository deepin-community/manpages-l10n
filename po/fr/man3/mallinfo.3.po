"\\&\n"
"    printf(\"\\[rs]n============== After freeing blocks ==============\\[rs]n\");\n"
"    display_mallinfo2();\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
