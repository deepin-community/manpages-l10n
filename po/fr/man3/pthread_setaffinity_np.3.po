"        if (CPU_ISSET(j, &cpuset))\n"
"            printf(\"    CPU %zu\\en\", j);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"    exit(EXIT_SUCCESS);\n"
"}\n"

