#| "        /* data is just an integer, instead of a\n"
#| "           pointer to something */\n"
#| "        e.data = (void *) i;\n"
#| "        ep = hsearch(e, ENTER);\n"
#| "        /* there should be no failures */\n"
#| "        if (ep == NULL) {\n"
#| "            fprintf(stderr, \"entry failed\\en\");\n"
#| "            exit(EXIT_FAILURE);\n"
#| "        }\n"
#| "    }\n"
#| "\\&\n"
#| "    for (size_t i = 22; i E<lt> 26; i++) {\n"
