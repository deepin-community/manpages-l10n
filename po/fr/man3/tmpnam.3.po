#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid ""
"B<Note:> avoid using these functions; use B<mkstemp>(3)  or B<tmpfile>(3)  "
"instead."
msgstr ""
"B<Note :> évitez d'utiliser ces fonctions. Utilisez B<mkstemp>(3) ou "
