"    while ((nread = getline(&line, &len, stream)) != -1) {\n"
"        printf(\"Réception d'une ligne de longueur %zd:\\en\", nread);\n"
"        fwrite(line, nread, 1, stdout);\n"
"    }\n"
"\\&\n"
"    free(line);\n"
"    fclose(stream);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

