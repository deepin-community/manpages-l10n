#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "/* Link with \"-lrt\" */\n"
msgstr "/* Effectuez l'édition des liens avec l'option \"-lrt\" */\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>pthread.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
