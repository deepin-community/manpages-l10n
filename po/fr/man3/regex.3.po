#, fuzzy, no-wrap
#| msgid ""
#| "#include E<lt>stdint.hE<gt>\n"
#| "#include E<lt>stdio.hE<gt>\n"
#| "#include E<lt>stdlib.hE<gt>\n"
#| "#include E<lt>regex.hE<gt>\n"
#| "\\&\n"
#| "#define ARRAY_SIZE(arr) (sizeof((arr)) / sizeof((arr)[0]))\n"
#| "\\&\n"
#| "static const char *const str =\n"
