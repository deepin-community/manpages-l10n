#, no-wrap
msgid ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    clockid_t clockid;\n"
"    struct timespec ts;\n"
msgstr ""
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    clockid_t clockid;\n"
"    struct timespec ts;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (argc != 2) {\n"
"        fprintf(stderr, \"%s E<lt>process-IDE<gt>\\en\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
