msgid ""
"B<double complex cacos(double complex >I<z>B<);>\n"
"B<float complex cacosf(float complex >I<z>B<);>\n"
"B<long double complex cacosl(long double complex >I<z>B<);>\n"
msgstr ""
"B<double complex cacos(double complex >I<z>B<);>\n"
"B<float complex cacosf(float complex >I<z>B<);>\n"
"B<long double complex cacosl(long double complex >I<z>B<);>\n"

