"    const struct mi *mi2 = m2;\n"
"\\&\n"
"    return strcmp(mi1-E<gt>name, mi2-E<gt>name);\n"
"}\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    qsort(months, ARRAY_SIZE(months), sizeof(months[0]), compmi);\n"
"    for (size_t i = 1; i E<lt> argc; i++) {\n"
"        struct mi key;\n"
"        struct mi *res;\n"
"\\&\n"
"        key.name = argv[i];\n"
