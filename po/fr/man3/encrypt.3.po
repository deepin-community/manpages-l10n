#. type: Plain text
#: archlinux debian-unstable fedora-41 fedora-rawhide opensuse-leap-16-0
#: opensuse-tumbleweed
#, fuzzy, no-wrap
#| msgid ""
#| "#define _XOPEN_SOURCE\n"
#| "#include E<lt>crypt.hE<gt>\n"
#| "#include E<lt>stdio.hE<gt>\n"
#| "#include E<lt>stdlib.hE<gt>\n"
#| "#include E<lt>unistd.hE<gt>\n"
#| "\\&\n"
#| "int\n"
#| "main(void)\n"
#| "{\n"
#| "    char key[64];\n"
#| "    char orig[9] = \"eggplant\";\n"
#| "    char buf[64];\n"
#| "    char txt[9];\n"
#| "\\&\n"
#| "    for (size_t i = 0; i E<lt> 64; i++) {\n"
#| "        key[i] = rand() & 1;\n"
#| "    }\n"
#| "\\&\n"
#| "    for (size_t i = 0; i E<lt> 8; i++) {\n"
#| "        for (size_t j = 0; j E<lt> 8; j++) {\n"
#| "            buf[i * 8 + j] = orig[i] E<gt>E<gt> j & 1;\n"
#| "        }\n"
#| "        setkey(key);\n"
#| "    }\n"
#| "    printf(\"Before encrypting: %s\\en\", orig);\n"
#| "\\&\n"
#| "    encrypt(buf, 0);\n"
#| "    for (size_t i = 0; i E<lt> 8; i++) {\n"
#| "        for (size_t j = 0, txt[i] = \\[aq]\\e0\\[aq]; j E<lt> 8; j++) {\n"
#| "            txt[i] |= buf[i * 8 + j] E<lt>E<lt> j;\n"
#| "        }\n"
#| "        txt[8] = \\[aq]\\e0\\[aq];\n"
#| "    }\n"
#| "    printf(\"After encrypting:  %s\\en\", txt);\n"
#| "\\&\n"
#| "    encrypt(buf, 1);\n"
#| "    for (size_t i = 0; i E<lt> 8; i++) {\n"
#| "        for (size_t j = 0, txt[i] = \\[aq]\\e0\\[aq]; j E<lt> 8; j++) {\n"
#| "            txt[i] |= buf[i * 8 + j] E<lt>E<lt> j;\n"
#| "        }\n"
#| "        txt[8] = \\[aq]\\e0\\[aq];\n"
#| "    }\n"
#| "    printf(\"After decrypting:  %s\\en\", txt);\n"
#| "    exit(EXIT_SUCCESS);\n"
#| "}\n"
msgid ""
"#define _XOPEN_SOURCE\n"
"#include E<lt>crypt.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    char key[64];\n"
"    char orig[9] = \"eggplant\";\n"
"    char buf[64];\n"
"    char txt[9];\n"
"\\&\n"
"    for (size_t i = 0; i E<lt> 64; i++) {\n"
"        key[i] = rand() & 1;\n"
"    }\n"
"\\&\n"
"    for (size_t i = 0; i E<lt> 8; i++) {\n"
"        for (size_t j = 0; j E<lt> 8; j++) {\n"
"            buf[i * 8 + j] = orig[i] E<gt>E<gt> j & 1;\n"
"        }\n"
"        setkey(key);\n"
"    }\n"
"    printf(\"Before encrypting: %s\\[rs]n\", orig);\n"
"\\&\n"
"    encrypt(buf, 0);\n"
"    for (size_t i = 0; i E<lt> 8; i++) {\n"
"        for (size_t j = 0, txt[i] = \\[aq]\\[rs]0\\[aq]; j E<lt> 8; j++) {\n"
"            txt[i] |= buf[i * 8 + j] E<lt>E<lt> j;\n"
"        }\n"
"        txt[8] = \\[aq]\\[rs]0\\[aq];\n"
"    }\n"
"    printf(\"After encrypting:  %s\\[rs]n\", txt);\n"
"\\&\n"
"    encrypt(buf, 1);\n"
"    for (size_t i = 0; i E<lt> 8; i++) {\n"
"        for (size_t j = 0, txt[i] = \\[aq]\\[rs]0\\[aq]; j E<lt> 8; j++) {\n"
"            txt[i] |= buf[i * 8 + j] E<lt>E<lt> j;\n"
"        }\n"
"        txt[8] = \\[aq]\\[rs]0\\[aq];\n"
"    }\n"
"    printf(\"After decrypting:  %s\\[rs]n\", txt);\n"
