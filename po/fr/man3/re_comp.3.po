msgid ""
"B<[[deprecated]] char *re_comp(const char *>I<regex>B<);>\n"
"B<[[deprecated]] int re_exec(const char *>I<string>B<);>\n"
msgstr ""
"B<[[obsolète]] char *re_comp(const char *>I<regex>B<);>\n"
"B<[[obsolète]] int re_exec(const char *>I<chaîne>B<);>\n"

