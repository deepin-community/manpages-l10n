#| "}\n"
msgid ""
"#include E<lt>byteswap.hE<gt>\n"
"#include E<lt>inttypes.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    uint64_t x;\n"
"\\&\n"
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Usage: %s E<lt>numE<gt>\\[rs]n\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    x = strtoull(argv[1], NULL, 0);\n"
"    printf(\"%#\" PRIx64 \" ==E<gt> %#\" PRIx64 \"\\[rs]n\", x, bswap_64(x));\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"#include E<lt>byteswap.hE<gt>\n"
"#include E<lt>inttypes.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    uint64_t x;\n"
"\\&\n"
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Utilisation : %s E<lt>numE<gt>\\en\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    x = strtoull(argv[1], NULL, 0);\n"
"    printf(\"%#\" PRIx64 \" ==E<gt> %#\" PRIx64 \"\\en\", x, bswap_64(x));\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"

