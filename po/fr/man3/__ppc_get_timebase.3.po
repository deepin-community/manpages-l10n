"de la glibc 2.16 et B<__ppc_get_timebase_freq>() est disponible depuis la "
"glibc 2.17."

#. type: Plain text
#: debian-bookworm
msgid "Both functions are nonstandard GNU extensions."
msgstr "Ces fonctions sont des extensions GNU non standard."

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"#include E<lt>inttypes.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/platform/ppc.hE<gt>\n"
msgstr ""
"#include E<lt>inttypes.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/platform/ppc.hE<gt>\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"/* Maximum value of the Time Base Register: 2\\[ha]60 - 1.\n"
"   Source: POWER ISA.  */\n"
"#define MAX_TB 0xFFFFFFFFFFFFFFF\n"
msgstr ""
"/* Valeur maximale du Registre de Base Temporelle : 2\\[ha]60 - 1.\n"
"   Source : POWER ISA.  */\n"
"#define MAX_TB 0xFFFFFFFFFFFFFFF\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"int\n"
"main(void)\n"
"{\n"
"    uint64_t tb1, tb2, diff;\n"
"    uint64_t freq;\n"
msgstr ""
"int\n"
"main(void)\n"
"{\n"
"    uint64_t tb1, tb2, diff;\n"
"    uint64_t freq;\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    freq = __ppc_get_timebase_freq();\n"
"    printf(\"Time Base frequency = %\"PRIu64\" Hz\\en\", freq);\n"
msgstr ""
"    freq = __ppc_get_timebase_freq();\n"
"    printf(\"Fréquence de la Base Temporelle = %\"PRIu64\" Hz\\en\", freq);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    tb1 = __ppc_get_timebase();\n"
msgstr "    tb1 = __ppc_get_timebase();\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    // Do some stuff...\n"
msgstr "    // Faire quelque chose ...\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid "    tb2 = __ppc_get_timebase();\n"
msgstr "    tb2 = __ppc_get_timebase();\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    if (tb2 E<gt> tb1) {\n"
"        diff = tb2 - tb1;\n"
"    } else {\n"
"        /* Treat Time Base Register overflow.  */\n"
"        diff = (MAX_TB - tb2) + tb1;\n"
"    }\n"
msgstr ""
"    if (tb2 E<gt> tb1) {\n"
"        diff = tb2 - tb1;\n"
"    } else {\n"
"        /* Traiter le dépassement du Registre de Base Temporelle.  */\n"
"        diff = (MAX_TB - tb2) + tb1;\n"
"    }\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    printf(\"Elapsed time  = %1.2f usecs\\en\",\n"
"           (double) diff * 1000000 / freq);\n"
msgstr ""
"    printf(\"Temps écoulé = %1.2f usecs\\en\",\n"
"            (double) diff * 1000000 / freq);\n"

#. type: Plain text
#: debian-bookworm
#, no-wrap
msgid ""
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""
"    exit(EXIT_SUCCESS);\n"
"}\n"

