msgid ""
"SVr4, BSD, POSIX.1-2001.  Obsolete in POSIX.1-2008, noting that it cannot be "
"used portably in a localized application."
msgstr ""
"SVr4, BSD, POSIX.1-2001. Obsolète dans POSIX.1-2008, en notant qu'elle ne "
"peut pas être utilisée de façon portable pour une application localisée."

