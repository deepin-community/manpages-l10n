#| "    result = malloc(size);\n"
#| "\\&\n"
#| "    /* Save underlying hooks */\n"
#| "    old_malloc_hook = __malloc_hook;\n"
#| "\\&\n"
#| "    /* printf() might call malloc(), so protect it too */\n"
#| "    printf(\"malloc(%zu) called from %p returns %p\\en\",\n"
#| "            size, caller, result);\n"
#| "\\&\n"
