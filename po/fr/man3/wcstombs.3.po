msgid ""
"B<size_t wcstombs(char >I<dest>B<[restrict .>I<n>B<], const wchar_t *restrict >I<src>B<,>\n"
"B<                size_t >I<n>B<);>\n"
msgstr ""
"B<size_t wcstombs(char >I<dest>B<[restrict .>I<n>B<], const wchar_t *restrict >I<src>B<,>\n"
"B<                size_t >I<n>B<);>\n"

