#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "These functions calculate the complex cosine of I<z>."
msgstr "Ces fonctions calculent la valeur complexe du cosinus de I<z>."

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "The complex cosine function is defined as:"
msgstr "La fonction cosinus complexe est définie par :"

#. type: Plain text
#: archlinux debian-bookworm debian-unstable fedora-41 fedora-rawhide
#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
#, no-wrap
msgid "ccos(z) = (exp(i * z) + exp(-i * z)) / 2\n"
msgstr "ccos(z) = (exp(i * z) + exp(-i * z)) / 2\n"

