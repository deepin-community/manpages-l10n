#: mageia-cauldron opensuse-leap-16-0 opensuse-tumbleweed
msgid "B<LC_CTYPE>\t\tLocale for filename output."
msgstr "B<LC_CTYPE>\t\tParamètres régionaux pour la sortie du nom de fichier."

#. type: Plain text
