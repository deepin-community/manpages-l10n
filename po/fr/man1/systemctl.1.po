msgid ""
"LISTEN           UNIT                        ACTIVATES\n"
"/dev/initctl     systemd-initctl\\&.socket      systemd-initctl\\&.service\n"
"\\&...\n"
"[::]:22          sshd\\&.socket                 sshd\\&.service\n"
